#!/usr/bin/env python3
"""A16EEN Nest: hide and restore live Niri windows without closing them."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
STATE_DIR = STATE_HOME / "a16een"
STASH_FILE = STATE_DIR / "app-stash.json"
STASH_WORKSPACE = "app-stash"


class StashError(RuntimeError):
    pass


def run_niri(args: list[str]) -> str:
    try:
        result = subprocess.run(
            ["niri", "msg", *args],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise StashError(f"Could not contact Niri: {error}") from error
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "Niri command failed").strip()
        raise StashError(detail)
    return result.stdout.strip()


def niri_json(request: str) -> Any:
    raw = run_niri(["--json", request])
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as error:
        raise StashError(f"Niri returned invalid JSON for {request}.") from error

    if isinstance(value, dict) and "Err" in value:
        raise StashError(str(value["Err"]))
    if isinstance(value, dict) and "Ok" in value:
        value = value["Ok"]
    if isinstance(value, dict):
        for key in (request.replace("-", "_").title().replace("_", ""), request.title(), request.capitalize()):
            if key in value:
                value = value[key]
                break
    return value


def read_stash() -> list[dict[str, Any]]:
    try:
        data = json.loads(STASH_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return []
    except (OSError, UnicodeError, json.JSONDecodeError):
        return []
    if not isinstance(data, dict) or not isinstance(data.get("windows"), list):
        return []
    result: list[dict[str, Any]] = []
    for item in data["windows"]:
        if not isinstance(item, dict) or item.get("window_id") is None:
            continue
        try:
            window_id = str(int(item["window_id"]))
        except (TypeError, ValueError):
            continue
        result.append({
            "window_id": window_id,
            "app_id": str(item.get("app_id") or ""),
            "title": str(item.get("title") or "Application"),
            "restore_workspace": str(item.get("restore_workspace") or "home"),
            "stashed_at": int(item.get("stashed_at") or 0),
        })
    return result


def write_stash(entries: list[dict[str, Any]]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE_DIR, 0o700)
    handle = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=STATE_DIR,
        prefix=".app-stash-",
        suffix=".tmp",
        delete=False,
    )
    temporary = Path(handle.name)
    try:
        os.chmod(temporary, 0o600)
        with handle:
            json.dump({"version": 1, "windows": entries}, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
        os.replace(temporary, STASH_FILE)
        os.chmod(STASH_FILE, 0o600)
    finally:
        temporary.unlink(missing_ok=True)


def windows() -> list[dict[str, Any]]:
    value = niri_json("windows")
    if not isinstance(value, list):
        raise StashError("Niri did not return a window list.")
    return [item for item in value if isinstance(item, dict) and item.get("id") is not None]


def workspaces() -> list[dict[str, Any]]:
    value = niri_json("workspaces")
    if not isinstance(value, list):
        raise StashError("Niri did not return a workspace list.")
    return [item for item in value if isinstance(item, dict)]


def workspace_for_window(window: dict[str, Any], workspace_list: list[dict[str, Any]]) -> dict[str, Any] | None:
    workspace_id = window.get("workspace_id")
    return next((item for item in workspace_list if str(item.get("id")) == str(workspace_id)), None)


def workspace_reference(workspace: dict[str, Any] | None) -> str:
    if not workspace:
        return "home"
    name = str(workspace.get("name") or "").strip()
    if name and name != STASH_WORKSPACE:
        return name
    idx = workspace.get("idx")
    if idx is not None:
        try:
            number = int(idx)
            if number > 0:
                return str(number)
        except (TypeError, ValueError):
            pass
    return "home"


def move_window(window_id: str, workspace: str, focus: bool = False) -> None:
    # Niri's action takes the workspace reference as a positional argument.
    run_niri([
        "action", "move-window-to-workspace",
        "--window-id", str(window_id),
        "--focus", "true" if focus else "false",
        workspace,
    ])


def hide_window() -> int:
    live = windows()
    focused = next((item for item in live if item.get("is_focused") is True), None)
    if not focused:
        raise StashError("There is no focused application window to hide.")

    window_id = str(int(focused["id"]))
    workspace_list = workspaces()
    current_workspace = workspace_for_window(focused, workspace_list)
    if current_workspace and str(current_workspace.get("name") or "") == STASH_WORKSPACE:
        print("That window is already in Nest.")
        return 0

    entries = read_stash()
    entries = [item for item in entries if item["window_id"] != window_id]
    entry = {
        "window_id": window_id,
        "app_id": str(focused.get("app_id") or ""),
        "title": str(focused.get("title") or focused.get("app_id") or "Application"),
        "restore_workspace": workspace_reference(current_workspace),
        "stashed_at": int(__import__("time").time() * 1000),
    }
    entries.insert(0, entry)
    # Save first so a shell restart during the move does not lose the window.
    write_stash(entries)
    try:
        move_window(window_id, STASH_WORKSPACE, focus=False)
    except StashError:
        write_stash([item for item in entries if item["window_id"] != window_id])
        raise
    print(f"Stashed {entry['title']}.")
    return 0


def list_stash() -> int:
    entries = read_stash()
    live_windows = windows()
    workspace_list = workspaces()
    live_by_id = {str(item["id"]): item for item in live_windows}
    workspace_by_id = {str(item.get("id")): item for item in workspace_list}

    visible: list[dict[str, Any]] = []
    for entry in entries:
        window = live_by_id.get(entry["window_id"])
        if not window:
            continue
        actual_workspace = workspace_by_id.get(str(window.get("workspace_id")))
        if actual_workspace and str(actual_workspace.get("name") or "") != STASH_WORKSPACE:
            # The window was restored or moved manually; it is no longer stashed.
            continue
        updated = dict(entry)
        updated["app_id"] = str(window.get("app_id") or entry["app_id"])
        updated["title"] = str(window.get("title") or entry["title"])
        visible.append(updated)

    if visible != entries:
        write_stash(visible)
    print(json.dumps(visible, ensure_ascii=False, separators=(",", ":")))
    return 0


def restore_window(window_id: str) -> int:
    try:
        normalized_id = str(int(window_id))
    except ValueError as error:
        raise StashError("Invalid stashed-window ID.") from error

    entries = read_stash()
    entry = next((item for item in entries if item["window_id"] == normalized_id), None)
    if not entry:
        raise StashError("That window is no longer in Nest.")

    live_ids = {str(item["id"]) for item in windows()}
    if normalized_id not in live_ids:
        write_stash([item for item in entries if item["window_id"] != normalized_id])
        raise StashError("That application window has already closed.")

    destination = entry["restore_workspace"] or "home"
    move_window(normalized_id, destination, focus=False)
    run_niri(["action", "focus-workspace", destination])
    run_niri(["action", "focus-window", "--id", normalized_id])
    write_stash([item for item in entries if item["window_id"] != normalized_id])
    print(f"Restored {entry['title']}.")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print("Usage: a16een-app-stash hide | list | restore WINDOW_ID")
        return 0
    try:
        if argv[0] == "hide" and len(argv) == 1:
            return hide_window()
        if argv[0] == "list" and len(argv) == 1:
            return list_stash()
        if argv[0] == "restore" and len(argv) == 2:
            return restore_window(argv[1])
        print("Usage: a16een-app-stash hide | list | restore WINDOW_ID", file=sys.stderr)
        return 2
    except StashError as error:
        print(f"A16EEN Nest: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
