#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${A16EEN_CONFIG_DIR:-$HOME/.config/a16een}"
QUICKSHELL_DIR="${A16EEN_QUICKSHELL_DIR:-$CONFIG_DIR/quickshell/a16een}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
LOG_DIR="$STATE_DIR/logs"
LOG_FILE="$LOG_DIR/shell.log"
ICON_THEME_STATE="$STATE_DIR/icon-theme"

mkdir -p "$LOG_DIR"

# Keep shell restarts/reloads silent; A16EEN renders its own UI feedback.
export QS_NO_RELOAD_POPUP=1

# Quickshell reads QS_ICON_THEME at process startup. Re-read the
# persisted theme before every launch so a theme change made while the
# supervisor is already running is picked up by the next shell.
load_icon_theme() {
    unset QS_ICON_THEME

    if [[ ! -s "$ICON_THEME_STATE" ]]; then
        return 0
    fi

    local selected
    selected="$(head -n 1 "$ICON_THEME_STATE" | tr -d "\r")"

    case "$selected" in
        Papirus|Papirus-Dark|breeze|elementary|Tela-circle|Tela-circle-blue|Tela-circle-dracula|TokyoNight-SE)
            if [[ -f "$HOME/.local/share/icons/$selected/index.theme" ]] ||
               [[ -f "$HOME/.icons/$selected/index.theme" ]] ||
               [[ -f "/usr/local/share/icons/$selected/index.theme" ]] ||
               [[ -f "/usr/share/icons/$selected/index.theme" ]]; then
                QS_ICON_THEME="$selected"
                export QS_ICON_THEME
            else
                rm -f "$ICON_THEME_STATE"
            fi
            ;;
        system|"")
            # System Default leaves QS_ICON_THEME unset so Quickshell follows
            # the normal Qt platform icon theme.
            rm -f "$ICON_THEME_STATE"
            ;;
        *)
            rm -f "$ICON_THEME_STATE"
            ;;
    esac
}

if ! command -v qs >/dev/null 2>&1; then
    printf '%s\n' "A16EEN shell cannot start: 'qs' was not found." >&2
    exit 1
fi

if [[ ! -d "$QUICKSHELL_DIR" ]]; then
    printf '%s\n' "A16EEN shell cannot start: missing Quickshell config: $QUICKSHELL_DIR" >&2
    exit 1
fi

# Quickshell is intentionally supervised separately from Niri. A shell crash
# should not take the compositor or the user's windows down with it.
attempt=0
backoff=1

while true; do
    load_icon_theme

    # Recreate user-defined named workspaces from A16EEN's persistent registry.
    # This uses Niri IPC and does not rewrite or reload the compositor config.
    if command -v a16een-workspaces >/dev/null 2>&1; then
        a16een-workspaces apply >/dev/null 2>>"$LOG_FILE" || true
    fi

    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '[%s] starting Quickshell (attempt %d)\n' "$timestamp" "$((attempt + 1))" >>"$LOG_FILE"

    set +e
    qs -c "$QUICKSHELL_DIR" >>"$LOG_FILE" 2>&1
    status=$?
    set -e

    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '[%s] Quickshell exited with status %d\n' "$timestamp" "$status" >>"$LOG_FILE"

    # A clean exit is treated as intentional. Do not spin.
    if [[ $status -eq 0 ]]; then
        exit 0
    fi

    # a16een restart-shell and the installer deliberately send SIGTERM to
    # this child. Bash reports that as 128 + 15 = 143. Restart immediately
    # without consuming the crash retry budget, otherwise a handful of normal
    # reloads can permanently stop the shell (and therefore its wallpaper).
    if [[ $status -eq 143 ]]; then
        printf '[%s] Quickshell received the intentional restart signal; relaunching.\n' \
            "$timestamp" >>"$LOG_FILE"
        attempt=0
        backoff=1
        sleep 0.2
        continue
    fi

    attempt=$((attempt + 1))

    # Protect the machine from a broken QML/config revision turning into a
    # tight restart loop. Five retries are enough to recover transient faults;
    # after that the compositor remains usable without the shell.
    if (( attempt >= 5 )); then
        printf '[%s] giving up after %d failed starts; Niri remains usable.\n' \
            "$timestamp" "$attempt" >>"$LOG_FILE"
        exit "$status"
    fi

    sleep "$backoff"
    if (( backoff < 8 )); then
        backoff=$((backoff * 2))
    fi
done
