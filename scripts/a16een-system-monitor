#!/usr/bin/env python3
"""One-shot A16EEN resource snapshot, launched only while its panel is open."""
from __future__ import annotations
import json
import shutil
import sys
import time
from pathlib import Path

def parse_cpu_line(line: str) -> tuple[int, int]:
    fields = line.split()
    if not fields or fields[0] != "cpu" or len(fields) < 5:
        raise ValueError("Invalid aggregate CPU counters")
    values = [int(value) for value in fields[1:]]
    return sum(values), values[3] + (values[4] if len(values) > 4 else 0)

def cpu_percent(before: tuple[int, int], after: tuple[int, int]) -> float:
    total_delta = after[0] - before[0]
    idle_delta = after[1] - before[1]
    if total_delta <= 0:
        return 0.0
    busy_delta = max(0, total_delta - max(0, idle_delta))
    return max(0.0, min(100.0, 100.0 * busy_delta / total_delta))

def parse_meminfo(text: str) -> tuple[int, int]:
    values: dict[str, int] = {}
    for line in text.splitlines():
        key, separator, value = line.partition(":")
        if not separator:
            continue
        parts = value.split()
        if not parts:
            continue
        try:
            values[key] = int(parts[0]) * (1024 if len(parts) > 1 and parts[1].lower() == "kb" else 1)
        except ValueError:
            continue
    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable")
    if available is None:
        available = sum(values.get(key, 0) for key in ("MemFree", "Buffers", "Cached", "SReclaimable"))
    if total <= 0:
        raise ValueError("Could not read total memory from /proc/meminfo")
    return max(0, min(total, total - available)), total

def read_cpu_counters(path: Path = Path("/proc/stat")) -> tuple[int, int]:
    with path.open("r", encoding="ascii") as handle:
        for line in handle:
            if line.startswith("cpu "):
                return parse_cpu_line(line)
    raise ValueError("Could not read aggregate CPU counters from /proc/stat")

def snapshot(sample_seconds: float = 0.18) -> dict[str, int | float]:
    before = read_cpu_counters()
    time.sleep(max(0.05, min(float(sample_seconds), 0.5)))
    after = read_cpu_counters()
    ram_used, ram_total = parse_meminfo(Path("/proc/meminfo").read_text(encoding="ascii"))
    disk = shutil.disk_usage(Path.home())
    return {
        "cpu_percent": round(cpu_percent(before, after), 1),
        "ram_used_bytes": ram_used,
        "ram_total_bytes": ram_total,
        "ram_percent": round(100 * ram_used / ram_total, 1),
        "storage_used_bytes": int(disk.used),
        "storage_total_bytes": int(disk.total),
        "storage_percent": round(100 * disk.used / disk.total, 1) if disk.total else 0.0,
    }

def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("help", "-h", "--help"):
        print("Usage: a16een-system-monitor snapshot")
        return 0
    if argv != ["snapshot"]:
        print("Usage: a16een-system-monitor snapshot", file=sys.stderr)
        return 2
    try:
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    except (OSError, ValueError, ZeroDivisionError) as error:
        print(f"A16EEN System Monitor: {error}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
