#!/bin/bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/a16een"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
SCREENSHOT_STATE="$STATE_DIR/screenshot.conf"
QS_CONFIG="$CONFIG_DIR/quickshell/a16een"
TEMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/a16een-screenshots"

mkdir -p "$STATE_DIR" "$TEMP_DIR"

ACTIVE_CHILD_PID=""
ACTIVE_TEMP_PATH=""
PICK_RESULT_PATH=""

cancel_active_capture() {
    trap - INT TERM HUP
    if [[ -n "${ACTIVE_CHILD_PID:-}" ]] && kill -0 "$ACTIVE_CHILD_PID" 2>/dev/null; then
        kill -TERM "$ACTIVE_CHILD_PID" 2>/dev/null || true
        wait "$ACTIVE_CHILD_PID" 2>/dev/null || true
    fi
    rm -f "${ACTIVE_TEMP_PATH:-}" "${PICK_RESULT_PATH:-}" "${snapshot:-}" 2>/dev/null || true
    exit 130
}
trap cancel_active_capture INT TERM HUP

wait_for_file() {
    local path="$1"
    local attempt
    for ((attempt = 0; attempt < 80; attempt++)); do
        [[ -s "$path" ]] && return 0
        sleep 0.05
    done
    return 1
}

if [[ ! -f "$SCREENSHOT_STATE" ]]; then
    cat > "$SCREENSHOT_STATE" <<EOF
save=true
save_dir=$HOME/Pictures/Screenshots
clipboard=true
pointer=true
delay=0
EOF
fi

get_setting() {
    local key="$1"
    awk -F= -v key="$key" '$1 == key {value=$0; sub(/^[^=]*=/, "", value); print value; exit}' "$SCREENSHOT_STATE"
}

if ! grep -q '^save=' "$SCREENSHOT_STATE"; then
    tmp="$(mktemp "$STATE_DIR/screenshot.conf.XXXXXX")"
    {
        printf '%s\n' 'save=true'
        cat "$SCREENSHOT_STATE"
    } > "$tmp"
    mv "$tmp" "$SCREENSHOT_STATE"
fi

expand_path() {
    local value="$1"
    case "$value" in
        "~") printf '%s\n' "$HOME" ;;
        "~/"*) printf '%s/%s\n' "$HOME" "${value#~/}" ;;
        "") printf '%s\n' "$HOME/Pictures/Screenshots" ;;
        *) printf '%s\n' "$value" ;;
    esac
}

write_setting() {
    local key="$1"
    local value="$2"
    local tmp
    tmp="$(mktemp "$STATE_DIR/screenshot.conf.XXXXXX")"
    awk -F= -v key="$key" -v value="$value" '
        BEGIN { updated=0 }
        $1 == key { print key "=" value; updated=1; next }
        { print }
        END { if (!updated) print key "=" value }
    ' "$SCREENSHOT_STATE" > "$tmp"
    mv "$tmp" "$SCREENSHOT_STATE"
}

notify_preview() {
    local path="$1"
    qs -c "$QS_CONFIG" ipc call screenshot preview "$path" >/dev/null 2>&1 || true
}

finalize_capture() {
    local source="$1"
    local output="$source"
    local save_dir

    if [[ "$(get_setting save)" == "true" ]]; then
        save_dir="$(expand_path "$(get_setting save_dir)")"
        mkdir -p "$save_dir"
        output="$save_dir/A16EEN $(date '+%Y-%m-%d %H-%M-%S-%N').png"
        mv -f "$source" "$output"
    else
        output="$TEMP_DIR/last.png"
        cp -f "$source" "$output"
        rm -f "$source"
    fi

    if [[ "$(get_setting clipboard)" == "true" ]]; then
        wl-copy --type image/png < "$output"
    else
        wl-copy --clear >/dev/null 2>&1 || true
    fi

    notify_preview "$output"
    printf '%s\n' "$output"
}

case "${1:-}" in
    settings)
        case "${2:-}" in
            get)
                cat "$SCREENSHOT_STATE"
                ;;
            set)
                [[ $# -ge 4 ]] || exit 2
                key="$3"
                value="$4"
                case "$key" in
                    save|clipboard|pointer)
                        [[ "$value" == "true" || "$value" == "false" ]] || exit 2
                        ;;
                    save_dir)
                        value="$(expand_path "$value")"
                        ;;
                    delay)
                        [[ "$value" =~ ^(0|3|5)$ ]] || exit 2
                        ;;
                    *)
                        exit 2
                        ;;
                esac
                write_setting "$key" "$value"
                ;;
            *)
                exit 2
                ;;
        esac
        ;;
    prepare-area)
        tmp="$TEMP_DIR/area-$(date +%s%N).png"
        ACTIVE_TEMP_PATH="$tmp"
        if [[ "$(get_setting pointer)" == "true" ]]; then
            grim -c "$tmp"
        else
            grim "$tmp"
        fi
        wait_for_file "$tmp" || {
            echo "A16EEN: could not prepare the area-selection image." >&2
            exit 1
        }
        printf '%s\n' "$tmp"
        ACTIVE_TEMP_PATH=""
        ;;
    prepare-window)
        # Use a clean background without a frozen cursor; the live pointer is
        # needed by Niri's native click-to-select window picker.
        tmp="$TEMP_DIR/window-background-$(date +%s%N).png"
        ACTIVE_TEMP_PATH="$tmp"
        grim "$tmp"
        wait_for_file "$tmp" || {
            echo "A16EEN: could not prepare the window-selection background." >&2
            exit 1
        }
        printf '%s\n' "$tmp"
        ACTIVE_TEMP_PATH=""
        ;;
    screen)
        delay="$(get_setting delay)"
        [[ "$delay" =~ ^[0-9]+$ ]] || delay=0
        (( delay > 0 )) && sleep "$delay"
        tmp="$TEMP_DIR/capture-$(date +%s%N).png"
        ACTIVE_TEMP_PATH="$tmp"
        niri msg action screenshot-screen --path "$tmp" --show-pointer="$(get_setting pointer)"
        if ! wait_for_file "$tmp"; then
            echo "A16EEN: screenshot file was not created." >&2
            exit 1
        fi
        finalize_capture "$tmp"
        ACTIVE_TEMP_PATH=""
        ;;
    window)
        [[ $# -le 2 ]] || exit 2
        snapshot="${2:-}"
        pick_result="$(mktemp "$TEMP_DIR/window-pick.XXXXXX")"
        PICK_RESULT_PATH="$pick_result"
        niri msg --json pick-window > "$pick_result" &
        ACTIVE_CHILD_PID=$!
        if wait "$ACTIVE_CHILD_PID"; then
            ACTIVE_CHILD_PID=""
        else
            ACTIVE_CHILD_PID=""
            rm -f "$pick_result"
            PICK_RESULT_PATH=""
            [[ -z "$snapshot" ]] || rm -f "$snapshot"
            echo "A16EEN: window selection was cancelled." >&2
            exit 130
        fi
        selected="$(jq -r '.id // empty' "$pick_result" 2>/dev/null || true)"
        rm -f "$pick_result"
        PICK_RESULT_PATH=""
        if [[ -z "$selected" ]]; then
            [[ -z "$snapshot" ]] || rm -f "$snapshot"
            echo "A16EEN: window selection was cancelled." >&2
            exit 130
        fi
        delay="$(get_setting delay)"
        [[ "$delay" =~ ^[0-9]+$ ]] || delay=0
        (( delay > 0 )) && sleep "$delay"
        tmp="$TEMP_DIR/capture-$(date +%s%N).png"
        ACTIVE_TEMP_PATH="$tmp"
        niri msg action screenshot-window --id "$selected" --path "$tmp" --show-pointer="$(get_setting pointer)"
        if ! wait_for_file "$tmp"; then
            echo "A16EEN: screenshot file was not created." >&2
            exit 1
        fi
        [[ -z "$snapshot" ]] || rm -f "$snapshot"
        finalize_capture "$tmp"
        ACTIVE_TEMP_PATH=""
        ;;
    area)
        [[ $# -eq 6 ]] || exit 2
        snapshot="$2"
        x="$3"
        y="$4"
        width="$5"
        height="$6"
        tmp="$TEMP_DIR/area-$(date +%s%N).png"
        grim -g "${x},${y} ${width}x${height}" "$tmp" >/dev/null
        finalize_capture "$tmp"
        rm -f "$snapshot" 2>/dev/null || true
        ACTIVE_TEMP_PATH=""
        ;;
    *)
        echo "Usage: a16een-screenshot {screen|window|prepare-area|prepare-window|area|settings}" >&2
        exit 2
        ;;
esac
