#!/bin/bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/a16een"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
SCREENSHOT_STATE="$STATE_DIR/screenshot.conf"
QS_CONFIG="$CONFIG_DIR/quickshell/a16een"
TEMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/a16een-screenshots"

mkdir -p "$STATE_DIR" "$TEMP_DIR"

if [[ ! -f "$SCREENSHOT_STATE" ]]; then
    cat > "$SCREENSHOT_STATE" <<EOF
save=true
save_dir=$HOME/Pictures/Screenshots
clipboard=true
pointer=true
delay=0
EOF
fi

get_setting() {
    local key="$1"
    awk -F= -v key="$key" '$1 == key {value=$0; sub(/^[^=]*=/, "", value); print value; exit}' "$SCREENSHOT_STATE"
}

if ! grep -q '^save=' "$SCREENSHOT_STATE"; then
    tmp="$(mktemp "$STATE_DIR/screenshot.conf.XXXXXX")"
    {
        printf '%s\n' 'save=true'
        cat "$SCREENSHOT_STATE"
    } > "$tmp"
    mv "$tmp" "$SCREENSHOT_STATE"
fi

expand_path() {
    local value="$1"
    case "$value" in
        "~") printf '%s\n' "$HOME" ;;
        "~/"*) printf '%s/%s\n' "$HOME" "${value#~/}" ;;
        "") printf '%s\n' "$HOME/Pictures/Screenshots" ;;
        *) printf '%s\n' "$value" ;;
    esac
}

write_setting() {
    local key="$1"
    local value="$2"
    local tmp
    tmp="$(mktemp "$STATE_DIR/screenshot.conf.XXXXXX")"
    awk -F= -v key="$key" -v value="$value" '
        BEGIN { updated=0 }
        $1 == key { print key "=" value; updated=1; next }
        { print }
        END { if (!updated) print key "=" value }
    ' "$SCREENSHOT_STATE" > "$tmp"
    mv "$tmp" "$SCREENSHOT_STATE"
}

notify_preview() {
    local path="$1"
    qs -c "$QS_CONFIG" ipc call screenshot preview "$path" >/dev/null 2>&1 || true
}

finalize_capture() {
    local source="$1"
    local output="$source"
    local save_dir

    if [[ "$(get_setting save)" == "true" ]]; then
        save_dir="$(expand_path "$(get_setting save_dir)")"
        mkdir -p "$save_dir"
        output="$save_dir/A16EEN $(date '+%Y-%m-%d %H-%M-%S-%N').png"
        mv -f "$source" "$output"
    else
        output="$TEMP_DIR/last.png"
        cp -f "$source" "$output"
        rm -f "$source"
    fi

    if [[ "$(get_setting clipboard)" == "true" ]]; then
        wl-copy --type image/png < "$output"
    else
        wl-copy --clear >/dev/null 2>&1 || true
    fi

    notify_preview "$output"
    printf '%s\n' "$output"
}

case "${1:-}" in
    settings)
        case "${2:-}" in
            get)
                cat "$SCREENSHOT_STATE"
                ;;
            set)
                [[ $# -ge 4 ]] || exit 2
                key="$3"
                value="$4"
                case "$key" in
                    save|clipboard|pointer)
                        [[ "$value" == "true" || "$value" == "false" ]] || exit 2
                        ;;
                    save_dir)
                        value="$(expand_path "$value")"
                        ;;
                    delay)
                        [[ "$value" =~ ^(0|3|5)$ ]] || exit 2
                        ;;
                    *)
                        exit 2
                        ;;
                esac
                write_setting "$key" "$value"
                ;;
            *)
                exit 2
                ;;
        esac
        ;;
    prepare-area)
        tmp="$TEMP_DIR/area-$(date +%s%N).png"
        if [[ "$(get_setting pointer)" == "true" ]]; then
            grim -c "$tmp"
        else
            grim "$tmp"
        fi
        printf '%s\n' "$tmp"
        ;;
    screen)
        delay="$(get_setting delay)"
        [[ "$delay" =~ ^[0-9]+$ ]] || delay=0
        (( delay > 0 )) && sleep "$delay"
        tmp="$TEMP_DIR/capture-$(date +%s%N).png"
        niri msg action screenshot-screen --path "$tmp" --show-pointer="$(get_setting pointer)"
        if ! wait_for_file "$tmp"; then
            echo "A16EEN: screenshot file was not created." >&2
            exit 1
        fi
        finalize_capture "$tmp"
        ;;
    window)
        selected="$(niri msg --json pick-window | jq -r '.id // empty')"
        [[ -n "$selected" ]] || exit 0
        delay="$(get_setting delay)"
        [[ "$delay" =~ ^[0-9]+$ ]] || delay=0
        (( delay > 0 )) && sleep "$delay"
        tmp="$TEMP_DIR/capture-$(date +%s%N).png"
        niri msg action screenshot-window --id "$selected" --path "$tmp" --show-pointer="$(get_setting pointer)"
        if ! wait_for_file "$tmp"; then
            echo "A16EEN: screenshot file was not created." >&2
            exit 1
        fi
        finalize_capture "$tmp"
        ;;
    area)
        [[ $# -eq 6 ]] || exit 2
        snapshot="$2"
        x="$3"
        y="$4"
        width="$5"
        height="$6"
        tmp="$TEMP_DIR/area-$(date +%s%N).png"
        grim -g "${x},${y} ${width}x${height}" "$tmp" >/dev/null
        finalize_capture "$tmp"
        rm -f "$snapshot" 2>/dev/null || true
        ;;
    *)
        echo "Usage: a16een-screenshot {screen|window|prepare-area|area|settings}" >&2
        exit 2
        ;;
esac
