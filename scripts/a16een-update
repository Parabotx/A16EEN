#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/a16een/source"

if [[ $EUID -eq 0 ]]; then
    echo "Run a16een-update as your normal desktop user, not root."
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    echo "Git is missing. Run the A16EEN installer first."
    exit 1
fi

if [[ ! -d "$SOURCE_DIR/.git" ]]; then
    echo "A16EEN source is not installed yet."
    echo "Run the main installer first."
    exit 1
fi

if [[ -n "$(git -C "$SOURCE_DIR" status --porcelain)" ]]; then
    echo "A16EEN source contains local changes; refusing to overwrite them."
    git -C "$SOURCE_DIR" status --short
    exit 1
fi

echo "==> Checking A16EEN for updates..."
git -C "$SOURCE_DIR" fetch --depth 1 origin main

LOCAL_COMMIT="$(git -C "$SOURCE_DIR" rev-parse HEAD)"
REMOTE_COMMIT="$(git -C "$SOURCE_DIR" rev-parse origin/main)"

if [[ "$LOCAL_COMMIT" == "$REMOTE_COMMIT" ]]; then
    echo "A16EEN is already up to date."
else
    echo "==> Applying A16EEN update..."
    git -C "$SOURCE_DIR" merge --ff-only origin/main
fi

exec bash "$SOURCE_DIR/scripts/install.sh"
