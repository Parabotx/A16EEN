#!/usr/bin/env bash
set -euo pipefail

target="${1:-}"
[[ -n "$target" ]] || exit 2

command -v niri >/dev/null 2>&1 || exit 1
command -v jq >/dev/null 2>&1 || exit 1

workspace_id="$(niri msg -j workspaces 2>/dev/null |
    jq -r --arg name "$target" '[.[] | select(.name == $name) | .id][0] // empty')"

if [[ "$workspace_id" =~ ^[0-9]+$ ]]; then
    request="$(jq -cn --argjson id "$workspace_id"         '{Action:{FocusWorkspace:{reference:{Id:$id}}}}')"
    printf '%s\n' "$request" | niri msg raw-request >/dev/null
    exit 0
fi

if command -v a16een-workspaces >/dev/null 2>&1; then
    a16een-workspaces apply >/dev/null 2>&1 || true
fi

niri msg action focus-workspace "$target" >/dev/null
