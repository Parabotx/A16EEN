#!/usr/bin/env bash
set -euo pipefail

readonly ICON_VERSION="1.50.0"
readonly ICON_BASE_URL="https://raw.githubusercontent.com/lucide-icons/lucide/${ICON_VERSION}/icons"
readonly ICON_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/a16een/quickshell/a16een/assets/icons"

readonly ICONS=(
    "house.svg"
    "house-heart.svg"
    "house-plus.svg"
    "house-wifi.svg"
    "monitor.svg"
    "app-window.svg"
    "folder.svg"
    "folder-open.svg"
    "code.svg"
    "terminal.svg"
    "globe.svg"
    "messages-square.svg"
    "music.svg"
    "sparkles.svg"
    "palette.svg"
    "sun.svg"
    "moon.svg"
    "volume-2.svg"
    "skull.svg"
    "ghost.svg"
    "bug.svg"
    "bot.svg"
    "radiation.svg"
    "biohazard.svg"
    "orbit.svg"
    "rocket.svg"
    "gamepad-2.svg"
    "dice-5.svg"
    "coffee.svg"
    "camera.svg"
    "heart.svg"
    "flame.svg"
    "crown.svg"
    "diamond.svg"
    "zap.svg"
    "fish.svg"
    "cat.svg"
    "eye.svg"
    "brain.svg"
    "wand-sparkles.svg"
    "graduation-cap.svg"
    "briefcase-business.svg"
    "cloud.svg"
    "map-pin.svg"
    "compass.svg"
    "command.svg"
)

if [[ $EUID -eq 0 ]]; then
    echo "a16een-icons must run as your normal desktop user, not root." >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "A16EEN icon sync skipped: curl is not installed." >&2
    exit 0
fi

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT INT TERM

for icon in "${ICONS[@]}"; do
    target="$tmp_dir/$icon"

    if ! curl -fsSL \
        --proto '=https' \
        --tlsv1.2 \
        "${ICON_BASE_URL}/${icon}" \
        -o "$target"; then
        echo "A16EEN icon sync failed while downloading $icon." >&2
        echo "Keeping the previous icon set." >&2
        exit 0
    fi

    # A16EEN's dock uses a monochrome icon language. Normalize Lucide's
    # currentColor stroke to the same black fallback during synchronization.
    sed -i 's/stroke="currentColor"/stroke="#111111"/g' "$target"
done

mkdir -p "$ICON_ROOT"

for icon in "${ICONS[@]}"; do
    [[ -f "$tmp_dir/$icon" ]] || continue
    install -Dm644 "$tmp_dir/$icon" "$ICON_ROOT/$icon"
done

printf "A16EEN icons synced from Lucide %s (%d/%d requested icons).\n"     "$ICON_VERSION" "$successful" "${#ICONS[@]}"
