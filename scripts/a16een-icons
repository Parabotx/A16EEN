#!/usr/bin/env bash
set -euo pipefail

readonly ICON_VERSION="1.50.0"
readonly ICON_BASE_URL="https://raw.githubusercontent.com/lucide-icons/lucide/${ICON_VERSION}/icons"
readonly ICON_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/a16een/quickshell/a16een/assets/icons"

readonly ICONS=(
    "house.svg"
    "house-heart.svg"
    "house-plus.svg"
    "house-wifi.svg"
    "monitor.svg"
    "app-window.svg"
    "folder.svg"
    "folder-open.svg"
    "code.svg"
    "terminal.svg"
    "globe.svg"
    "messages-square.svg"
    "music.svg"
    "sparkles.svg"
    "palette.svg"
    "sun.svg"
    "moon.svg"
    "volume-2.svg"
    "skull.svg"
    "ghost.svg"
    "bug.svg"
    "bot.svg"
    "radiation.svg"
    "biohazard.svg"
    "orbit.svg"
    "rocket.svg"
    "gamepad-2.svg"
    "dice-5.svg"
    "coffee.svg"
    "camera.svg"
    "heart.svg"
    "flame.svg"
    "crown.svg"
    "diamond.svg"
    "zap.svg"
    "fish.svg"
    "cat.svg"
    "eye.svg"
    "brain.svg"
    "wand-sparkles.svg"
    "graduation-cap.svg"
    "briefcase-business.svg"
    "cloud.svg"
    "map-pin.svg"
    "compass.svg"
    "command.svg"
    "accessibility.svg"
    "alarm-clock.svg"
    "archive.svg"
    "badge-check.svg"
    "bell.svg"
    "book-open.svg"
    "bookmark.svg"
    "calendar.svg"
    "check.svg"
    "badge-alert.svg"
    "circle.svg"
    "circle-check.svg"
    "circle-minus.svg"
    "circle-plus.svg"
    "clipboard.svg"
    "clock.svg"
    "cloud-sun.svg"
    "cpu.svg"
    "database.svg"
    "download.svg"
    "ellipsis.svg"
    "external-link.svg"
    "file.svg"
    "file-code.svg"
    "list-filter.svg"
    "flag.svg"
    "gauge.svg"
    "git-branch.svg"
    "git-pull-request.svg"
    "hard-drive.svg"
    "headphones.svg"
    "image.svg"
    "inbox.svg"
    "key.svg"
    "keyboard.svg"
    "layers.svg"
    "link.svg"
    "list.svg"
    "lock.svg"
    "mail.svg"
    "menu.svg"
    "mic.svg"
    "mouse.svg"
    "network.svg"
    "package.svg"
    "pen.svg"
    "phone.svg"
    "play.svg"
    "printer.svg"
    "save.svg"
    "search.svg"
    "server.svg"
    "settings.svg"
    "shield-check.svg"
    "shopping-bag.svg"
    "sliders-horizontal.svg"
    "smartphone.svg"
    "star.svg"
    "tag.svg"
    "trash.svg"
    "upload.svg"
    "user.svg"
    "users.svg"
    "video.svg"
    "wifi.svg"
    "wrench.svg"
    "x.svg"
)

if [[ $EUID -eq 0 ]]; then
    echo "a16een-icons must run as your normal desktop user, not root." >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "A16EEN icon sync skipped: curl is not installed." >&2
    exit 0
fi

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT INT TERM

successful=0

for icon in "${ICONS[@]}"; do
    target="$tmp_dir/$icon"

    if ! curl -fsSL         --proto '=https'         --tlsv1.2         "${ICON_BASE_URL}/${icon}"         -o "$target"; then
        echo "A16EEN icon sync skipped unavailable icon: $icon." >&2
        rm -f "$target"
        continue
    fi

    if ! grep -q '<svg' "$target"; then
        echo "A16EEN icon sync skipped invalid SVG: $icon." >&2
        rm -f "$target"
        continue
    fi

    sed -i 's/stroke="currentColor"/stroke="#111111"/g' "$target"
    successful=$((successful + 1))
done

mkdir -p "$ICON_ROOT"

for icon in "${ICONS[@]}"; do
    [[ -f "$tmp_dir/$icon" ]] || continue
    install -Dm644 "$tmp_dir/$icon" "$ICON_ROOT/$icon"
done

printf "A16EEN icons synced from Lucide %s (%d/%d requested icons).\n"     "$ICON_VERSION" "$successful" "${#ICONS[@]}"
