#!/usr/bin/env bash
set -euo pipefail

STATE_BASE="$(printenv XDG_STATE_HOME 2>/dev/null || printf '%s' "$HOME/.local/state")"
STATE_DIR="$STATE_BASE/a16een"
STATE_FILE="$STATE_DIR/navbar-appearance.json"
NAVBAR_CMD="$(printenv A16EEN_NAVBAR_CMD 2>/dev/null || printf '%s' /usr/local/bin/a16een-navbar)"

default_all='{"visibilityControl":false,"visible":true,"applyContainerColor":false,"containerColor":"#15171A","applyIconColor":false,"iconColor":"auto","surfaceColor":"#FFFFFF"}'
default_container='{"visible":true,"containerEnabled":false,"containerColor":"transparent","iconColor":"inherit"}'
container_ids='["workspaces","battery","time","utilities","power"]'

ensure_settings() {
    mkdir -p "$STATE_DIR"
    if [[ ! -s "$STATE_FILE" ]]; then
        jq -n --argjson allDefaults "$default_all" --argjson containerDefaults "$default_container" \
            --argjson ids "$container_ids" '
            {all:$allDefaults, containers:{}, schemaVersion:2}
            | reduce $ids[] as $id (.;
                .containers[$id] = $containerDefaults
              )
        ' > "$STATE_FILE"
        chmod 600 "$STATE_FILE"
        return
    fi

    jq empty "$STATE_FILE" >/dev/null 2>&1 || {
        echo "A16EEN appearance: settings JSON is invalid; leaving it untouched." >&2
        return 1
    }

    local tmp
    tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
    if ! jq --argjson allDefaults "$default_all" --argjson containerDefaults "$default_container" \
        --argjson ids "$container_ids" '
        .all = ($allDefaults + (.all // {}))
        | .containers = (.containers // {})
        | reduce $ids[] as $id (.;
            .containers[$id] = ($containerDefaults + (.containers[$id] // {}))
          )
        | del(.workspaces)
        | .schemaVersion = 2
    ' "$STATE_FILE" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

normalize_bool() {
    case "$1" in
        true|on|yes|1) printf 'true' ;;
        false|off|no|0) printf 'false' ;;
        *) return 1 ;;
    esac
}
valid_hex() { [[ "$1" =~ ^#[0-9A-Fa-f]{6}$ ]]; }

write_all() {
    local key="$1" value="$2" tmp
    case "$key" in
        visibilityControl|visible|applyContainerColor|applyIconColor)
            value="$(normalize_bool "$value")" || {
                echo "A16EEN appearance: $key must be on or off." >&2
                return 2
            }
            tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
            jq --arg key "$key" --argjson value "$value" '.all[$key] = $value' "$STATE_FILE" > "$tmp"
            ;;
        containerColor)
            valid_hex "$value" || {
                echo "A16EEN appearance: shared background must be a #RRGGBB value." >&2
                return 2
            }
            value="$(printf '%s' "$value" | tr '[:lower:]' '[:upper:]')"
            tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
            jq --arg value "$value" '.all.containerColor = $value' "$STATE_FILE" > "$tmp"
            ;;
        iconColor)
            { valid_hex "$value" || [[ "$value" == "auto" ]]; } || {
                echo "A16EEN appearance: icon color must be #RRGGBB or auto." >&2
                return 2
            }
            if valid_hex "$value"; then value="$(printf '%s' "$value" | tr '[:lower:]' '[:upper:]')"; fi
            tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
            jq --arg value "$value" '.all.iconColor = $value' "$STATE_FILE" > "$tmp"
            ;;
        *)
            echo "A16EEN appearance: unsupported All setting: $key" >&2
            return 2
            ;;
    esac
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

write_container() {
    local id="$1" key="$2" value="$3" tmp
    case "$id" in
        workspaces|battery|time|utilities|power) ;;
        *) echo "A16EEN appearance: unknown navbar container: $id" >&2; return 2 ;;
    esac
    case "$key" in
        visible)
            if jq -e '.all.visibilityControl == true' "$STATE_FILE" >/dev/null 2>&1; then
                echo "A16EEN appearance: turn off All visibility control first." >&2
                return 2
            fi
            value="$(normalize_bool "$value")" || {
                echo "A16EEN appearance: visible must be on or off." >&2
                return 2
            }
            tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
            jq --arg id "$id" --argjson value "$value" '.containers[$id].visible = $value' "$STATE_FILE" > "$tmp"
            ;;
        containerColor)
            if jq -e '.all.applyContainerColor == true' "$STATE_FILE" >/dev/null 2>&1; then
                echo "A16EEN appearance: turn off All background override first." >&2
                return 2
            fi
            { valid_hex "$value" || [[ "$value" == "transparent" ]]; } || {
                echo "A16EEN appearance: container color must be #RRGGBB or transparent." >&2
                return 2
            }
            if valid_hex "$value"; then value="$(printf '%s' "$value" | tr '[:lower:]' '[:upper:]')"; fi
            tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
            jq --arg id "$id" --arg value "$value" \
                '.containers[$id].containerColor = $value
                 | .containers[$id].containerEnabled = ($value != "transparent")' "$STATE_FILE" > "$tmp"
            ;;
        iconColor)
            if jq -e '.all.applyIconColor == true' "$STATE_FILE" >/dev/null 2>&1; then
                echo "A16EEN appearance: turn off All icon-color override first." >&2
                return 2
            fi
            { valid_hex "$value" || [[ "$value" == "auto" || "$value" == "inherit" ]]; } || {
                echo "A16EEN appearance: icon color must be #RRGGBB, auto, or inherit." >&2
                return 2
            }
            if valid_hex "$value"; then value="$(printf '%s' "$value" | tr '[:lower:]' '[:upper:]')"; fi
            tmp="$(mktemp "$STATE_DIR/navbar-appearance.json.XXXXXX")"
            jq --arg id "$id" --arg value "$value" '.containers[$id].iconColor = $value' "$STATE_FILE" > "$tmp"
            ;;
        *)
            echo "A16EEN appearance: unsupported container setting: $key" >&2
            return 2
            ;;
    esac
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

main() {
    local action="get"
    if [[ $# -gt 0 ]]; then action="$1"; fi
    case "$action" in
        get) ensure_settings; cat "$STATE_FILE" ;;
        set)
            [[ $# -eq 5 ]] || {
                echo "Usage: a16een-navbar-appearance set <all|container> <id|-> <key> <value>" >&2
                return 2
            }
            local scope="$2" id="$3" key="$4" value="$5"
            mkdir -p "$STATE_DIR"
            exec 9>"$STATE_DIR/navbar-appearance.lock"
            flock -x 9
            ensure_settings
            case "$scope" in
                all)
                    [[ "$id" == "-" ]] || { echo "Use '-' for All settings." >&2; return 2; }
                    write_all "$key" "$value"
                    ;;
                container) write_container "$id" "$key" "$value" ;;
                *) echo "Scope must be all or container." >&2; return 2 ;;
            esac
            flock -u 9
            if [[ -x "$NAVBAR_CMD" ]]; then "$NAVBAR_CMD" apply; fi
            ;;
        *) echo "Usage: a16een-navbar-appearance {get|set <all|container> <id|-> <key> <value>}" >&2; return 2 ;;
    esac
}
main "$@"
