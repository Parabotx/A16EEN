#!/usr/bin/env python3
"""A16EEN local music helper. Plays files from ~/Music through MPV's IPC socket."""
import hashlib
import math
import json
import os
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path

MUSIC_DIR = (Path.home() / "Music").resolve()
AUDIO_EXTENSIONS = {
    ".mp3", ".flac", ".ogg", ".opus", ".m4a", ".wav", ".aac",
    ".wma", ".aiff", ".aif", ".ape", ".mpc", ".mka", ".webm"
}
MPV_BIN = "mpv"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or (Path.home() / ".local/state/a16een"))
SOCKET_PATH = RUNTIME_DIR / "a16een-music.sock"
COVER_CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "a16een/music-covers"
COVER_NAMES = ("cover", "folder", "front", "album", "albumart", "albumartsmall", "artwork", ".folder", "thumb")


def emit(payload):
    print(json.dumps(payload, ensure_ascii=False))


def prepare_runtime():
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)


def find_sidecar_cover(path):
    candidates = []
    try:
        for item in path.parent.iterdir():
            if not item.is_file() or item.suffix.lower() not in {".jpg", ".jpeg", ".png", ".webp", ".avif"}:
                continue
            if item.stem.casefold() in COVER_NAMES:
                candidates.append(item)
        if not candidates:
            return ""
        candidates.sort(key=lambda item: (COVER_NAMES.index(item.stem.casefold()), item.name.casefold()))
        return candidates[0].as_uri()
    except OSError:
        return ""


def find_cover(path, embedded=False):
    """Find a nearby cover image, optionally extracting embedded artwork once."""
    sidecar = find_sidecar_cover(path)
    if sidecar or not embedded:
        return sidecar

    try:
        stat = path.stat()
        cache_key = hashlib.sha256(
            f"{path.resolve()}:{stat.st_size}:{stat.st_mtime_ns}".encode("utf-8")
        ).hexdigest()
        COVER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        cached_cover = COVER_CACHE_DIR / f"{cache_key}.jpg"
        missing_marker = COVER_CACHE_DIR / f"{cache_key}.missing"
        if cached_cover.is_file() and cached_cover.stat().st_size > 0:
            return cached_cover.as_uri()
        if missing_marker.exists() or not shutil_which("ffmpeg"):
            return ""

        try:
            result = subprocess.run(
                [
                    "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                    "-i", str(path), "-map", "0:v:0", "-frames:v", "1",
                    "-q:v", "3", str(cached_cover)
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=8,
                check=False
            )
        except (OSError, subprocess.TimeoutExpired):
            result = None

        if result is not None and result.returncode == 0 and cached_cover.is_file() and cached_cover.stat().st_size > 0:
            return cached_cover.as_uri()

        try:
            cached_cover.unlink(missing_ok=True)
            missing_marker.touch(exist_ok=True)
        except OSError:
            pass
    except OSError:
        return ""

    return ""


def scan_library():
    tracks = []
    if not MUSIC_DIR.is_dir():
        return tracks
    try:
        files = sorted(
            (p for p in MUSIC_DIR.rglob("*")
             if p.is_file() and p.suffix.lower() in AUDIO_EXTENSIONS),
            key=lambda p: str(p.relative_to(MUSIC_DIR)).casefold()
        )
    except OSError:
        return tracks

    cover_cache = {}
    for path in files:
        try:
            relative_parent = path.parent.relative_to(MUSIC_DIR)
            folder = relative_parent.as_posix() if str(relative_parent) != "." else "Local library"
            title = path.stem.replace("_", " ").strip()
            parent_key = str(path.parent)
            if parent_key not in cover_cache:
                cover_cache[parent_key] = find_cover(path)
            tracks.append({
                "path": str(path),
                "title": title or path.name,
                "artist": folder,
                "filename": path.name,
                "cover": cover_cache[parent_key]
            })
        except (OSError, ValueError):
            continue
    return tracks


def open_ipc(timeout=0.45):
    prepare_runtime()
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(SOCKET_PATH))
        return client
    except (OSError, socket.timeout):
        client.close()
        return None


def send_command(command, wait_for_response=False, timeout=0.65):
    client = open_ipc(timeout=timeout)
    if client is None:
        return None
    try:
        message = {"command": command, "request_id": 1}
        client.sendall((json.dumps(message) + "\n").encode("utf-8"))
        if not wait_for_response:
            return {"ok": True}
        stream = client.makefile("r", encoding="utf-8", errors="replace")
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                line = stream.readline()
            except (OSError, socket.timeout):
                break
            if not line:
                break
            try:
                response = json.loads(line)
            except json.JSONDecodeError:
                continue
            if response.get("request_id") == 1:
                return {
                    "ok": response.get("error") == "success",
                    "error": response.get("error", "")
                }
        return {"ok": True}
    except (OSError, socket.timeout):
        return None
    finally:
        client.close()


def play_path(raw_path):
    candidate = Path(raw_path).expanduser().resolve()
    try:
        candidate.relative_to(MUSIC_DIR)
    except ValueError:
        return {"ok": False, "error": "Choose a song from your Music folder."}
    if not candidate.is_file() or candidate.suffix.lower() not in AUDIO_EXTENSIONS:
        return {"ok": False, "error": "That audio file is no longer available."}

    result = send_command(["loadfile", str(candidate), "replace"], wait_for_response=True)
    if result is not None:
        if result.get("ok"):
            return {"ok": True}
        return {"ok": False, "error": "MPV could not open that track."}

    if not shutil_which(MPV_BIN):
        return {"ok": False, "error": "MPV is missing. Update A16EEN to install it."}

    prepare_runtime()
    try:
        SOCKET_PATH.unlink(missing_ok=True)
    except OSError:
        pass
    try:
        subprocess.Popen(
            [
                MPV_BIN, "--no-video", "--force-window=no", "--idle=yes",
                "--input-ipc-server=" + str(SOCKET_PATH), "--", str(candidate)
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True
        )
    except OSError:
        return {"ok": False, "error": "MPV could not be started."}

    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        result = send_command(["get_property", "path"], wait_for_response=True, timeout=0.25)
        if result is not None:
            return {"ok": True}
        time.sleep(0.08)
    return {"ok": True, "message": "Starting player…"}


def shutil_which(name):
    from shutil import which
    return which(name)


def read_status():
    requests = {
        1: ["get_property", "path"],
        2: ["get_property", "media-title"],
        3: ["get_property", "duration"],
        4: ["get_property", "time-pos"],
        5: ["get_property", "pause"],
        6: ["get_property", "loop-file"],
        7: ["get_property", "metadata"],
        8: ["get_property", "loop-playlist"]
    }
    client = open_ipc(timeout=0.25)
    if client is None:
        return {
            "running": False, "path": "", "title": "", "duration": 0,
            "time": 0, "paused": True, "error": ""
        }

    values = {}
    pending = bytearray()
    try:
        for request_id, command in requests.items():
            client.sendall((json.dumps({"command": command, "request_id": request_id}) + "\n").encode("utf-8"))
        import select
        deadline = time.monotonic() + 0.8
        while time.monotonic() < deadline and len(values) < len(requests):
            readable, _, _ = select.select([client], [], [], max(0, deadline - time.monotonic()))
            if not readable:
                break
            chunk = client.recv(8192)
            if not chunk:
                break
            pending.extend(chunk)
            while b"\n" in pending:
                raw_line, _, remainder = pending.partition(b"\n")
                pending = bytearray(remainder)
                try:
                    response = json.loads(raw_line.decode("utf-8", errors="replace"))
                except json.JSONDecodeError:
                    continue
                request_id = response.get("request_id")
                if request_id in requests and response.get("error") == "success":
                    values[request_id] = response.get("data")
    except (OSError, socket.timeout, ValueError):
        pass
    finally:
        client.close()

    path = values.get(1) or ""
    metadata = values.get(7) if isinstance(values.get(7), dict) else {}
    title = (metadata.get("title") or metadata.get("TITLE")
             or values.get(2) or (Path(path).stem if path else ""))
    artist = (metadata.get("artist") or metadata.get("ARTIST")
              or metadata.get("album_artist") or metadata.get("ALBUM_ARTIST") or "")
    album = metadata.get("album") or metadata.get("ALBUM") or ""
    try:
        duration = max(0.0, float(values.get(3) or 0))
    except (TypeError, ValueError):
        duration = 0.0
    try:
        position = max(0.0, float(values.get(4) or 0))
    except (TypeError, ValueError):
        position = 0.0
    return {
        "running": True,
        "path": path,
        "title": str(title),
        "artist": str(artist),
        "album": str(album),
        "cover": find_cover(Path(path), embedded=True) if path else "",
        "duration": duration,
        "time": position,
        "paused": bool(values.get(5, True)),
        "repeat": str(values.get(6) or "no") == "inf",
        "loopPlaylist": str(values.get(8) or "no"),
        "error": ""
    }


def visualizer_state():
    """Read short PCM windows from the current track and build 21 spectral bars."""
    inactive = {
        "active": False,
        "level": 0.0,
        "rmsDb": -96.0,
        "bandLevels": [0.0] * 21,
        "hardBeat": False
    }
    status = read_status()
    raw_path = str(status.get("path") or "")
    if not status.get("running") or not raw_path or status.get("paused", True):
        return inactive

    try:
        audio_path = Path(raw_path).expanduser().resolve()
        position = max(0.0, float(status.get("time") or 0.0))
    except (OSError, RuntimeError, ValueError, TypeError):
        return inactive
    if not audio_path.is_file():
        return inactive

    ffmpeg = shutil_which("ffmpeg")
    if not ffmpeg:
        return {**inactive, "reason": "ffmpeg is not available"}

    # Sample a little over 200 ms. Each update is analysed into separate
    # frequency bands, rather than animating a synthetic sine-wave pattern.
    command = [
        ffmpeg, "-hide_banner", "-loglevel", "error",
        "-ss", f"{position:.3f}", "-i", str(audio_path),
        "-t", "0.22", "-vn", "-ac", "1", "-ar", "8000",
        "-f", "s16le", "pipe:1"
    ]
    try:
        sample = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=1.2,
            check=False
        )
    except (OSError, subprocess.TimeoutExpired):
        return {**inactive, "reason": "could not sample the current audio window"}

    pcm = sample.stdout
    usable_bytes = len(pcm) - (len(pcm) % 2)
    if sample.returncode != 0 or usable_bytes < 256:
        return {**inactive, "reason": "audio sample is unavailable"}

    count = usable_bytes // 2
    try:
        samples = struct.unpack("<" + ("h" * count), pcm[:usable_bytes])
    except struct.error:
        return {**inactive, "reason": "invalid PCM sample"}

    square_mean = sum(value * value for value in samples) / count
    rms = math.sqrt(square_mean) / 32768.0
    peak = max(abs(value) for value in samples) / 32768.0
    rms_db = 20.0 * math.log10(max(rms, 0.000001))
    peak_db = 20.0 * math.log10(max(peak, 0.000001))
    level = max(0.0, min(1.0, (rms_db + 45.0) / 38.0))

    # Hann-windowed Goertzel probes estimate local energy at three nearby
    # frequencies per bar. It is small enough to run without NumPy or a GPU.
    sample_rate = 8000.0
    windowed = []
    window_sum = 0.0
    denominator = max(1, count - 1)
    for index, value in enumerate(samples):
        window = 0.5 - 0.5 * math.cos((2.0 * math.pi * index) / denominator)
        windowed.append(value * window)
        window_sum += window

    def tone_amplitude(frequency):
        frequency = max(35.0, min(3700.0, frequency))
        coefficient = 2.0 * math.cos((2.0 * math.pi * frequency) / sample_rate)
        q1 = 0.0
        q2 = 0.0
        for value in windowed:
            q0 = value + coefficient * q1 - q2
            q2 = q1
            q1 = q0
        power = max(0.0, q1 * q1 + q2 * q2 - coefficient * q1 * q2)
        return (2.0 * math.sqrt(power)) / max(1.0, window_sum * 32768.0)

    band_amplitudes = []
    band_levels = []
    for index in range(21):
        centre = 48.0 * ((3300.0 / 48.0) ** (index / 20.0))
        adjacent = [
            tone_amplitude(centre * 0.91),
            tone_amplitude(centre),
            tone_amplitude(centre * 1.10)
        ]
        amplitude = math.sqrt(sum(value * value for value in adjacent) / len(adjacent))
        band_amplitudes.append(amplitude)
        amplitude_db = 20.0 * math.log10(max(amplitude, 0.000001))
        band_levels.append(max(0.0, min(1.0, (amplitude_db + 52.0) / 34.0)))

    bass_amplitude = math.sqrt(
        sum(value * value for value in band_amplitudes[:5]) / 5.0
    )
    bass_db = 20.0 * math.log10(max(bass_amplitude, 0.000001))

    meter_state = COVER_CACHE_DIR.parent / "music-meter-state.json"
    baseline_db = None
    baseline_bass_db = None
    try:
        previous = json.loads(meter_state.read_text(encoding="utf-8"))
        if previous.get("path") == str(audio_path):
            value = previous.get("baselineDb")
            bass_value = previous.get("baselineBassDb")
            if isinstance(value, (float, int)):
                baseline_db = float(value)
            if isinstance(bass_value, (float, int)):
                baseline_bass_db = float(bass_value)
    except (OSError, UnicodeError, json.JSONDecodeError, AttributeError, TypeError, ValueError):
        pass

    # A beat is a real transient: a sudden bass or broadband rise relative to
    # the same track's recent energy floor. The peak/RMS fallback catches sharp
    # kick/snare hits even when the track is heavily compressed.
    bass_rise = (
        baseline_bass_db is not None
        and bass_db >= -38.0
        and bass_db - baseline_bass_db >= 1.8
    )
    rms_rise = (
        baseline_db is not None
        and rms_db >= -34.0
        and rms_db - baseline_db >= 3.0
    )
    sharp_transient = rms_db >= -35.0 and peak_db - rms_db >= 10.0
    hard_beat = rms_db >= -9.5 or bass_rise or rms_rise or sharp_transient

    updated_baseline = rms_db if baseline_db is None else (0.90 * baseline_db + 0.10 * rms_db)
    updated_bass_baseline = (
        bass_db if baseline_bass_db is None
        else 0.88 * baseline_bass_db + 0.12 * bass_db
    )
    try:
        meter_state.parent.mkdir(parents=True, exist_ok=True)
        meter_state.write_text(json.dumps({
            "path": str(audio_path),
            "baselineDb": updated_baseline,
            "baselineBassDb": updated_bass_baseline
        }), encoding="utf-8")
    except OSError:
        pass

    return {
        "active": True,
        "level": round(level, 3),
        "rmsDb": round(rms_db, 2),
        "bandLevels": [round(value, 3) for value in band_levels],
        "hardBeat": bool(hard_beat)
    }

def main():
    args = sys.argv[1:]
    action = args[0] if args else "status"

    if action == "list":
        emit({
            "tracks": scan_library(),
            "directory": str(MUSIC_DIR),
            "directoryExists": MUSIC_DIR.is_dir()
        })
        return

    if action == "status":
        emit(read_status())
        return

    if action == "play":
        if len(args) < 2:
            emit({"ok": False, "error": "Choose a track first."})
            return
        emit(play_path(args[1]))
        return

    if action == "toggle":
        status = read_status()
        if not status.get("running") or not status.get("path"):
            emit({"ok": False, "error": "Choose a track to start playback."})
            return
        result = send_command(["set_property", "pause", not status.get("paused", True)], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "seek":
        if len(args) < 2:
            emit({"ok": False, "error": "A seek position is required."})
            return
        try:
            position = max(0.0, float(args[1]))
        except ValueError:
            emit({"ok": False, "error": "Invalid seek position."})
            return
        result = send_command(["seek", position, "absolute"], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "visualizer":
        emit(visualizer_state())
        return

    if action == "repeat":
        # 0 = off, 1 = repeat current song, 2 = repeat its folder (handled by
        # the widget when MPV reaches the end of a track).
        try:
            mode = int(args[1]) if len(args) > 1 else (0 if read_status().get("repeat") else 1)
        except (TypeError, ValueError):
            emit({"ok": False, "error": "Invalid repeat mode."})
            return
        if mode not in (0, 1, 2):
            emit({"ok": False, "error": "Invalid repeat mode."})
            return
        status = read_status()
        if not status.get("running"):
            emit({"ok": False, "error": "The music player is not running yet."})
            return
        file_loop = "inf" if mode == 1 else "no"
        first = send_command(["set_property", "loop-file", file_loop], wait_for_response=True)
        second = send_command(["set_property", "loop-playlist", "no"], wait_for_response=True)
        if first is None or second is None:
            emit({"ok": False, "error": "The music player is not responding."})
        elif not first.get("ok") or not second.get("ok"):
            emit({"ok": False, "error": "MPV could not change the repeat mode."})
        else:
            emit({"ok": True, "repeatMode": mode})
        return

    if action == "stop":
        result = send_command(["quit"], wait_for_response=False)
        emit({"ok": result is not None})
        return

    emit({"ok": False, "error": "Unknown music action."})
    sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        emit({"ok": False, "error": str(error)})
        sys.exit(1)
