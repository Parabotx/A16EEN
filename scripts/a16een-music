#!/usr/bin/env python3
"""A16EEN local music helper. Plays files from ~/Music through MPV's IPC socket."""
import hashlib
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

MUSIC_DIR = (Path.home() / "Music").resolve()
AUDIO_EXTENSIONS = {
    ".mp3", ".flac", ".ogg", ".opus", ".m4a", ".wav", ".aac",
    ".wma", ".aiff", ".aif", ".ape", ".mpc", ".mka", ".webm"
}
MPV_BIN = "mpv"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or (Path.home() / ".local/state/a16een"))
SOCKET_PATH = RUNTIME_DIR / "a16een-music.sock"
COVER_CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "a16een/music-covers"
COVER_NAMES = ("cover", "folder", "front", "album", "albumart", "albumartsmall", "artwork", ".folder", "thumb")


def emit(payload):
    print(json.dumps(payload, ensure_ascii=False))


def prepare_runtime():
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)


def find_sidecar_cover(path):
    candidates = []
    try:
        for item in path.parent.iterdir():
            if not item.is_file() or item.suffix.lower() not in {".jpg", ".jpeg", ".png", ".webp", ".avif"}:
                continue
            if item.stem.casefold() in COVER_NAMES:
                candidates.append(item)
        if not candidates:
            return ""
        candidates.sort(key=lambda item: (COVER_NAMES.index(item.stem.casefold()), item.name.casefold()))
        return candidates[0].as_uri()
    except OSError:
        return ""


def find_cover(path, embedded=False):
    """Find a nearby cover image, optionally extracting embedded artwork once."""
    sidecar = find_sidecar_cover(path)
    if sidecar or not embedded:
        return sidecar

    try:
        stat = path.stat()
        cache_key = hashlib.sha256(
            f"{path.resolve()}:{stat.st_size}:{stat.st_mtime_ns}".encode("utf-8")
        ).hexdigest()
        COVER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        cached_cover = COVER_CACHE_DIR / f"{cache_key}.jpg"
        missing_marker = COVER_CACHE_DIR / f"{cache_key}.missing"
        if cached_cover.is_file() and cached_cover.stat().st_size > 0:
            return cached_cover.as_uri()
        if missing_marker.exists() or not shutil_which("ffmpeg"):
            return ""

        try:
            result = subprocess.run(
                [
                    "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                    "-i", str(path), "-map", "0:v:0", "-frames:v", "1",
                    "-q:v", "3", str(cached_cover)
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=8,
                check=False
            )
        except (OSError, subprocess.TimeoutExpired):
            result = None

        if result is not None and result.returncode == 0 and cached_cover.is_file() and cached_cover.stat().st_size > 0:
            return cached_cover.as_uri()

        try:
            cached_cover.unlink(missing_ok=True)
            missing_marker.touch(exist_ok=True)
        except OSError:
            pass
    except OSError:
        return ""

    return ""


def scan_library():
    tracks = []
    if not MUSIC_DIR.is_dir():
        return tracks
    try:
        files = sorted(
            (p for p in MUSIC_DIR.rglob("*")
             if p.is_file() and p.suffix.lower() in AUDIO_EXTENSIONS),
            key=lambda p: str(p.relative_to(MUSIC_DIR)).casefold()
        )
    except OSError:
        return tracks

    cover_cache = {}
    for path in files:
        try:
            relative_parent = path.parent.relative_to(MUSIC_DIR)
            folder = relative_parent.as_posix() if str(relative_parent) != "." else "Local library"
            title = path.stem.replace("_", " ").strip()
            parent_key = str(path.parent)
            if parent_key not in cover_cache:
                cover_cache[parent_key] = find_cover(path)
            tracks.append({
                "path": str(path),
                "title": title or path.name,
                "artist": folder,
                "filename": path.name,
                "cover": cover_cache[parent_key]
            })
        except (OSError, ValueError):
            continue
    return tracks


def open_ipc(timeout=0.45):
    prepare_runtime()
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(SOCKET_PATH))
        return client
    except (OSError, socket.timeout):
        client.close()
        return None


def send_command(command, wait_for_response=False, timeout=0.65):
    client = open_ipc(timeout=timeout)
    if client is None:
        return None
    try:
        message = {"command": command, "request_id": 1}
        client.sendall((json.dumps(message) + "\n").encode("utf-8"))
        if not wait_for_response:
            return {"ok": True}
        stream = client.makefile("r", encoding="utf-8", errors="replace")
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                line = stream.readline()
            except (OSError, socket.timeout):
                break
            if not line:
                break
            try:
                response = json.loads(line)
            except json.JSONDecodeError:
                continue
            if response.get("request_id") == 1:
                return {
                    "ok": response.get("error") == "success",
                    "error": response.get("error", "")
                }
        return {"ok": True}
    except (OSError, socket.timeout):
        return None
    finally:
        client.close()


def play_path(raw_path):
    candidate = Path(raw_path).expanduser().resolve()
    try:
        candidate.relative_to(MUSIC_DIR)
    except ValueError:
        return {"ok": False, "error": "Choose a song from your Music folder."}
    if not candidate.is_file() or candidate.suffix.lower() not in AUDIO_EXTENSIONS:
        return {"ok": False, "error": "That audio file is no longer available."}

    result = send_command(["loadfile", str(candidate), "replace"], wait_for_response=True)
    if result is not None:
        if result.get("ok"):
            return {"ok": True}
        return {"ok": False, "error": "MPV could not open that track."}

    if not shutil_which(MPV_BIN):
        return {"ok": False, "error": "MPV is missing. Update A16EEN to install it."}

    prepare_runtime()
    try:
        SOCKET_PATH.unlink(missing_ok=True)
    except OSError:
        pass
    try:
        subprocess.Popen(
            [
                MPV_BIN, "--no-video", "--force-window=no", "--idle=yes",
                "--input-ipc-server=" + str(SOCKET_PATH), "--", str(candidate)
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True
        )
    except OSError:
        return {"ok": False, "error": "MPV could not be started."}

    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        result = send_command(["get_property", "path"], wait_for_response=True, timeout=0.25)
        if result is not None:
            return {"ok": True}
        time.sleep(0.08)
    return {"ok": True, "message": "Starting player…"}


def shutil_which(name):
    from shutil import which
    return which(name)


def read_status():
    requests = {
        1: ["get_property", "path"],
        2: ["get_property", "media-title"],
        3: ["get_property", "duration"],
        4: ["get_property", "time-pos"],
        5: ["get_property", "pause"],
        6: ["get_property", "loop-file"],
        7: ["get_property", "metadata"]
    }
    client = open_ipc(timeout=0.25)
    if client is None:
        return {
            "running": False, "path": "", "title": "", "duration": 0,
            "time": 0, "paused": True, "error": ""
        }

    values = {}
    pending = bytearray()
    try:
        for request_id, command in requests.items():
            client.sendall((json.dumps({"command": command, "request_id": request_id}) + "\n").encode("utf-8"))
        import select
        deadline = time.monotonic() + 0.8
        while time.monotonic() < deadline and len(values) < len(requests):
            readable, _, _ = select.select([client], [], [], max(0, deadline - time.monotonic()))
            if not readable:
                break
            chunk = client.recv(8192)
            if not chunk:
                break
            pending.extend(chunk)
            while b"\n" in pending:
                raw_line, _, remainder = pending.partition(b"\n")
                pending = bytearray(remainder)
                try:
                    response = json.loads(raw_line.decode("utf-8", errors="replace"))
                except json.JSONDecodeError:
                    continue
                request_id = response.get("request_id")
                if request_id in requests and response.get("error") == "success":
                    values[request_id] = response.get("data")
    except (OSError, socket.timeout, ValueError):
        pass
    finally:
        client.close()

    path = values.get(1) or ""
    metadata = values.get(7) if isinstance(values.get(7), dict) else {}
    title = (metadata.get("title") or metadata.get("TITLE")
             or values.get(2) or (Path(path).stem if path else ""))
    artist = (metadata.get("artist") or metadata.get("ARTIST")
              or metadata.get("album_artist") or metadata.get("ALBUM_ARTIST") or "")
    album = metadata.get("album") or metadata.get("ALBUM") or ""
    try:
        duration = max(0.0, float(values.get(3) or 0))
    except (TypeError, ValueError):
        duration = 0.0
    try:
        position = max(0.0, float(values.get(4) or 0))
    except (TypeError, ValueError):
        position = 0.0
    return {
        "running": True,
        "path": path,
        "title": str(title),
        "artist": str(artist),
        "album": str(album),
        "cover": find_cover(Path(path), embedded=True) if path else "",
        "duration": duration,
        "time": position,
        "paused": bool(values.get(5, True)),
        "repeat": str(values.get(6) or "no") == "inf",
        "error": ""
    }


def main():
    args = sys.argv[1:]
    action = args[0] if args else "status"

    if action == "list":
        emit({
            "tracks": scan_library(),
            "directory": str(MUSIC_DIR),
            "directoryExists": MUSIC_DIR.is_dir()
        })
        return

    if action == "status":
        emit(read_status())
        return

    if action == "play":
        if len(args) < 2:
            emit({"ok": False, "error": "Choose a track first."})
            return
        emit(play_path(args[1]))
        return

    if action == "toggle":
        status = read_status()
        if not status.get("running") or not status.get("path"):
            emit({"ok": False, "error": "Choose a track to start playback."})
            return
        result = send_command(["set_property", "pause", not status.get("paused", True)], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "seek":
        if len(args) < 2:
            emit({"ok": False, "error": "A seek position is required."})
            return
        try:
            position = max(0.0, float(args[1]))
        except ValueError:
            emit({"ok": False, "error": "Invalid seek position."})
            return
        result = send_command(["seek", position, "absolute"], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "repeat":
        status = read_status()
        if not status.get("running") or not status.get("path"):
            emit({"ok": False, "error": "Choose a track first."})
            return
        command = ["set_property", "loop-file", "no" if status.get("repeat") else "inf"]
        result = send_command(command, wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "stop":
        result = send_command(["quit"], wait_for_response=False)
        emit({"ok": result is not None})
        return

    emit({"ok": False, "error": "Unknown music action."})
    sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        emit({"ok": False, "error": str(error)})
        sys.exit(1)
