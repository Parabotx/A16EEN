#!/usr/bin/env python3
"""A16EEN local music helper. Plays files from ~/Music through MPV's IPC socket."""
import fcntl
import hashlib
import json
import os
import socket
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

MUSIC_DIR = (Path.home() / "Music").resolve()
AUDIO_EXTENSIONS = {
    ".mp3", ".flac", ".ogg", ".opus", ".m4a", ".wav", ".aac",
    ".wma", ".aiff", ".aif", ".ape", ".mpc", ".mka", ".webm"
}
MPV_BIN = "mpv"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or (Path.home() / ".local/state/a16een"))
SOCKET_PATH = RUNTIME_DIR / "a16een-music.sock"
START_LOCK_PATH = RUNTIME_DIR / "a16een-music-start.lock"
PLAYER_PID_PATH = RUNTIME_DIR / "a16een-music.pid"
# Bundled WebP images and WebM loops are shipped with A16EEN; personal files
# remain in Pictures and are never removed by the installer.
BUILTIN_ELEMENTS_DIR = (
    Path.home() / ".config" / "a16een" / "quickshell" / "a16een" / "assets" / "music-elements"
)
USER_ELEMENTS_DIR = Path.home() / "Pictures" / "a16een" / "music-elements"
COVER_CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "a16een/music-covers"
MUSIC_ELEMENTS_CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "a16een/music-elements"
MAX_PREPARED_MUSIC_VIDEOS = 4
# Bump whenever the WebM alpha decoder/encoding path changes. The previous
# cache key only used source metadata, so opaque renders survived code fixes.
MUSIC_ELEMENTS_CACHE_VERSION = 2
COVER_NAMES = ("cover", "folder", "front", "album", "albumart", "albumartsmall", "artwork", ".folder", "thumb")


def emit(payload):
    print(json.dumps(payload, ensure_ascii=False))


def prepare_runtime():
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)


def find_sidecar_cover(path):
    candidates = []
    try:
        for item in path.parent.iterdir():
            if not item.is_file() or item.suffix.lower() not in {".jpg", ".jpeg", ".png", ".webp", ".avif"}:
                continue
            if item.stem.casefold() in COVER_NAMES:
                candidates.append(item)
        if not candidates:
            return ""
        candidates.sort(key=lambda item: (COVER_NAMES.index(item.stem.casefold()), item.name.casefold()))
        return candidates[0].as_uri()
    except OSError:
        return ""


def find_cover(path, embedded=False):
    """Find a nearby cover image, optionally extracting embedded artwork once."""
    sidecar = find_sidecar_cover(path)
    if sidecar or not embedded:
        return sidecar

    try:
        stat = path.stat()
        cache_key = hashlib.sha256(
            f"{path.resolve()}:{stat.st_size}:{stat.st_mtime_ns}".encode("utf-8")
        ).hexdigest()
        COVER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        cached_cover = COVER_CACHE_DIR / f"{cache_key}.jpg"
        missing_marker = COVER_CACHE_DIR / f"{cache_key}.missing"
        if cached_cover.is_file() and cached_cover.stat().st_size > 0:
            return cached_cover.as_uri()
        if missing_marker.exists() or not shutil_which("ffmpeg"):
            return ""

        try:
            result = subprocess.run(
                [
                    "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                    "-i", str(path), "-map", "0:v:0", "-frames:v", "1",
                    "-q:v", "3", str(cached_cover)
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=8,
                check=False
            )
        except (OSError, subprocess.TimeoutExpired):
            result = None

        if result is not None and result.returncode == 0 and cached_cover.is_file() and cached_cover.stat().st_size > 0:
            return cached_cover.as_uri()

        try:
            cached_cover.unlink(missing_ok=True)
            missing_marker.touch(exist_ok=True)
        except OSError:
            pass
    except OSError:
        return ""

    return ""


def scan_library():
    tracks = []
    if not MUSIC_DIR.is_dir():
        return tracks
    try:
        files = sorted(
            (p for p in MUSIC_DIR.rglob("*")
             if p.is_file() and p.suffix.lower() in AUDIO_EXTENSIONS),
            key=lambda p: str(p.relative_to(MUSIC_DIR)).casefold()
        )
    except OSError:
        return tracks

    cover_cache = {}
    for path in files:
        try:
            relative_parent = path.parent.relative_to(MUSIC_DIR)
            folder = relative_parent.as_posix() if str(relative_parent) != "." else "Local library"
            title = path.stem.replace("_", " ").strip()
            parent_key = str(path.parent)
            if parent_key not in cover_cache:
                cover_cache[parent_key] = find_cover(path)
            tracks.append({
                "path": str(path),
                "title": title or path.name,
                "artist": folder,
                "filename": path.name,
                "cover": cover_cache[parent_key]
            })
        except (OSError, ValueError):
            continue
    return tracks

def artwork_files(directory):
    """Find supported animated WebP and WebM artwork recursively."""
    try:
        return sorted(
            (path.resolve() for path in directory.rglob("*")
             if path.is_file() and path.suffix.casefold() in {".webp", ".webm"}),
            key=lambda path: str(path).casefold()
        )
    except OSError:
        return []


def scan_music_elements():
    """Return built-in and personal WebP/WebM artwork as local file URLs.

    WebP is rendered by Qt Quick's AnimatedImage; WebM is rendered by Qt
    Multimedia. Bundled assets are managed by the A16EEN installer. Personal
    assets live in Pictures and are never changed by updates. Subfolders work.
    """
    paths = artwork_files(BUILTIN_ELEMENTS_DIR) + artwork_files(USER_ELEMENTS_DIR)
    # Preserve source priority while removing duplicates (e.g. symlink aliases).
    unique_paths = list(dict.fromkeys(paths))

    return {
        "directory": str(USER_ELEMENTS_DIR),
        "builtInDirectory": str(BUILTIN_ELEMENTS_DIR),
        "elements": [path.as_uri() for path in unique_paths]
    }


def music_element_path(raw_source):
    """Resolve a WebM URL only if it belongs to A16EEN's known artwork folders."""
    try:
        parsed = urllib.parse.urlparse(str(raw_source))
        if parsed.scheme == "file":
            if parsed.netloc not in ("", "localhost"):
                return None
            candidate = Path(urllib.parse.unquote(parsed.path)).expanduser().resolve()
        elif not parsed.scheme:
            candidate = Path(str(raw_source)).expanduser().resolve()
        else:
            return None

        if candidate.suffix.casefold() != ".webm" or not candidate.is_file():
            return None

        for root in (BUILTIN_ELEMENTS_DIR.resolve(), USER_ELEMENTS_DIR.resolve()):
            try:
                candidate.relative_to(root)
                return candidate
            except ValueError:
                continue
    except (OSError, RuntimeError, ValueError):
        return None
    return None


def _prepared_video_path(source):
    stat = source.stat()
    key = hashlib.sha256(
        f"v{MUSIC_ELEMENTS_CACHE_VERSION}:{source}:{stat.st_size}:{stat.st_mtime_ns}".encode("utf-8")
    ).hexdigest()[:32]
    return MUSIC_ELEMENTS_CACHE_DIR / f"{key}.webp"


def alpha_aware_decoder_args(source):
    """Force libvpx to reconstruct VP8/VP9 WebM alpha side data before filtering."""
    if not shutil_which("ffprobe"):
        return []
    try:
        probe = subprocess.run(
            [
                "ffprobe", "-v", "error", "-select_streams", "v:0",
                "-show_entries", "stream=codec_name", "-of", "json", str(source)
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False
        )
        if probe.returncode != 0:
            return []
        streams = json.loads(probe.stdout).get("streams", [])
        codec = str(streams[0].get("codec_name", "")).lower() if streams else ""
        if codec == "vp9":
            return ["-c:v", "libvpx-vp9"]
        if codec == "vp8":
            return ["-c:v", "libvpx"]
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, TypeError, ValueError):
        pass
    return []


def prepare_music_elements(raw_sources):
    """Prepare up to four transparent, low-resolution animation caches from WebM files.

    Qt Multimedia can render some WebM alpha streams as an opaque rectangle on
    some backends. Re-encoding into animated WebP with an explicit RGBA filter
    preserves alpha while keeping WebM as the user's source format. Only the
    currently requested four-entry working set is kept on disk.
    """
    requested = []
    seen = set()
    for raw_source in raw_sources if isinstance(raw_sources, list) else []:
        source = music_element_path(raw_source)
        if source is None or source in seen:
            continue
        seen.add(source)
        requested.append((str(raw_source), source))
        if len(requested) >= MAX_PREPARED_MUSIC_VIDEOS:
            break

    MUSIC_ELEMENTS_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    lock_path = MUSIC_ELEMENTS_CACHE_DIR / ".prepare.lock"
    items = []
    errors = []

    with open(lock_path, "a", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        keep_paths = set()
        for source_url, source in requested:
            try:
                destination = _prepared_video_path(source)
                if not destination.is_file() or destination.stat().st_size == 0:
                    temporary = MUSIC_ELEMENTS_CACHE_DIR / (
                        f".{destination.stem}.{os.getpid()}.tmp.webp"
                    )
                    temporary.unlink(missing_ok=True)
                    if not shutil_which("ffmpeg"):
                        errors.append("ffmpeg is unavailable; transparent WebM preparation is disabled.")
                        continue

                    command = [
                        "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
                        *alpha_aware_decoder_args(source),
                        "-i", str(source),
                        "-map", "0:v:0", "-an", "-sn", "-dn",
                        "-vf",
                        "fps=12,scale=192:192:force_original_aspect_ratio=decrease:"
                        "force_divisible_by=2:flags=lanczos,format=rgba",
                        "-c:v", "libwebp_anim",
                        "-lossless", "0", "-quality", "82", "-compression_level", "4",
                        "-loop", "0", str(temporary)
                    ]
                    try:
                        result = subprocess.run(
                            command,
                            stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE,
                            text=True,
                            timeout=40,
                            check=False
                        )
                    except (OSError, subprocess.TimeoutExpired) as error:
                        result = None
                        errors.append(f"{source.name}: {error}")
                    if result is None or result.returncode != 0 or not temporary.is_file() or temporary.stat().st_size == 0:
                        if result is not None:
                            detail = (result.stderr or "").strip()
                            errors.append(f"{source.name}: {detail or 'ffmpeg could not encode this WebM.'}")
                        temporary.unlink(missing_ok=True)
                        continue
                    os.replace(temporary, destination)

                os.utime(destination, None)
                keep_paths.add(destination.resolve())
                items.append({
                    "source": source_url,
                    "prepared": destination.resolve().as_uri()
                })
            except (OSError, RuntimeError, ValueError) as error:
                errors.append(f"{source.name}: {error}")

        # This is a rotating working set, not a growing media library. Files
        # outside the selected queue are removed once the new queue is ready.
        for cached in MUSIC_ELEMENTS_CACHE_DIR.glob("*.webp"):
            try:
                if cached.resolve() not in keep_paths:
                    cached.unlink(missing_ok=True)
            except OSError:
                pass
        for temporary in MUSIC_ELEMENTS_CACHE_DIR.glob(".*.tmp.webp"):
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass

    return {
        "items": items,
        "cacheLimit": MAX_PREPARED_MUSIC_VIDEOS,
        "errors": errors
    }


def rectangle_intersects(first, second):
    """Return whether two logical-pixel rectangles overlap."""
    ax, ay, aw, ah = first
    bx, by, bw, bh = second
    return (
        aw > 0 and ah > 0 and bw > 0 and bh > 0
        and ax < bx + bw and bx < ax + aw
        and ay < by + bh and by < ay + ah
    )


def active_window_covers_region(windows, workspace_id, region):
    """Check visible window tile rectangles on the artwork's active workspace."""
    for window in windows if isinstance(windows, list) else []:
        if window.get("workspace_id") != workspace_id:
            continue
        layout = window.get("layout") or {}
        position = layout.get("tile_pos_in_workspace_view")
        size = layout.get("tile_size")
        if (
            isinstance(position, (list, tuple)) and len(position) == 2
            and isinstance(size, (list, tuple)) and len(size) == 2
        ):
            try:
                candidate = (
                    float(position[0]), float(position[1]),
                    float(size[0]), float(size[1])
                )
            except (TypeError, ValueError):
                continue
            if rectangle_intersects(region, candidate):
                return True
        elif window.get("is_focused"):
            # Some window types do not report a usable tile position. Pausing
            # conservatively for the focused window is preferable to burning
            # battery decoding artwork that may be completely covered.
            return True
    return False


def check_music_artwork_occlusion(output_name, global_region):
    """Fail open if Niri geometry is unavailable; otherwise detect covering windows."""
    def niri_json(subcommand):
        result = subprocess.run(
            ["niri", "msg", "--json", subcommand],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1.0,
            check=False
        )
        if result.returncode != 0:
            raise RuntimeError(f"niri msg {subcommand} failed")
        return json.loads(result.stdout)

    try:
        outputs = niri_json("outputs")
        workspaces = niri_json("workspaces")
        windows = niri_json("windows")

        if isinstance(outputs, list):
            output_pairs = [(output.get("name", ""), output) for output in outputs if isinstance(output, dict)]
        elif isinstance(outputs, dict):
            raw_outputs = outputs.get("outputs", outputs)
            output_pairs = [
                (name, data) for name, data in raw_outputs.items()
                if isinstance(data, dict)
            ] if isinstance(raw_outputs, dict) else []
        else:
            output_pairs = []

        target = next(
            (data for name, data in output_pairs if name == output_name or data.get("name") == output_name),
            None
        )
        logical = target.get("logical") if target else None
        if not isinstance(logical, dict):
            return False

        active_workspace = next(
            (
                workspace for workspace in workspaces if isinstance(workspace, dict)
                and workspace.get("output") == output_name
                and workspace.get("is_active")
            ),
            None
        ) if isinstance(workspaces, list) else None
        if active_workspace is None:
            return False

        # QQuickItem.mapToGlobal returns compositor-global logical coordinates.
        # Niri window tile coordinates are relative to this output's workspace view.
        local_region = (
            float(global_region[0]) - float(logical.get("x", 0)),
            float(global_region[1]) - float(logical.get("y", 0)),
            float(global_region[2]),
            float(global_region[3])
        )
        covered = active_window_covers_region(
            windows, active_workspace.get("id"), local_region
        )
        return covered
    except (OSError, RuntimeError, subprocess.TimeoutExpired, json.JSONDecodeError, TypeError, ValueError):
        # Missing IPC/geometry must never freeze the artwork or interrupt the shell.
        return False


def open_ipc(timeout=0.45):
    prepare_runtime()
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(SOCKET_PATH))
        return client
    except (OSError, socket.timeout):
        client.close()
        return None


def send_command(command, wait_for_response=False, timeout=0.65):
    client = open_ipc(timeout=timeout)
    if client is None:
        return None
    try:
        message = {"command": command, "request_id": 1}
        client.sendall((json.dumps(message) + "\n").encode("utf-8"))
        if not wait_for_response:
            return {"ok": True}
        stream = client.makefile("r", encoding="utf-8", errors="replace")
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                line = stream.readline()
            except (OSError, socket.timeout):
                break
            if not line:
                break
            try:
                response = json.loads(line)
            except json.JSONDecodeError:
                continue
            if response.get("request_id") == 1:
                return {
                    "ok": response.get("error") == "success",
                    "error": response.get("error", "")
                }
        return {"ok": True}
    except (OSError, socket.timeout):
        return None
    finally:
        client.close()


def stored_player_pid():
    """Return the PID of our MPV instance if it is still present in /proc."""
    try:
        pid = int(PLAYER_PID_PATH.read_text(encoding="utf-8").strip())
        if pid <= 1:
            return None
        command_line = Path(f"/proc/{pid}/cmdline").read_bytes()
        expected_socket = ("--input-ipc-server=" + str(SOCKET_PATH)).encode("utf-8")
        executable = command_line.partition(bytes((0,)))[0].lower()
        if b"mpv" in executable and expected_socket in command_line:
            return pid
    except (OSError, ValueError):
        pass

    try:
        PLAYER_PID_PATH.unlink(missing_ok=True)
    except OSError:
        pass
    return None


def play_path(raw_path):
    candidate = Path(raw_path).expanduser().resolve()
    try:
        candidate.relative_to(MUSIC_DIR)
    except ValueError:
        return {"ok": False, "error": "Choose a song from your Music folder."}
    if not candidate.is_file() or candidate.suffix.lower() not in AUDIO_EXTENSIONS:
        return {"ok": False, "error": "That audio file is no longer available."}

    command = ["loadfile", str(candidate), "replace"]
    result = send_command(command, wait_for_response=True)
    if result is not None:
        if result.get("ok"):
            return {"ok": True}
        return {"ok": False, "error": "MPV could not open that track."}

    if not shutil_which(MPV_BIN):
        return {"ok": False, "error": "MPV is missing. Update A16EEN to install it."}

    # The widget may exist on several screens, and rapid clicks can reach this
    # helper from separate Quickshell processes. Serialize startup and always
    # recheck the IPC socket inside the lock before launching another player.
    prepare_runtime()
    try:
        with open(START_LOCK_PATH, "a", encoding="utf-8") as startup_lock:
            fcntl.flock(startup_lock, fcntl.LOCK_EX)

            result = send_command(command, wait_for_response=True)
            if result is not None:
                if result.get("ok"):
                    return {"ok": True}
                return {"ok": False, "error": "MPV could not open that track."}

            # An MPV process may be alive but still initializing its IPC socket.
            # Wait for it rather than unlinking its socket and spawning a duplicate.
            existing_pid = stored_player_pid()
            if existing_pid is not None:
                deadline = time.monotonic() + 5.0
                while time.monotonic() < deadline:
                    result = send_command(["get_property", "path"],
                                          wait_for_response=True, timeout=0.25)
                    if result is not None:
                        loaded = send_command(command, wait_for_response=True)
                        if loaded is not None:
                            return ({"ok": True} if loaded.get("ok") else
                                    {"ok": False, "error": "MPV could not open that track."})
                    if stored_player_pid() != existing_pid:
                        break
                    time.sleep(0.08)
                if stored_player_pid() == existing_pid:
                    return {"ok": False, "error": "MPV is still starting. Try again in a moment."}

            try:
                SOCKET_PATH.unlink(missing_ok=True)
            except OSError:
                pass
            try:
                player = subprocess.Popen(
                    [
                        MPV_BIN, "--no-video", "--force-window=no", "--idle=yes",
                        "--input-ipc-server=" + str(SOCKET_PATH), "--", str(candidate)
                    ],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                    close_fds=True
                )
            except OSError:
                return {"ok": False, "error": "MPV could not be started."}

            try:
                PLAYER_PID_PATH.write_text(str(player.pid), encoding="utf-8")
            except OSError:
                pass

            deadline = time.monotonic() + 5.0
            while time.monotonic() < deadline:
                result = send_command(["get_property", "path"],
                                      wait_for_response=True, timeout=0.25)
                if result is not None:
                    return {"ok": True}
                time.sleep(0.08)

            # Keep the PID record so a subsequent request can wait on this same
            # process instead of opening a second invisible audio player.
            return {"ok": False, "error": "MPV is still starting. Try again in a moment."}
    except OSError:
        return {"ok": False, "error": "A16EEN could not coordinate music player startup."}


def shutil_which(name):
    from shutil import which
    return which(name)


def read_status():
    requests = {
        1: ["get_property", "path"],
        2: ["get_property", "media-title"],
        3: ["get_property", "duration"],
        4: ["get_property", "time-pos"],
        5: ["get_property", "pause"],
        6: ["get_property", "loop-file"],
        7: ["get_property", "metadata"],
        8: ["get_property", "loop-playlist"],
        9: ["get_property", "eof-reached"]
    }
    client = open_ipc(timeout=0.25)
    if client is None:
        return {
            "running": False, "path": "", "title": "", "duration": 0,
            "time": 0, "paused": True, "error": ""
        }

    values = {}
    pending = bytearray()
    try:
        for request_id, command in requests.items():
            client.sendall((json.dumps({"command": command, "request_id": request_id}) + "\n").encode("utf-8"))
        import select
        deadline = time.monotonic() + 0.8
        while time.monotonic() < deadline and len(values) < len(requests):
            readable, _, _ = select.select([client], [], [], max(0, deadline - time.monotonic()))
            if not readable:
                break
            chunk = client.recv(8192)
            if not chunk:
                break
            pending.extend(chunk)
            while b"\n" in pending:
                raw_line, _, remainder = pending.partition(b"\n")
                pending = bytearray(remainder)
                try:
                    response = json.loads(raw_line.decode("utf-8", errors="replace"))
                except json.JSONDecodeError:
                    continue
                request_id = response.get("request_id")
                if request_id in requests and response.get("error") == "success":
                    values[request_id] = response.get("data")
    except (OSError, socket.timeout, ValueError):
        pass
    finally:
        client.close()

    path = values.get(1) or ""
    metadata = values.get(7) if isinstance(values.get(7), dict) else {}
    title = (metadata.get("title") or metadata.get("TITLE")
             or values.get(2) or (Path(path).stem if path else ""))
    artist = (metadata.get("artist") or metadata.get("ARTIST")
              or metadata.get("album_artist") or metadata.get("ALBUM_ARTIST") or "")
    album = metadata.get("album") or metadata.get("ALBUM") or ""
    try:
        duration = max(0.0, float(values.get(3) or 0))
    except (TypeError, ValueError):
        duration = 0.0
    try:
        position = max(0.0, float(values.get(4) or 0))
    except (TypeError, ValueError):
        position = 0.0
    return {
        "running": True,
        "path": path,
        "title": str(title),
        "artist": str(artist),
        "album": str(album),
        "cover": find_cover(Path(path), embedded=True) if path else "",
        "duration": duration,
        "time": position,
        "paused": bool(values.get(5, True)),
        "repeat": str(values.get(6) or "no") == "inf",
        "loopPlaylist": str(values.get(8) or "no"),
        "eofReached": bool(values.get(9)),
        "error": ""
    }




def main():
    args = sys.argv[1:]
    action = args[0] if args else "status"

    if action == "list":
        emit({
            "tracks": scan_library(),
            "directory": str(MUSIC_DIR),
            "directoryExists": MUSIC_DIR.is_dir()
        })
        return

    if action == "elements":
        emit(scan_music_elements())
        return

    if action == "prepare-elements":
        try:
            raw_sources = json.loads(args[1]) if len(args) > 1 else []
        except json.JSONDecodeError:
            raw_sources = []
        emit(prepare_music_elements(raw_sources))
        return

    if action == "occlusion":
        if len(args) < 6:
            emit({"covered": False, "uncovered": True})
            return
        try:
            region = tuple(float(value) for value in args[1:5])
            output_name = args[5]
            covered = check_music_artwork_occlusion(output_name, region)
            emit({"covered": covered, "uncovered": not covered})
        except (TypeError, ValueError):
            emit({"covered": False, "uncovered": True})
        return

    if action == "status":
        emit(read_status())
        return

    if action == "play":
        if len(args) < 2:
            emit({"ok": False, "error": "Choose a track first."})
            return
        emit(play_path(args[1]))
        return

    if action == "toggle":
        status = read_status()
        if not status.get("running") or not status.get("path"):
            emit({"ok": False, "error": "Choose a track to start playback."})
            return
        result = send_command(["set_property", "pause", not status.get("paused", True)], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "pause":
        result = send_command(["set_property", "pause", True], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "seek":
        if len(args) < 2:
            emit({"ok": False, "error": "A seek position is required."})
            return
        try:
            position = max(0.0, float(args[1]))
        except ValueError:
            emit({"ok": False, "error": "Invalid seek position."})
            return
        result = send_command(["seek", position, "absolute"], wait_for_response=True)
        emit(result if result is not None else {"ok": False, "error": "The music player is not responding."})
        return

    if action == "repeat":
        # 0 = off, 1 = repeat current song, 2 = repeat the widget's full library.
        try:
            mode = int(args[1]) if len(args) > 1 else (0 if read_status().get("repeat") else 1)
        except (TypeError, ValueError):
            emit({"ok": False, "error": "Invalid repeat mode."})
            return
        if mode not in (0, 1, 2):
            emit({"ok": False, "error": "Invalid repeat mode."})
            return
        status = read_status()
        if not status.get("running"):
            emit({"ok": False, "error": "The music player is not running yet."})
            return
        file_loop = "inf" if mode == 1 else "no"
        first = send_command(["set_property", "loop-file", file_loop], wait_for_response=True)
        second = send_command(["set_property", "loop-playlist", "no"], wait_for_response=True)
        if first is None or second is None:
            emit({"ok": False, "error": "The music player is not responding."})
        elif not first.get("ok") or not second.get("ok"):
            emit({"ok": False, "error": "MPV could not change the repeat mode."})
        else:
            emit({"ok": True, "repeatMode": mode})
        return

    if action == "stop":
        result = send_command(["quit"], wait_for_response=False)
        emit({"ok": result is not None})
        return

    emit({"ok": False, "error": "Unknown music action."})
    sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        emit({"ok": False, "error": str(error)})
        sys.exit(1)
