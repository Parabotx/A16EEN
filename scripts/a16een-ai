    "explain": (
        "EXPLAIN MODE: Prioritize explaining what something means, how it works, and why it "
        "happens. Use clear steps, examples, and plain language rather than jumping directly "
        "to fixes. For questions about this computer, use relevant read-only tools when useful. "
        "Do not change settings or perform system actions unless the user explicitly asks you "
        "to make that change. Keep all existing confirmation requirements."
    ),
    "diagnose": (
        "DIAGNOSE MODE: Treat problem reports as an investigation, not a generic Q&A. Before "
        "suggesting a cause, gather evidence with the most relevant read-only tools: use "
        "run_system_diagnostics and get_system_status for broad system issues; diagnose_network "
        "for Wi-Fi/connectivity; get_desktop_context for workspace/window problems. Use more "
        "than one relevant tool when useful. Report confirmed observations separately from "
        "hypotheses, explain the most likely cause, and propose the smallest safe fix in order. "
        "Do not change anything unless the user explicitly asks for a repair. Never invent "
        "logs, facts, diagnoses, or tool results, and preserve confirmation gates for sensitive actions."
    ),
}


def schema(properties: dict[str, Any] | None = None, required: list[str] | None = None) -> dict[str, Any]:
    return {
        "type": "OBJECT",
        "properties": properties or {},
        "required": required or [],
    }

def prop(kind: str, description: str, **extra: Any) -> dict[str, Any]:
    out: dict[str, Any] = {"type": kind, "description": description}
    out.update(extra)
    return out

