TOOLS = [{"functionDeclarations": FUNCTIONS}]

def emit(value: dict[str, Any], code: int = 0) -> None:
    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")))
    raise SystemExit(code)

def read_json_stdin(max_bytes: int = MAX_PROMPT_CHARS * 4) -> dict[str, Any]:
    line = sys.stdin.readline(max_bytes + 1)
    if not line:
        return {}
    if len(line.encode("utf-8")) > max_bytes:
        raise ValueError("The request is too large.")
    value = json.loads(line)
    if not isinstance(value, dict):
        raise ValueError("Expected a JSON object.")
    return value

def provider_key_file(provider: str) -> Path:
    normalized = str(provider or "gemini").strip().lower()
    if normalized == "gemini":
        return KEY_FILE
    if normalized == "groq":
        return GROQ_KEY_FILE
    raise ValueError("Choose Google AI Studio (Gemini) or Groq.")

def get_provider() -> str:
    try:
        data = json.loads(PROVIDER_FILE.read_text(encoding="utf-8"))
        provider = str(data.get("provider", "gemini")).strip().lower() if isinstance(data, dict) else "gemini"
    except (OSError, ValueError, TypeError):
        provider = "gemini"
    return provider if provider in PROVIDERS else "gemini"

def write_private_file(path: Path, content: str, prefix: str) -> None:
    AI_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        AI_DIR.chmod(0o700)
    except OSError:
        pass
    fd, temporary = tempfile.mkstemp(prefix=prefix, dir=str(AI_DIR))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
            if not content.endswith("\n"):
                stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        temporary = ""
        try:
            path.chmod(0o600)
        except OSError:
            pass
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass

def save_provider(provider: str) -> dict[str, Any]:
    normalized = str(provider or "").strip().lower()
    if normalized not in PROVIDERS:
        raise ValueError("Choose Google AI Studio (Gemini) or Groq.")
    write_private_file(PROVIDER_FILE, json.dumps({"provider": normalized}), ".provider.")
    return {"ok": True, "provider": normalized, "message": "AI provider preference saved locally."}

def read_key(provider: str = "gemini") -> str:
    path = provider_key_file(provider)
    try:
        key = path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""
    return key if len(key) >= 10 else ""

def save_key_from_stdin(provider: str = "gemini") -> dict[str, Any]:
    normalized = str(provider or "gemini").strip().lower()
    path = provider_key_file(normalized)
    key = sys.stdin.readline(1024).strip()
    if len(key) < 10 or len(key) > 512 or any(ch.isspace() for ch in key):
        raise ValueError("Paste a valid " + ("Groq" if normalized == "groq" else "Gemini") + " API key without spaces or line breaks.")
    write_private_file(path, key, "." + normalized + "-api-key.")
    label = "Groq" if normalized == "groq" else "Gemini"
    return {"ok": True, "configured": True, "provider": normalized, "message": label + " API key saved locally."}

def remove_key(provider: str = "gemini") -> dict[str, Any]:
    normalized = str(provider or "gemini").strip().lower()
    path = provider_key_file(normalized)
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    label = "Groq" if normalized == "groq" else "Gemini"
    return {"ok": True, "configured": False, "provider": normalized, "message": label + " API key removed."}

class RequestTimeoutError(RuntimeError):
    """A request deadline or provider gateway timeout was reached."""


def send_json_request(
    request: urllib.request.Request,
    provider_label: str,
    timeout: int = REQUEST_TIMEOUT_SECONDS,
) -> dict[str, Any]:
    transient_codes = {408, 429, 500, 502, 503, 504}
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                raw = response.read(2 * 1024 * 1024 + 1)
            if len(raw) > 2 * 1024 * 1024:
                raise RuntimeError(provider_label + " returned an unexpectedly large response.")
            parsed = json.loads(raw.decode("utf-8"))
            if not isinstance(parsed, dict):
                raise RuntimeError(provider_label + " returned an invalid response.")
            return parsed
        except urllib.error.HTTPError as error:
            body_text = error.read(4000).decode("utf-8", errors="replace")
            try:
                detail = json.loads(body_text).get("error", {}).get("message", "")
            except Exception:
                detail = ""
            if error.code in transient_codes and attempt < 2:
                time.sleep(0.75 * (attempt + 1))
                continue
            if error.code in (401, 403):
                raise RuntimeError(provider_label + " rejected this API key. Recheck it in A16EEN AI settings.")
            if error.code == 429:
                raise RuntimeError(provider_label + " rate limit or quota reached. Check your provider dashboard and try again.")
            if error.code in (408, 500, 502, 503, 504):
                raise RequestTimeoutError(provider_label + " gateway timed out (HTTP " + str(error.code) + ").")
            raise RuntimeError(provider_label + " API error (" + str(error.code) + "): " + (detail or "request failed"))
        except urllib.error.URLError as error:
            if isinstance(error.reason, (TimeoutError, socket.timeout)):
                raise RequestTimeoutError(provider_label + " timed out after " + str(timeout) + " seconds. Your request was not lost.")
            raise RuntimeError("Could not reach " + provider_label + ". Check your internet connection: " + str(error.reason))
        except (TimeoutError, socket.timeout):
            raise RequestTimeoutError(provider_label + " timed out after " + str(timeout) + " seconds.")
        except json.JSONDecodeError:
            raise RuntimeError(provider_label + " returned unreadable JSON.")

def request_gemini(
    body: dict[str, Any],
    model: str | None = None,
    timeout: int = GEMINI_REQUEST_TIMEOUT_SECONDS,
) -> dict[str, Any]:
    key = read_key("gemini")
    if not key:
        raise RuntimeError("Add your Google AI Studio (Gemini) API key in A16EEN AI settings first.")
    model_id = str(model or MODEL)
    url = API_ROOT + urllib.parse.quote(model_id, safe="-._") + ":generateContent"
    request = urllib.request.Request(url, data=json.dumps(body).encode("utf-8"), headers={
        "Content-Type": "application/json", "x-goog-api-key": key, "User-Agent": "A16EEN-AI/1.0",
    }, method="POST")
    parsed = send_json_request(request, "Gemini", timeout=timeout)
    candidates = parsed.get("candidates") or []
    if not candidates or not isinstance(candidates[0].get("content"), dict):
        feedback = parsed.get("promptFeedback", {})
        reason = feedback.get("blockReason")
        raise RuntimeError("Gemini returned no response" + (": " + str(reason) if reason else "."))
    return candidates[0]["content"]


def request_gemini_with_fallback(body: dict[str, Any]) -> tuple[dict[str, Any], str]:
    try:
        return request_gemini(body), MODEL
    except RequestTimeoutError as primary_error:
        if not GEMINI_FALLBACK_MODEL or GEMINI_FALLBACK_MODEL == MODEL:
            raise RuntimeError(
                "Gemini did not respond within " + str(GEMINI_REQUEST_TIMEOUT_SECONDS)
                + " seconds. Try again or switch to Groq. (" + str(primary_error) + ")"
            )
        try:
            content = request_gemini(
                body,
                model=GEMINI_FALLBACK_MODEL,
                timeout=GEMINI_FALLBACK_TIMEOUT_SECONDS,
            )
            return content, GEMINI_FALLBACK_MODEL
        except RequestTimeoutError as fallback_error:
            raise RuntimeError(
                "Gemini timed out on both the fast and fallback models. Try Groq, then check "
                "your Google AI Studio quota and connection. (" + str(fallback_error) + ")"
            )

def lower_openai_schema(value: Any) -> Any:
    if isinstance(value, dict):
        return {key: (item.lower() if key == "type" and isinstance(item, str) else lower_openai_schema(item))
                for key, item in value.items()}
    if isinstance(value, list):
        return [lower_openai_schema(item) for item in value]
    return value

def groq_tool_definitions() -> list[dict[str, Any]]:
    return [{
        "type": "function",
        "function": {"name": item["name"], "description": item["description"],
                     "parameters": lower_openai_schema(item["parameters"])},
    } for item in FUNCTIONS]

def request_groq_completion(messages: list[dict[str, Any]], include_tools: bool = True) -> dict[str, Any]:
    key = read_key("groq")
    if not key:
        raise RuntimeError("Add your Groq API key in A16EEN AI settings first.")
    body: dict[str, Any] = {"model": GROQ_MODEL, "messages": messages, "max_completion_tokens": 1800}
    if include_tools:
        body["tools"] = groq_tool_definitions()
        body["tool_choice"] = "auto"
    request = urllib.request.Request(GROQ_API_URL, data=json.dumps(body).encode("utf-8"), headers={
        "Content-Type": "application/json", "Authorization": "Bearer " + key, "User-Agent": "A16EEN-AI/1.0",
    }, method="POST")
    parsed = send_json_request(request, "Groq")
    choices = parsed.get("choices") or []
    if not choices or not isinstance(choices[0].get("message"), dict):
        raise RuntimeError("Groq returned no message. Check the model and key in your Groq console.")
    return choices[0]["message"]

def validated_request(payload: dict[str, Any]) -> tuple[str, list[dict[str, Any]]]:
    raw_mode = payload.get("mode", "normal")
    if not isinstance(raw_mode, str):
        raise ValueError("Choose normal, explain, or diagnose mode.")
    mode = raw_mode.strip().lower()
    if mode not in MODE_INSTRUCTIONS:
        raise ValueError("Choose normal, explain, or diagnose mode.")
    history = payload.get("history", [])
    if not isinstance(history, list) or not history or len(history) > MAX_HISTORY_ITEMS:
        raise ValueError("Conversation history is missing or too long. Start a new chat.")
    cleaned: list[dict[str, Any]] = []
    for item in history:
        if not isinstance(item, dict) or item.get("role") not in ("user", "model"):
            raise ValueError("Conversation contains an invalid message.")
        parts = item.get("parts")
        if not isinstance(parts, list) or len(parts) > 24:
            raise ValueError("Conversation message contains invalid parts.")
        cleaned.append(item)
    return mode, cleaned

def groq_messages(history: list[dict[str, Any]], mode: str) -> list[dict[str, Any]]:
    messages: list[dict[str, Any]] = [{"role": "system", "content": SYSTEM_INSTRUCTION + "\n\n" + MODE_INSTRUCTIONS[mode]}]
    for item in history:
        role = "assistant" if item["role"] == "model" else "user"
        parts = item.get("parts", [])
        text_parts = [part.get("text", "") for part in parts if isinstance(part, dict) and isinstance(part.get("text"), str)]
        function_calls = [part.get("functionCall") for part in parts if isinstance(part, dict) and isinstance(part.get("functionCall"), dict)]
        function_responses = [part.get("functionResponse") for part in parts if isinstance(part, dict) and isinstance(part.get("functionResponse"), dict)]
        if role == "assistant":
            tool_calls = []
            for index, call in enumerate(function_calls):
                name, args = str(call.get("name", "")), call.get("args", {})
                if not name or not isinstance(args, dict):
                    continue
                call_id = str(call.get("id", "") or "").strip()
                if not call_id:
                    # Older Gemini history sometimes omitted function-call IDs.
                    # Keep that context readable instead of sending an invalid
                    # Groq tool_calls entry with no matching tool response.
                    text_parts.append("Previous desktop action request: " + name + " with arguments " + json.dumps(args, ensure_ascii=False) + ".")
                    continue
                tool_calls.append({"id": call_id, "type": "function", "function": {"name": name, "arguments": json.dumps(args, ensure_ascii=False)}})
            if text_parts or tool_calls:
                messages.append({"role": "assistant", "content": "\n".join(text_parts).strip() or None, **({"tool_calls": tool_calls} if tool_calls else {})})
        else:
            text_value = "\n".join(text_parts).strip()
            if text_value:
                messages.append({"role": "user", "content": text_value})
            for response in function_responses:
                name = str(response.get("name", "desktop_action"))
                content = json.dumps(response.get("response", {}), ensure_ascii=False)
                call_id = str(response.get("id", "") or "")
                if call_id:
                    messages.append({"role": "tool", "tool_call_id": call_id, "name": name, "content": content})
                else:
                    messages.append({"role": "user", "content": "Previous desktop action result (" + name + "): " + content})
    return messages

def ask_groq(payload: dict[str, Any]) -> dict[str, Any]:
    mode, history = validated_request(payload)
    message = request_groq_completion(groq_messages(history, mode), include_tools=True)
    parts: list[dict[str, Any]] = []
    calls: list[dict[str, Any]] = []
    text_value = message.get("content")
    if isinstance(text_value, str) and text_value.strip():
        parts.append({"text": text_value.strip()})
    for index, tool_call in enumerate(message.get("tool_calls") or []):
        if not isinstance(tool_call, dict):
            continue
        fn = tool_call.get("function") or {}
        name = str(fn.get("name", "")).strip()
        if not name:
            continue
        raw_args = fn.get("arguments", "{}")
        try:
            args = json.loads(raw_args) if isinstance(raw_args, str) else raw_args
        except json.JSONDecodeError:
            raise RuntimeError("Groq returned invalid arguments for a desktop action. Please rephrase and try again.")
        if not isinstance(args, dict):
            raise RuntimeError("Groq returned an invalid desktop action. Please try again.")
        call_id = str(tool_call.get("id", "") or ("a16een-call-" + str(index)))
        parts.append({"functionCall": {"name": name, "args": args, "id": call_id}})
        calls.append({"name": name, "args": args, "id": call_id})
    content = {"role": "model", "parts": parts}
    return {"ok": True, "provider": "groq", "model": GROQ_MODEL, "mode": mode, "content": content, "calls": calls,
            "text": "\n".join(part["text"] for part in parts if "text" in part).strip()}

def ask_ai(payload: dict[str, Any]) -> dict[str, Any]:
    provider = str(payload.get("provider") or get_provider()).strip().lower()
    if provider not in PROVIDERS:
        raise ValueError("Choose Google AI Studio (Gemini) or Groq.")
    result = ask_gemini(payload) if provider == "gemini" else ask_groq(payload)
    result["provider"] = provider
    result.setdefault("model", MODEL if provider == "gemini" else GROQ_MODEL)
    return result

def ask_gemini(payload: dict[str, Any]) -> dict[str, Any]:
    mode, cleaned = validated_request(payload)
    body = {
        "systemInstruction": {
            "parts": [{"text": SYSTEM_INSTRUCTION + "\n\n" + MODE_INSTRUCTIONS[mode]}]
        },
        "contents": cleaned,
        "tools": TOOLS,
        "toolConfig": {"functionCallingConfig": {"mode": "AUTO"}},
        "generationConfig": {"temperature": 0.2, "maxOutputTokens": 1200, "thinkingConfig": {"thinkingLevel": "LOW"}},
    }
    content, model_used = request_gemini_with_fallback(body)
    parts = content.get("parts") or []
    calls = []
    text_parts = []
    for part in parts:
        if isinstance(part, dict) and isinstance(part.get("text"), str):
            text_parts.append(part["text"])
        call = part.get("functionCall") if isinstance(part, dict) else None
        if isinstance(call, dict) and isinstance(call.get("name"), str):
            calls.append({
                "name": call["name"],
                "args": call.get("args") if isinstance(call.get("args"), dict) else {},
                "id": call.get("id", ""),
            })
    return {
        "ok": True,
        "provider": "gemini",
        "model": model_used,
        "mode": mode,
        "content": content,
        "calls": calls,
        "text": "\n".join(text_parts).strip(),
    }

def call_tool(name: str, args: dict[str, Any], approved: bool = False) -> dict[str, Any]:
    known = {item["name"] for item in FUNCTIONS}
    if name not in known:
        raise ValueError("This action is not available to A16EEN AI.")
    if name in CONFIRM_ACTIONS and not approved:
        return {"ok": False, "requires_confirmation": True, "error": "A16EEN requires the user to approve this action first."}
    if not isinstance(args, dict):
        raise ValueError("Action arguments must be an object.")

    def exact_args(allowed: set[str], required: set[str] = set()) -> None:
        unexpected = set(args) - allowed
        missing = required - set(args)
        if unexpected:
            raise ValueError("Unexpected action argument(s): " + ", ".join(sorted(unexpected)))
        if missing:
            raise ValueError("Missing required action argument(s): " + ", ".join(sorted(missing)))

    def run(argv: list[str], timeout: int = 12) -> str:
        try:
            result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
        except FileNotFoundError:
            raise RuntimeError("Required system tool is not installed: " + argv[0])
        except subprocess.TimeoutExpired:
            raise RuntimeError("The system action timed out: " + argv[0])
        output = (result.stdout or "").strip()
        errors = (result.stderr or "").strip()
        if result.returncode != 0:
            raise RuntimeError((errors or output or (argv[0] + " failed"))[:1600])
        return output[:16000]

    if name == "get_system_status":
        exact_args(set())
        snapshot: dict[str, Any] = {}
        try:
            raw = run(["a16een-system-monitor", "snapshot"], timeout=8)
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                snapshot.update(parsed)
        except Exception as error:
            snapshot["monitor_note"] = str(error)
        for label, argv in [
            ("power_profile", ["powerprofilesctl", "get"]),
            ("network_state", ["nmcli", "-t", "-f", "STATE", "general"]),
            ("audio_volume", ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]),
        ]:
            try:
                snapshot[label] = run(argv, timeout=5)
            except Exception as error:
                snapshot[label] = "unavailable: " + str(error)
        return {"ok": True, "result": snapshot}

    if name == "get_desktop_context":
        exact_args(set())
        raw_windows = json.loads(run(["niri", "msg", "--json", "windows"], timeout=8))
        raw_workspaces = json.loads(run(["niri", "msg", "--json", "workspaces"], timeout=8))
        windows = raw_windows.get("windows", []) if isinstance(raw_windows, dict) else raw_windows
        workspaces = raw_workspaces.get("workspaces", []) if isinstance(raw_workspaces, dict) else raw_workspaces
        if not isinstance(windows, list):
            windows = []
        if not isinstance(workspaces, list):
            workspaces = []
        safe_workspaces = []
        for workspace in workspaces[:30]:
            if not isinstance(workspace, dict):
                continue
            safe_workspaces.append({
                "id": workspace.get("id"),
                "index": workspace.get("idx", workspace.get("index")),
                "name": str(workspace.get("name") or workspace.get("idx") or workspace.get("index") or "")[:80],
                "focused": bool(workspace.get("is_focused", workspace.get("is_active", False))),
                "output": str(workspace.get("output") or "")[:80],
            })
        safe_windows = []
        for window in windows[:30]:
            if not isinstance(window, dict):
                continue
            safe_windows.append({
                "id": window.get("id"),
                "title": str(window.get("title") or "")[:180],
                "app_id": str(window.get("app_id") or "")[:120],
                "workspace_id": window.get("workspace_id"),
                "focused": bool(window.get("is_focused", False)),
                "floating": bool(window.get("is_floating", False)),
                "fullscreen": bool(window.get("is_fullscreen", False)),
            })
        focused = next((item for item in safe_windows if item["focused"]), None)
        focused_workspace = next((item for item in safe_workspaces if item["focused"]), None)
        return {"ok": True, "result": {
            "focused_window": focused,
            "active_workspace": focused_workspace,
            "workspaces": safe_workspaces,
            "open_windows": safe_windows,
            "open_window_count": len(windows),
        }}

    if name == "diagnose_network":
        exact_args(set())
        data: dict[str, Any] = {}
        for label, argv in [
            ("connectivity", ["nmcli", "general", "status"]),
            ("devices", ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"]),
            ("wifi_radio", ["nmcli", "radio", "wifi"]),
        ]:
            try:
                data[label] = run(argv, timeout=8)
            except Exception as error:
                data[label] = "unavailable: " + str(error)
        return {"ok": True, "result": data}

    if name == "run_system_diagnostics":
        exact_args(set())
        try:
            diagnostic = subprocess.run(
                ["a16een-doctor"], capture_output=True, text=True, timeout=35, check=False
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise RuntimeError("Could not run A16EEN diagnostics: " + str(error))
        report = (diagnostic.stdout or "").strip()
        if diagnostic.stderr:
            report += "\n" + diagnostic.stderr.strip()
        return {
            "ok": True,
            "result": report[:14000] or "The diagnostic tool returned no report.",
            "exit_code": diagnostic.returncode,
        }

    if name in ("get_current_wallpaper", "list_wallpapers", "random_wallpaper", "next_wallpaper"):
        exact_args(set())
        entries = wallpaper_catalog()
        current = next((entry for entry in entries if entry.get("selected")), None)
        if name == "get_current_wallpaper":
            if current:
                return {"ok": True, "result": {key: current[key] for key in ("source", "filename", "display_name", "type")}}
            return {"ok": True, "result": {"source": "", "filename": "", "display_name": "Unknown wallpaper"}}
        if name == "list_wallpapers":
            selectable = [entry for entry in entries if entry["source"] != "external"]
            return {"ok": True, "result": [{key: entry[key] for key in ("source", "filename", "display_name", "type")} for entry in selectable[:100]]}
        if name == "next_wallpaper":
            return {"ok": True, "result": run(["a16een-wallpaper", "next"])}
        candidates = [entry for entry in entries if entry["source"] in ("builtin", "custom", "builtin-animated", "custom-animated")]
        if current and len(candidates) > 1:
            without_current = [entry for entry in candidates if not (entry["source"] == current["source"] and entry["filename"] == current["filename"])]
            if without_current:
                candidates = without_current
        if not candidates:
            raise RuntimeError("No selectable A16EEN wallpapers were found.")
        chosen = random.choice(candidates)
        result = run(["a16een-wallpaper", "set", chosen["source"], chosen["filename"]])
        return {"ok": True, "result": result or ("Wallpaper set to " + chosen["filename"] + ".")}

    if name == "set_wallpaper":
        exact_args({"filename", "source"}, {"filename"})
        filename = str(args["filename"]).strip()
        if not filename or len(filename) > 180 or "/" in filename or "\\" in filename or filename in (".", "..") or any(ord(c) < 32 for c in filename):
            raise ValueError("Use an exact filename from list_wallpapers.")
        available = call_tool("list_wallpapers", {})
        entries = available.get("result", [])
        matches = [entry for entry in entries if entry["filename"] == filename]
        if "source" in args:
            source = str(args["source"])
            matches = [entry for entry in matches if entry["source"] == source]
        if not matches:
            raise ValueError("That wallpaper is not in the available wallpaper list. Call list_wallpapers first.")
        if len(matches) > 1:
            raise ValueError("That filename exists in more than one collection. Supply the source from list_wallpapers.")
        entry = matches[0]
        return {"ok": True, "result": run(["a16een-wallpaper", "set", entry["source"], entry["filename"]])}

    if name == "list_applications":
        exact_args({"query"})
        query = str(args.get("query", "")).strip().lower()
        if len(query) > 100:
            raise ValueError("Application search is too long.")
        apps = application_catalog()
        if query:
            apps = [app for app in apps if query in app["name"].lower() or query in app["desktop_id"].lower()]
        return {"ok": True, "result": [{"name": app["name"], "desktop_id": app["desktop_id"]} for app in apps[:50]]}

    if name == "open_application":
        exact_args({"query"}, {"query"})
        query = str(args["query"]).strip().lower()
        if not query or len(query) > 100:
            raise ValueError("Enter an application name.")
        apps = application_catalog()
        exact = [app for app in apps if query in (app["name"].lower(), app["desktop_id"].lower(), app["desktop_id"].removesuffix(".desktop").lower())]
        matches = exact or [app for app in apps if query in app["name"].lower() or query in app["desktop_id"].lower()]
        if not matches:
            raise ValueError("No installed desktop application matched '" + str(args["query"])[:80] + "'. Try list_applications.")
        if len(matches) > 1:
            names = ", ".join(app["name"] for app in matches[:8])
            raise ValueError("More than one app matched: " + names + ". Use a more specific name.")
        app = matches[0]
        app_id = app["desktop_id"][:-8] if app["desktop_id"].endswith(".desktop") else app["desktop_id"]
        if shutil.which("gtk-launch"):
            run(["gtk-launch", app_id], timeout=8)
        elif shutil.which("gio"):
            run(["gio", "launch", app["desktop_path"]], timeout=8)
        else:
            raise RuntimeError("Neither gtk-launch nor gio is available to launch desktop applications.")
        return {"ok": True, "result": "Launched " + app["name"] + "."}

    if name == "focus_workspace":
        exact_args({"workspace"}, {"workspace"})
        workspace = str(args["workspace"]).strip()
        if not re.fullmatch(r"(?:[1-9][0-9]?|[A-Za-z][A-Za-z0-9 _-]{0,39})", workspace):
            raise ValueError("Use a workspace number from 1–99 or a simple workspace name.")
        return {"ok": True, "result": run(["niri", "msg", "action", "focus-workspace", workspace]) or "Workspace focus requested."}

    if name == "move_focused_column_to_workspace":
        exact_args({"workspace"}, {"workspace"})
        target = str(args["workspace"]).strip()
        if not re.fullmatch(r"(?:[1-9][0-9]?|[A-Za-z][A-Za-z0-9 _-]{0,39})", target):
            raise ValueError("Use a simple workspace name or index from get_desktop_context.")
        context = call_tool("get_desktop_context", {})
        available = context.get("result", {}).get("workspaces", [])
        match = next((item for item in available
                      if target in (str(item.get("name", "")), str(item.get("index", "")), str(item.get("id", "")))), None)
        if not match:
            raise ValueError("That workspace isn't currently available. Call get_desktop_context to see existing workspaces.")
        return {"ok": True, "result": run(["niri", "msg", "action", "move-column-to-workspace", target]) or ("Moved the focused column to " + str(match.get("name") or target) + ".")}

    if name in ("toggle_fullscreen", "toggle_floating", "maximize_focused_column", "center_focused_column"):
        exact_args(set())
        commands = {
            "toggle_fullscreen": ["a16", "fullscreen"],
            "toggle_floating": ["a16", "float"],
            "maximize_focused_column": ["a16", "maximize"],
            "center_focused_column": ["a16", "center"],
        }
        result = run(commands[name])
        return {"ok": True, "result": result or {
            "toggle_fullscreen": "Fullscreen toggled.",
            "toggle_floating": "Floating state toggled.",
            "maximize_focused_column": "Focused column maximized.",
            "center_focused_column": "Focused column centered.",
        }[name]}

    if name == "set_volume":
        exact_args({"percent"}, {"percent"})
        percent = float(args["percent"])
        if not 0 <= percent <= 100:
            raise ValueError("Volume must be between 0 and 100.")
        return {"ok": True, "result": run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(round(percent, 1)) + "%"]) or ("Volume set to " + str(round(percent, 1)) + "%.")}

    if name == "set_brightness":
        exact_args({"percent"}, {"percent"})
        percent = float(args["percent"])
        if not 0 <= percent <= 100:
            raise ValueError("Brightness must be between 0 and 100.")
        return {"ok": True, "result": run(["brightnessctl", "set", str(round(percent, 1)) + "%"]) or ("Brightness set to " + str(round(percent, 1)) + "%.")}

    if name == "mute_audio":
        exact_args({"muted"}, {"muted"})
        if not isinstance(args["muted"], bool):
            raise ValueError("muted must be true or false.")
        return {"ok": True, "result": run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if args["muted"] else "0"]) or ("Audio " + ("muted." if args["muted"] else "unmuted."))}

    if name == "set_power_profile":
        exact_args({"profile"}, {"profile"})
        profile = str(args["profile"])
        if profile not in ("balanced", "power-saver", "performance"):
            raise ValueError("Choose balanced, power-saver, or performance.")
        return {"ok": True, "result": run(["powerprofilesctl", "set", profile]) or ("Power profile set to " + profile + ".")}

    if name == "restart_a16een_shell":
        exact_args(set())
        return {"ok": True, "result": run(["a16", "-r"]) or "A16EEN shell restart requested."}

    if name == "lock_screen":
        exact_args(set())
        if not shutil.which("a16"):
            raise RuntimeError("The A16EEN command is unavailable.")
        try:
            subprocess.Popen(
                ["a16", "lock"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
            )
        except OSError as error:
            raise RuntimeError("Could not start the A16EEN lock screen: " + str(error))
        return {"ok": True, "result": "A16EEN lock screen requested."}

    if name == "open_website":
        exact_args({"url"}, {"url"})
        url = str(args["url"]).strip()
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username or parsed.password or len(url) > 2048:
            raise ValueError("Only a full http:// or https:// website URL is allowed.")
        return {"ok": True, "result": run(["xdg-open", url], timeout=8) or "Opened the website in the default browser."}

    if name == "close_active_window":
        exact_args(set())
        return {"ok": True, "result": run(["niri", "msg", "action", "close-window"]) or "Close-window action sent to Niri."}

    if name == "logout_session":
        exact_args(set())
        return {"ok": True, "result": run(["niri", "msg", "action", "quit"]) or "Logout requested."}

    if name == "suspend_system":
        exact_args(set())
        return {"ok": True, "result": run(["systemctl", "suspend"], timeout=8) or "Suspend requested."}

    if name == "reboot_system":
        exact_args(set())
        return {"ok": True, "result": run(["systemctl", "reboot"], timeout=8) or "Reboot requested."}

    if name == "power_off_system":
        exact_args(set())
        return {"ok": True, "result": run(["systemctl", "poweroff"], timeout=8) or "Power-off requested."}

    raise ValueError("This action is not available to A16EEN AI.")

def wallpaper_catalog() -> list[dict[str, Any]]:
    """Read the local wallpaper catalog but never return full file paths to Gemini."""
    try:
        result = subprocess.run(
            ["a16een-wallpaper", "catalog"],
            capture_output=True, text=True, timeout=8, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError("Could not read the A16EEN wallpaper catalog: " + str(error))
    if result.returncode != 0:
        raise RuntimeError((result.stderr or "Could not read wallpapers.")[:800])
    entries: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for line in result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 6:
            continue
        source, filename, display, path, selected, media_type = parts[:6]
        # External single-file wallpapers have arbitrary paths and are not part
        # of the managed collections. Keep their basename private and don't offer
        # them as an action target.
        if source == "external":
            filename = Path(filename).name
        key = (source, filename)
        if key in seen:
            continue
        seen.add(key)
        if not filename or "/" in filename or "\\" in filename or any(ord(c) < 32 for c in filename):
            continue
        entries.append({
            "source": source,
            "filename": filename,
            "display_name": display,
            "type": media_type,
            "selected": selected == "1",
        })
    return entries


def application_catalog() -> list[dict[str, str]]:
    data_home = Path(os.environ.get("XDG_DATA_HOME", str(HOME / ".local/share")))
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    roots = [data_home / "applications"] + [Path(item) / "applications" for item in data_dirs if item]
    out: list[dict[str, str]] = []
    seen: set[str] = set()
    for root in roots:
        if not root.is_dir():
            continue
        try:
            entries = root.rglob("*.desktop")
            for path in entries:
                try:
                    relative = path.relative_to(root).as_posix()
                    desktop_id = relative.replace("/", "-")
                    if desktop_id in seen or path.is_symlink():
                        continue
                    seen.add(desktop_id)
                    text = path.read_text(encoding="utf-8", errors="replace")[:30000]
                except OSError:
                    continue
                section = ""
                fields: dict[str, str] = {}
                for line in text.splitlines():
                    if line.startswith("["):
                        section = line.strip()
                        continue
                    if section == "[Desktop Entry]" and "=" in line:
                        key, value = line.split("=", 1)
                        if "[" not in key:
                            fields[key] = value
                if fields.get("Type", "Application") != "Application":
                    continue
                if fields.get("Hidden", "false").lower() == "true" or fields.get("NoDisplay", "false").lower() == "true":
                    continue
                title = fields.get("Name", "").strip()
                if title:
                    out.append({"name": title[:120], "desktop_id": desktop_id, "desktop_path": str(path)})
                if len(out) >= 700:
                    return sorted(out, key=lambda item: item["name"].casefold())
        except OSError:
            continue
    return sorted(out, key=lambda item: item["name"].casefold())

def run_test(provider: str | None = None) -> dict[str, Any]:
    selected = str(provider or get_provider()).strip().lower()
    if selected not in PROVIDERS:
        raise ValueError("Choose Google AI Studio (Gemini) or Groq.")
    if selected == "gemini":
        content, model = request_gemini_with_fallback({
            "contents": [{"role": "user", "parts": [{"text": "Reply with exactly: A16EEN connected"}]}],
            "generationConfig": {"temperature": 0, "maxOutputTokens": 24},
        })
        text_parts = [part.get("text", "") for part in content.get("parts", []) if isinstance(part, dict)]
        answer, label = " ".join(text_parts).strip(), "Gemini"
    else:
        message = request_groq_completion([
            {"role": "system", "content": "Reply with exactly: A16EEN connected"},
            {"role": "user", "content": "Reply with exactly: A16EEN connected"},
        ], include_tools=False)
        answer, model, label = str(message.get("content") or "").strip(), GROQ_MODEL, "Groq"
    return {"ok": True, "configured": True, "provider": selected, "model": model,
            "message": "Connected to " + label + " (" + model + ").", "reply": answer[:100]}

def empty_history_store() -> dict[str, Any]:
    return {"active_id": "", "conversations": []}


def safe_conversation_id(value: Any) -> str:
    result = str(value or "")
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,80}", result):
        raise ValueError("Invalid conversation ID.")
    return result


def ensure_history_directory() -> None:
    AI_STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        AI_STATE_DIR.chmod(0o700)
    except OSError:
        pass


def load_history_store() -> dict[str, Any]:
    ensure_history_directory()
    try:
        if CONVERSATIONS_FILE.stat().st_size > MAX_STORED_JSON_BYTES:
            raise RuntimeError("Saved AI conversation history is too large; it was not changed.")
        raw = CONVERSATIONS_FILE.read_text(encoding="utf-8")
    except FileNotFoundError:
        return empty_history_store()
    except OSError as error:
        raise RuntimeError("Could not read local AI conversation history: " + str(error))
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        raise RuntimeError("Saved AI conversation history is invalid; the file was not overwritten.")
    if not isinstance(parsed, dict) or not isinstance(parsed.get("conversations", []), list):
        raise RuntimeError("Saved AI conversation history has an invalid structure.")

    conversations: list[dict[str, Any]] = []
    for item in parsed.get("conversations", [])[:MAX_STORED_CONVERSATIONS * 2]:
        if not isinstance(item, dict):
            continue
        try:
            conversation_id = safe_conversation_id(item.get("id"))
        except ValueError:
            continue
        title, mode = item.get("title", "New chat"), item.get("mode", "normal")
        history, messages = item.get("history", []), item.get("messages", [])
        if not isinstance(title, str) or not isinstance(mode, str) or mode not in MODE_INSTRUCTIONS:
            continue
        if not isinstance(history, list) or not isinstance(messages, list):
            continue
        safe_history: list[dict[str, Any]] = []
        for entry in history[-MAX_HISTORY_ITEMS:]:
            if not isinstance(entry, dict) or entry.get("role") not in ("user", "model"):
                continue
            parts = entry.get("parts")
            if not isinstance(parts, list) or len(parts) > 24:
                continue
            try:
                if len(json.dumps(entry, ensure_ascii=False).encode("utf-8")) > 160_000:
                    continue
            except (TypeError, ValueError):
                continue
            safe_history.append(entry)
        safe_messages: list[dict[str, str]] = []
        for message in messages[-MAX_STORED_MESSAGES:]:
            if not isinstance(message, dict) or message.get("speaker") not in ("user", "assistant"):
                continue
            body = message.get("body")
            if isinstance(body, str):
                safe_messages.append({"speaker": message["speaker"], "body": body[:6000]})
        try:
            updated_at = float(item.get("updated_at", 0))
        except (TypeError, ValueError):
            updated_at = 0.0
        conversations.append({
            "id": conversation_id, "title": title[:100], "mode": mode,
            "history": safe_history, "messages": safe_messages, "updated_at": updated_at,
        })

    conversations.sort(key=lambda item: item["updated_at"], reverse=True)
    conversations = conversations[:MAX_STORED_CONVERSATIONS]
    valid_ids = {item["id"] for item in conversations}
    active_id = str(parsed.get("active_id", ""))
    if active_id not in valid_ids:
        active_id = conversations[0]["id"] if conversations else ""
    try:
        CONVERSATIONS_FILE.chmod(0o600)
    except OSError:
        pass
    return {"active_id": active_id, "conversations": conversations}


def save_conversation_from_stdin() -> dict[str, Any]:
    payload = read_json_stdin(MAX_STORED_JSON_BYTES)
    conversation_id = safe_conversation_id(payload.get("id"))
    title, mode = payload.get("title", "New chat"), payload.get("mode", "normal")
    history, messages = payload.get("history", []), payload.get("messages", [])
    if not isinstance(title, str) or not isinstance(mode, str) or mode not in MODE_INSTRUCTIONS:
        raise ValueError("Conversation title or response mode is invalid.")
    if not isinstance(history, list) or len(history) > MAX_HISTORY_ITEMS:
        raise ValueError("Conversation context is too large to save.")
    if not isinstance(messages, list) or len(messages) > MAX_STORED_MESSAGES:
        raise ValueError("Conversation message list is too large to save.")

    safe_history: list[dict[str, Any]] = []
    for entry in history:
        if not isinstance(entry, dict) or entry.get("role") not in ("user", "model"):
            raise ValueError("Conversation context contains an invalid message.")
        parts = entry.get("parts")
        if not isinstance(parts, list) or len(parts) > 24:
            raise ValueError("Conversation context contains invalid parts.")
        try:
            encoded_size = len(json.dumps(entry, ensure_ascii=False).encode("utf-8"))
        except (TypeError, ValueError):
            raise ValueError("Conversation context cannot be serialized.")
        if encoded_size > 160_000:
            raise ValueError("A saved conversation message is too large.")
        safe_history.append(entry)

    safe_messages: list[dict[str, str]] = []
    for message in messages:
        if not isinstance(message, dict) or message.get("speaker") not in ("user", "assistant"):
            raise ValueError("Conversation transcript contains an invalid message.")
        body = message.get("body")
        if not isinstance(body, str):
            raise ValueError("Conversation transcript contains an invalid message body.")
        safe_messages.append({"speaker": message["speaker"], "body": body[:6000]})

    try:
        updated_at = float(payload.get("updated_at", time.time()))
    except (TypeError, ValueError):
        updated_at = time.time()
    if updated_at <= 0:
        updated_at = time.time()

    ensure_history_directory()
    store = load_history_store()
    conversation = {
        "id": conversation_id, "title": title.strip()[:100] or "New chat", "mode": mode,
        "history": safe_history[-MAX_HISTORY_ITEMS:], "messages": safe_messages[-MAX_STORED_MESSAGES:],
        "updated_at": updated_at,
    }
    conversations = [item for item in store["conversations"] if item["id"] != conversation_id]
    conversations.append(conversation)
    conversations.sort(key=lambda item: item["updated_at"], reverse=True)
    conversations = conversations[:MAX_STORED_CONVERSATIONS]
    active_id = conversation_id if any(item["id"] == conversation_id for item in conversations) else (
        conversations[0]["id"] if conversations else ""
    )
    updated = {"active_id": active_id, "conversations": conversations}

    temporary = ""
    try:
        fd, temporary = tempfile.mkstemp(prefix=".conversations.", dir=str(AI_STATE_DIR))
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(updated, output, ensure_ascii=False, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, CONVERSATIONS_FILE)
        temporary = ""
        try:
            CONVERSATIONS_FILE.chmod(0o600)
            AI_STATE_DIR.chmod(0o700)
        except OSError:
            pass
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass
    return {"ok": True, "active_id": updated["active_id"], "conversations": updated["conversations"]}


def delete_saved_conversation(conversation_id: str) -> dict[str, Any]:
    conversation_id = safe_conversation_id(conversation_id)
    store = load_history_store()
    conversations = [item for item in store["conversations"] if item["id"] != conversation_id]
    active_id = store["active_id"]
    if active_id == conversation_id:
        active_id = conversations[0]["id"] if conversations else ""
    ensure_history_directory()
    temporary = ""
    try:
        fd, temporary = tempfile.mkstemp(prefix=".conversations.", dir=str(AI_STATE_DIR))
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump({"active_id": active_id, "conversations": conversations}, output, ensure_ascii=False, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, CONVERSATIONS_FILE)
        temporary = ""
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass
    return {"ok": True, "active_id": active_id, "conversations": conversations}


def main() -> None:
    args = sys.argv[1:]
    try:
        if args == ["status"]:
            provider = get_provider()
            gemini_configured = bool(read_key("gemini"))
            groq_configured = bool(read_key("groq"))
            emit({
                "ok": True, "provider": provider,
                "configured": groq_configured if provider == "groq" else gemini_configured,
                "gemini_configured": gemini_configured, "groq_configured": groq_configured,
                "model": GROQ_MODEL if provider == "groq" else MODEL,
            })
        if len(args) == 3 and args[:2] == ["provider", "set"]:
            emit(save_provider(args[2]))
        if args == ["provider", "get"]:
            emit({"ok": True, "provider": get_provider()})
        if args[:2] == ["key", "set-stdin"] and len(args) in (2, 3):
            emit(save_key_from_stdin(args[2] if len(args) == 3 else "gemini"))
        if args[:2] == ["key", "remove"] and len(args) in (2, 3):
            emit(remove_key(args[2] if len(args) == 3 else "gemini"))
        if args == ["history", "list"]:
            store = load_history_store()
            emit({"ok": True, "active_id": store["active_id"], "conversations": store["conversations"]})
        if args == ["history", "save-stdin"]:
            emit(save_conversation_from_stdin())
        if len(args) == 3 and args[:2] == ["history", "delete"]:
            emit(delete_saved_conversation(args[2]))
        if args == ["tools"]:
            emit({"ok": True, "actions": [{"name": item["name"], "requires_confirmation": item["name"] in CONFIRM_ACTIONS} for item in FUNCTIONS]})
        if args == ["test"] or (len(args) == 2 and args[0] == "test"):
            emit(run_test(args[1] if len(args) == 2 else None))
        if args == ["ask"]:
            payload = read_json_stdin()
            payload.setdefault("provider", get_provider())
            emit(ask_ai(payload))
        if args == ["execute"]:
            payload = read_json_stdin()
            name = str(payload.get("name", ""))
            action_args = payload.get("args", {})
            approved = payload.get("approved") is True
            emit(call_tool(name, action_args, approved))
        emit({"ok": False, "error": "Unknown command. Use status, provider get|set <gemini|groq>, key set-stdin [gemini|groq], key remove [gemini|groq], history list, history save-stdin, history delete <id>, test, ask, execute, or tools."}, 2)
    except SystemExit:
        raise
    except Exception as error:
        emit({"ok": False, "error": str(error)[:1500]}, 1)

if __name__ == "__main__":
    main()
