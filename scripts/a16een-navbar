#!/usr/bin/env bash
set -euo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
readonly SETTINGS_FILE="$STATE_DIR/navbar.json"
readonly APPEARANCE_FILE="$STATE_DIR/navbar-appearance.json"
readonly ICON_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/a16een/quickshell/a16een/assets/icons"
readonly OUTPUT_DIR="$STATE_DIR/navbar-icons"
readonly ICON_REPAIR_MARKER="$STATE_DIR/navbar-icon-repair-v1"

readonly REGISTRY_FILE="$STATE_DIR/workspaces.json"

declare -Ar DEFAULT_COLOR=(
    [home]="#111318"
    [code]="#111318"
    [web]="#111318"
    [comms]="#111318"
    [studio]="#111318"
    [music]="#111318"
    [games]="#111318"
    [files]="#111318"
    [lab]="#111318"
)

ensure_registry() {
    [[ -s "$REGISTRY_FILE" ]] || /usr/local/bin/a16een-workspaces apply >/dev/null 2>&1 || true
    [[ -s "$REGISTRY_FILE" ]] || {
        echo "A16EEN navbar: workspace registry is missing: $REGISTRY_FILE" >&2
        return 1
    }
    jq empty "$REGISTRY_FILE" >/dev/null 2>&1 || {
        echo "A16EEN navbar: workspace registry is invalid." >&2
        return 1
    }
}

workspace_ids() {
    jq -r '.[].id' "$REGISTRY_FILE"
}

is_known_slot() {
    local candidate="$1"
    jq -e --arg id "$candidate" ".[] | select(.id == \$id)" "$REGISTRY_FILE" >/dev/null 2>&1
}

is_active_slot() {
    is_known_slot "$1"
}

active_count() {
    ensure_registry
    jq 'length' "$REGISTRY_FILE"
}

prune_inactive_slots() {
    ensure_registry
    mkdir -p "$STATE_DIR" "$OUTPUT_DIR"

    local slot tmp
    for slot in "$OUTPUT_DIR"/*.svg; do
        [[ -e "$slot" ]] || continue
        slot="$(basename "$slot" .svg)"
        if ! is_known_slot "$slot"; then
            rm -f "$OUTPUT_DIR/$slot.svg"
            [[ -s "$SETTINGS_FILE" ]] || continue
            tmp="$(mktemp "$STATE_DIR/navbar.json.XXXXXX")"
            jq --arg slot "$slot" 'del(.[$slot])' "$SETTINGS_FILE" > "$tmp"
            mv -f "$tmp" "$SETTINGS_FILE"
        fi
    done
}

normalize_style() {
    local value="${1:-}"

    if [[ "$value" =~ ^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$ ]]; then
        printf 'solid:%s' "$value"
        return
    fi

    if [[ "$value" =~ ^solid:#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$ ]] ||
       [[ "$value" =~ ^(split-x|split-y|gradient-x|gradient-y|gradient-diag):#[0-9A-Fa-f]{6}:#[0-9A-Fa-f]{6}$ ]]; then
        printf '%s' "$value"
    fi
}

repair_all_white_styles() {
    # Normalize every supported all-white style before generating an SVG.
    # This includes legacy 8-digit white colors and split/gradient designs.
    local slot style normalized tmp changed=0

    while IFS= read -r slot; do
        [[ -n "$slot" ]] || continue

        style="$(jq -r --arg slot "$slot" '.[$slot].color // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
        normalized="$(printf '%s' "$style" | tr '[:lower:]' '[:upper:]')"

        case "$normalized" in
            "#FFFFFF"|"#FFFFFFFF"|"SOLID:#FFFFFF"|"SOLID:#FFFFFFFF"|"SPLIT-X:#FFFFFF:#FFFFFF"|"SPLIT-X:#FFFFFFFF:#FFFFFFFF"|"SPLIT-Y:#FFFFFF:#FFFFFF"|"SPLIT-Y:#FFFFFFFF:#FFFFFFFF"|"GRADIENT-X:#FFFFFF:#FFFFFF"|"GRADIENT-X:#FFFFFFFF:#FFFFFFFF"|"GRADIENT-Y:#FFFFFF:#FFFFFF"|"GRADIENT-Y:#FFFFFFFF:#FFFFFFFF"|"GRADIENT-DIAG:#FFFFFF:#FFFFFF"|"GRADIENT-DIAG:#FFFFFFFF:#FFFFFFFF")
                tmp="$(mktemp "$STATE_DIR/navbar.json.XXXXXX")"
                jq --arg slot "$slot" \
                    '.[$slot].color = "solid:#111318"' \
                    "$SETTINGS_FILE" > "$tmp"
                mv -f "$tmp" "$SETTINGS_FILE"
                changed=1
                ;;
            *)
                ;;
        esac
    done < <(workspace_ids)

    if (( changed == 1 )); then
        echo "A16EEN navbar: repaired white-on-white icon styles." >&2
    fi
}



color_brightness() {
    local color="$1" hex red green blue
    [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]] || return 1
    hex="$(printf '%s' "$color" | cut -c2-7)"
    red="$(printf '%s' "$hex" | cut -c1-2)"
    green="$(printf '%s' "$hex" | cut -c3-4)"
    blue="$(printf '%s' "$hex" | cut -c5-6)"
    red=$((16#$red))
    green=$((16#$green))
    blue=$((16#$blue))
    printf '%s' "$(((red * 299 + green * 587 + blue * 114) / 1000))"
}

auto_contrast_icon_color() {
    local brightness
    brightness="$(color_brightness "$1")" || brightness=120
    if (( brightness >= 145 )); then
        printf '#111318'
    else
        printf '#FFFFFF'
    fi
}

ensure_style_contrast() {
    local style="$1" background="$2" background_luma color color_luma difference
    local has_color=0 safe=1
    background_luma="$(color_brightness "$background")" || {
        printf '%s' "$style"
        return
    }

    while IFS= read -r color; do
        [[ -n "$color" ]] || continue
        has_color=1
        color_luma="$(color_brightness "$color")" || {
            safe=0
            break
        }
        difference=$((background_luma - color_luma))
        if (( difference < 0 )); then
            difference=$((-difference))
        fi
        if (( difference < 95 )); then
            safe=0
            break
        fi
    done < <(printf '%s' "$style" | grep -Eo '#[0-9A-Fa-f]{6}' || true)

    if (( has_color == 0 || safe == 0 )); then
        printf 'solid:%s' "$(auto_contrast_icon_color "$background")"
    else
        printf '%s' "$style"
    fi
}

apply_appearance_style() {
    local slot="$1" original_style="$2"
    local surface="#FFFFFF" all_container_on=false all_container="#15171A"
    local all_icon_on=false all_icon="auto"
    local individual_container_on=false individual_container="transparent"
    local individual_icon="inherit" background container

    container="$slot"
    if is_known_slot "$slot"; then
        container="workspaces"
    else
        case "$slot" in
            quick-actions-notes|quick-actions-tasks|quick-actions-presets)
                container="quick-actions"
                ;;
            quick-hub-notifications|quick-hub-tools)
                container="quick-hub"
                ;;
        esac
    fi

    if [[ -s "$APPEARANCE_FILE" ]]; then
        IFS=$'\t' read -r surface all_container_on all_container all_icon_on all_icon \
            individual_container_on individual_container individual_icon < <(
            jq -r --arg container "$container" '[
                (.all.surfaceColor // "#FFFFFF"),
                (.all.applyContainerColor // false),
                (.all.containerColor // "#15171A"),
                (.all.applyIconColor // false),
                (.all.iconColor // "auto"),
                (.containers[$container].containerEnabled // false),
                (.containers[$container].containerColor // "transparent"),
                (.containers[$container].iconColor // "inherit")
            ] | @tsv' "$APPEARANCE_FILE"
        )
    fi

    [[ "$surface" =~ ^#[0-9A-Fa-f]{6}$ ]] || surface="#FFFFFF"
    background="$surface"
    if [[ "$all_container_on" == "true" && "$all_container" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        background="$all_container"
    elif [[ "$individual_container_on" == "true" && "$individual_container" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        background="$individual_container"
    fi

    if [[ "$all_icon_on" == "true" ]]; then
        if [[ "$all_icon" == "auto" ]]; then
            original_style="solid:$(auto_contrast_icon_color "$background")"
        elif [[ "$all_icon" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
            original_style="solid:$all_icon"
        fi
    elif [[ "$individual_icon" != "inherit" && -n "$individual_icon" ]]; then
        if [[ "$individual_icon" == "auto" ]]; then
            original_style="solid:$(auto_contrast_icon_color "$background")"
        elif [[ "$individual_icon" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
            original_style="solid:$individual_icon"
        fi
    fi

    ensure_style_contrast "$original_style" "$background"
}

normalize_icon() {
    local value="${1:-}"
    if [[ "$value" =~ ^[a-z0-9-]+\.svg$ ]]; then
        printf '%s' "$value"
    fi
}

ensure_settings() {
    mkdir -p "$STATE_DIR"

    if [[ ! -s "$SETTINGS_FILE" ]]; then
        local tmp="$STATE_DIR/navbar.json.XXXXXX"
        jq 'map({key:.id,value:{icon:.icon,color:"#111318"}}) | from_entries' "$REGISTRY_FILE" > "$tmp"
        mv -f "$tmp" "$SETTINGS_FILE"
    else
        local merge_tmp
        merge_tmp="$(mktemp "$STATE_DIR/navbar.json.XXXXXX")"
        jq --slurpfile registry "$REGISTRY_FILE" 'reduce $registry[0][] as $ws (. ; if has($ws.id) then . else . + {($ws.id): {icon:$ws.icon,color:"#111318"}} end)' "$SETTINGS_FILE" > "$merge_tmp"
        mv -f "$merge_tmp" "$SETTINGS_FILE"
    fi
}

migrate_ai_default_icon() {
    local marker="$STATE_DIR/ai-navbar-sigil-v1"
    [[ -e "$marker" ]] && return 0

    local configured_icon registry_icon tmp
    configured_icon="$(jq -r '.ai.icon // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
    registry_icon="$(jq -r '[.[]? | select(.id == "ai") | .icon][0] // empty' "$REGISTRY_FILE" 2>/dev/null || true)"

    # Upgrade only previous stock icons. Never overwrite a custom user choice.
    if [[ "$configured_icon" == "sparkles.svg" || "$configured_icon" == "wand-sparkles.svg" \
        || ( -z "$configured_icon" && ( "$registry_icon" == "sparkles.svg" || "$registry_icon" == "wand-sparkles.svg" ) ) ]]; then
        tmp="$(mktemp "$STATE_DIR/navbar.json.XXXXXX")"
        if jq '.ai.icon = "a16een-ai-sigil.svg"' "$SETTINGS_FILE" > "$tmp"; then
            mv -f "$tmp" "$SETTINGS_FILE"
        else
            rm -f "$tmp"
            return 1
        fi
    fi

    : > "$marker"
}

repair_uniform_home_icons() {
    [[ -e "$ICON_REPAIR_MARKER" ]] && return 0

    if ! jq -e 'length >= 2 and all(.[]; (.icon // "") == "house.svg")' "$SETTINGS_FILE" >/dev/null 2>&1 ||
       ! jq -e 'any(.[]; (.icon // "") != "house.svg")' "$REGISTRY_FILE" >/dev/null 2>&1; then
        return 0
    fi

    local tmp
    tmp="$(mktemp "$STATE_DIR/navbar.json.XXXXXX")"

    if jq --slurpfile registry "$REGISTRY_FILE"         'reduce $registry[0][] as $ws (. ; .[$ws.id].icon = $ws.icon)'         "$SETTINGS_FILE" > "$tmp"; then
        mv -f "$tmp" "$SETTINGS_FILE"
        : > "$ICON_REPAIR_MARKER"
        echo "A16EEN navbar: restored default workspace icons after the previous migration." >&2
    else
        rm -f "$tmp"
    fi
}

generate_icon() {
    local slot="$1"
    local configured_icon configured_style icon_file output
    configured_icon="$(jq -r --arg slot "$slot" '.[$slot].icon // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
    configured_style="$(jq -r --arg slot "$slot" '.[$slot].color // empty' "$SETTINGS_FILE" 2>/dev/null || true)"

    configured_icon="$(normalize_icon "$configured_icon")"
    configured_style="$(normalize_style "$configured_style")"

    if [[ -z "$configured_icon" ]]; then
        configured_icon="$(jq -r --arg id "$slot" '.[] | select(.id == $id) | .icon' "$REGISTRY_FILE")"
    fi
    if [[ -z "$configured_icon" || "$configured_icon" == "null" ]]; then
        case "$slot" in
            utilities) configured_icon="lucide-sliders-horizontal-dark.svg" ;;
            power) configured_icon="quick-power.svg" ;;
            quick-actions-notes) configured_icon="quick-notes.svg" ;;
            quick-actions-tasks) configured_icon="quick-tasks.svg" ;;
            quick-actions-presets) configured_icon="quick-presets.svg" ;;
            quick-hub-notifications) configured_icon="lucide-bell.svg" ;;
            quick-hub-tools) configured_icon="lucide-toolbox.svg" ;;
            ai) configured_icon="a16een-ai-sigil.svg" ;;
            *) configured_icon="house.svg" ;;
        esac
    fi

    [[ -n "$configured_style" ]] || configured_style="solid:#111318"
    configured_style="$(apply_appearance_style "$slot" "$configured_style")"

    icon_file="$ICON_ROOT/$configured_icon"

    if [[ ! -f "$icon_file" ]]; then
        echo "A16EEN navbar: missing Lucide icon for $slot: $configured_icon" >&2
        return 1
    fi

    output="$OUTPUT_DIR/$slot.svg"
    local mode first second stroke gradient tmp

    case "$configured_style" in
        solid:*)
            mode="solid"
            first="${configured_style#solid:}"
            second="$first"
            ;;
        split-x:*)
            mode="split-x"
            first="${configured_style#split-x:}"
            first="${first%%:*}"
            second="${configured_style#split-x:$first:}"
            ;;
        split-y:*)
            mode="split-y"
            first="${configured_style#split-y:}"
            first="${first%%:*}"
            second="${configured_style#split-y:$first:}"
            ;;
        gradient-x:*)
            mode="gradient-x"
            first="${configured_style#gradient-x:}"
            first="${first%%:*}"
            second="${configured_style#gradient-x:$first:}"
            ;;
        gradient-y:*)
            mode="gradient-y"
            first="${configured_style#gradient-y:}"
            first="${first%%:*}"
            second="${configured_style#gradient-y:$first:}"
            ;;
        gradient-diag:*)
            mode="gradient-diag"
            first="${configured_style#gradient-diag:}"
            first="${first%%:*}"
            second="${configured_style#gradient-diag:$first:}"
            ;;
        *)
            mode="solid"
            first="${DEFAULT_COLOR[$slot]}"
            second="$first"
            ;;
    esac

    if [[ "$mode" == "solid" ]]; then
        stroke="$first"
        sed -E -e 's/stroke="[^"]*"/stroke="'$stroke'"/g' -e 's/stroke:\s*[^;"]+/stroke:'$stroke'/g' "$icon_file" > "$output"
    else
        case "$mode" in
            split-x)       gradient='<linearGradient id="a16eenGradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="'$first'"/><stop offset="50%" stop-color="'$first'"/><stop offset="50%" stop-color="'$second'"/><stop offset="100%" stop-color="'$second'"/></linearGradient>' ;;
            split-y)       gradient='<linearGradient id="a16eenGradient" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="'$first'"/><stop offset="50%" stop-color="'$first'"/><stop offset="50%" stop-color="'$second'"/><stop offset="100%" stop-color="'$second'"/></linearGradient>' ;;
            gradient-x)    gradient='<linearGradient id="a16eenGradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="'$first'"/><stop offset="100%" stop-color="'$second'"/></linearGradient>' ;;
            gradient-y)    gradient='<linearGradient id="a16eenGradient" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="'$first'"/><stop offset="100%" stop-color="'$second'"/></linearGradient>' ;;
            gradient-diag) gradient='<linearGradient id="a16eenGradient" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="'$first'"/><stop offset="100%" stop-color="'$second'"/></linearGradient>' ;;
        esac

        tmp="$(mktemp "$STATE_DIR/navbar-icon.XXXXXX")"
        sed -E 's/stroke="[^"]*"/stroke="url(#a16eenGradient)"/g; s/stroke:\s*[^;"]+/stroke:url(#a16eenGradient)/g' "$icon_file" > "$tmp"
        awk -v gradient="$gradient" '
            BEGIN { inserted=0 }
            !inserted {
                match($0, /<svg[^>]*>/)
                if (RSTART > 0) {
                    end=RSTART+RLENGTH
                    print substr($0, 1, end-1) "<defs>" gradient "</defs>" substr($0, end)
                    inserted=1
                    next
                }
            }
            { print }
        ' "$tmp" > "$output"
        rm -f "$tmp"
    fi

    grep -q '<svg' "$output"
    chmod 644 "$output"
}



set_setting() {
    [[ $# -eq 3 ]] || {
        echo "Usage: a16een-navbar set <slot> <icon.svg> <color>" >&2
        return 2
    }

    local slot="$1"
    local icon="$2"
    local color="$3"

    if ! is_known_slot "$slot"; then
        echo "A16EEN navbar: invalid workspace slot: $slot" >&2
        return 2
    fi

    if ! is_active_slot "$slot"; then
        echo "A16EEN navbar: workspace slot is not active: $slot" >&2
        return 2
    fi

    icon="$(normalize_icon "$icon")"
    color="$(normalize_style "$color")"

    [[ -n "$icon" ]] || {
        echo "A16EEN navbar: invalid icon name." >&2
        return 2
    }

    [[ -n "$color" ]] || {
        echo "A16EEN navbar: invalid color/design." >&2
        return 2
    }

    [[ -f "$ICON_ROOT/$icon" ]] || {
        echo "A16EEN navbar: icon is not installed: $icon" >&2
        return 1
    }

    ensure_registry
    ensure_settings

    local tmp
    tmp="$(mktemp "$STATE_DIR/navbar.json.XXXXXX")"
    if ! jq --arg slot "$slot" --arg icon "$icon" --arg color "$color" \
        '.[$slot] = {"icon": $icon, "color": $color}' \
        "$SETTINGS_FILE" > "$tmp"; then
        rm -f "$tmp"
        echo "A16EEN navbar: could not update settings." >&2
        return 1
    fi

    mv -f "$tmp" "$SETTINGS_FILE"
    main
}

ensure_appearance_marker() {
    # Keep the settings signal available from shell startup even before any
    # appearance toggle has been used.
    [[ -e "$OUTPUT_DIR/appearance-ready" ]] || printf '0\n' > "$OUTPUT_DIR/appearance-ready"
}

signal_ready() {
    # Only icon-content changes update ready; QML uses that marker to reload SVGs.
    ensure_appearance_marker
    printf '%s\n' "$(date +%s%N)" > "$OUTPUT_DIR/ready"
}

generate_workspace_icons() {
    local slot
    while IFS= read -r slot; do
        [[ -n "$slot" ]] || continue
        generate_icon "$slot"
    done < <(workspace_ids)
}

generate_auxiliary_icons() {
    generate_icon "utilities"
    generate_icon "power"
    # Keep each tray button separately themed, using its parent group's colors.
    generate_icon "quick-actions-notes"
    generate_icon "quick-actions-tasks"
    generate_icon "quick-actions-presets"
    generate_icon "quick-hub-notifications"
    generate_icon "quick-hub-tools"
    generate_icon "ai"
}

main() {
    ensure_registry
    ensure_settings
    migrate_ai_default_icon
    repair_uniform_home_icons
    repair_all_white_styles
    mkdir -p "$OUTPUT_DIR"
    ensure_appearance_marker
    prune_inactive_slots
    generate_workspace_icons
    generate_auxiliary_icons
    signal_ready
    echo "A16EEN navbar icons generated for $(active_count) active workspaces."
}

apply_appearance_target() {
    local target="${1:-all}"
    ensure_registry
    ensure_settings
    migrate_ai_default_icon
    repair_all_white_styles
    mkdir -p "$OUTPUT_DIR"
    ensure_appearance_marker

    case "$target" in
        all)
            generate_workspace_icons
            generate_auxiliary_icons
            ;;
        workspaces)
            generate_workspace_icons
            ;;
        utilities|power)
            generate_icon "$target"
            ;;
        quick-actions)
            generate_icon "quick-actions-notes"
            generate_icon "quick-actions-tasks"
            generate_icon "quick-actions-presets"
            ;;
        quick-hub)
            generate_icon "quick-hub-notifications"
            generate_icon "quick-hub-tools"
            ;;
        ai)
            generate_icon "ai"
            ;;
        *)
            echo "A16EEN navbar: unknown appearance target: $target" >&2
            return 2
            ;;
    esac

    signal_ready
}

case "${1:-apply}" in
    apply) main ;;
    apply-appearance) shift; apply_appearance_target "${1:-all}" ;;
    set) shift; set_setting "$@" ;;
    *) echo "Usage: a16een-navbar {apply|apply-appearance <all|workspaces|utilities|power|quick-actions|quick-hub|ai>|set <slot> <icon.svg> <color>}" >&2; exit 2 ;;
esac
