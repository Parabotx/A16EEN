#!/usr/bin/env python3
"""Read and atomically save A16EEN widget preferences outside the deployed config."""
import json
import os
import re
import sys
from pathlib import Path

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
STATE_DIR = STATE_HOME / "a16een"
SETTINGS_FILE = STATE_DIR / "widget-settings.json"
SHAPES = {"capsule", "rounded", "compact", "circle"}
BOOLEAN_KEYS = {
    "editorialTimeWidgetEnabled",
    "musicWidgetEnabled",
    "quotesWidgetEnabled",
    "appShelfWidgetEnabled",
    "appShelfRotationEnabled",
    "timeUse24Hour",
    "timeShowSeconds",
}
DEFAULTS = {
    "editorialTimeWidgetEnabled": True,
    "musicWidgetEnabled": False,
    "quotesWidgetEnabled": False,
    "appShelfWidgetEnabled": False,
    "appShelfShape": "capsule",
    "appShelfRotationEnabled": True,
    "appShelfApps": [],
    "timeUse24Hour": True,
    "timeShowSeconds": False,
    "musicWidgetBackgroundColor": "#EAF2F8",
    "musicWidgetBackgroundOpacity": 72,
}


def clean_app_entries(value):
    if not isinstance(value, list):
        return None

    result = []
    seen = set()
    for item in value[:16]:
        if not isinstance(item, dict):
            continue
        desktop_id = item.get("desktopId")
        if (
            not isinstance(desktop_id, str)
            or not desktop_id
            or len(desktop_id) > 255
            or not re.fullmatch(r"[A-Za-z0-9_.-]+", desktop_id)
            or desktop_id in seen
        ):
            continue

        name = item.get("name", "")
        icon = item.get("icon", "")
        if not isinstance(name, str):
            name = ""
        if not isinstance(icon, str):
            icon = ""
        result.append({
            "desktopId": desktop_id,
            "name": name[:120],
            "icon": icon[:255],
        })
        seen.add(desktop_id)
    return result


def normalize_value(key, value):
    if key in BOOLEAN_KEYS:
        return value if isinstance(value, bool) else None
    if key == "musicWidgetBackgroundColor":
        return value.upper() if isinstance(value, str) and re.fullmatch(r"#[0-9A-Fa-f]{6}", value) else None
    if key == "musicWidgetBackgroundOpacity":
        return value if type(value) is int and 0 <= value <= 100 else None
    if key == "appShelfShape":
        return value if isinstance(value, str) and value in SHAPES else None
    if key == "appShelfApps":
        return clean_app_entries(value)
    return None


def load_settings():
    saved = {}
    try:
        content = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        if isinstance(content, dict):
            saved = content
    except (OSError, UnicodeError, json.JSONDecodeError):
        pass

    result = dict(DEFAULTS)
    result["appShelfApps"] = []
    for key in DEFAULTS:
        value = normalize_value(key, saved.get(key))
        if value is not None:
            result[key] = value
    return result


def save_settings(raw):
    incoming = json.loads(raw)
    if not isinstance(incoming, dict):
        raise ValueError("Widget settings must be a JSON object.")

    merged = load_settings()
    for key in DEFAULTS:
        if key not in incoming:
            continue
        value = normalize_value(key, incoming[key])
        if value is not None:
            merged[key] = value

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = SETTINGS_FILE.with_name(f".{SETTINGS_FILE.name}.{os.getpid()}.tmp")
    try:
        temporary.write_text(json.dumps(merged, indent=2) + "\n", encoding="utf-8")
        os.replace(temporary, SETTINGS_FILE)
    finally:
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass
    return merged


def main():
    args = sys.argv[1:]
    action = args[0] if args else "load"
    if action == "load":
        print(json.dumps(load_settings()))
        return
    if action == "save" and len(args) == 2:
        print(json.dumps(save_settings(args[1])))
        return
    print("Usage: a16een-widget-settings load | save '<json-object>'", file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, TypeError, json.JSONDecodeError) as error:
        print(f"A16EEN widget settings: {error}", file=sys.stderr)
        raise SystemExit(1)
