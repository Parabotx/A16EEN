#!/usr/bin/env python3
"""Read and atomically save A16EEN widget preferences outside the deployed config."""
import json
import os
import sys
from pathlib import Path

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
STATE_DIR = STATE_HOME / "a16een"
SETTINGS_FILE = STATE_DIR / "widget-settings.json"
DEFAULTS = {
    "editorialTimeWidgetEnabled": True,
    "calendarWidgetEnabled": False,
    "pulseWidgetEnabled": False,
    "workspaceWidgetEnabled": False,
    "tasksWidgetEnabled": False,
    "musicWidgetEnabled": False,
    "timeUse24Hour": True,
    "timeShowSeconds": False,
}


def load_settings():
    saved = {}
    try:
        content = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        if isinstance(content, dict):
            saved = content
    except (OSError, UnicodeError, json.JSONDecodeError):
        pass

    result = dict(DEFAULTS)
    for key in DEFAULTS:
        value = saved.get(key)
        if isinstance(value, bool):
            result[key] = value
    return result


def save_settings(raw):
    incoming = json.loads(raw)
    if not isinstance(incoming, dict):
        raise ValueError("Widget settings must be a JSON object.")

    merged = load_settings()
    for key in DEFAULTS:
        value = incoming.get(key)
        if isinstance(value, bool):
            merged[key] = value

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = SETTINGS_FILE.with_name(f".{SETTINGS_FILE.name}.{os.getpid()}.tmp")
    try:
        temporary.write_text(json.dumps(merged, indent=2) + "\n", encoding="utf-8")
        os.replace(temporary, SETTINGS_FILE)
    finally:
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass
    return merged


def main():
    args = sys.argv[1:]
    action = args[0] if args else "load"
    if action == "load":
        print(json.dumps(load_settings()))
        return
    if action == "save" and len(args) == 2:
        print(json.dumps(save_settings(args[1])))
        return
    print("Usage: a16een-widget-settings load | save '<json-object>'", file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, TypeError, json.JSONDecodeError) as error:
        print(f"A16EEN widget settings: {error}", file=sys.stderr)
        raise SystemExit(1)
