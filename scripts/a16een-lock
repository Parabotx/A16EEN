#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
LOG_DIR="$STATE_DIR/logs"
LOCK_LOG="$LOG_DIR/lock.log"
CONFIG_DIR="${A16EEN_CONFIG_DIR:-$HOME/.config/a16een}"
LOCK_THEME_DIR="$CONFIG_DIR/lockscreen"
LOCK_STYLE="$LOCK_THEME_DIR/gtklock.css"
LOCK_LAYOUT="$LOCK_THEME_DIR/gtklock.ui"
LOCK_CONFIG="$LOCK_THEME_DIR/gtklock.ini"
DEFAULT_WALLPAPER="$CONFIG_DIR/quickshell/a16een/assets/wallpapers/default.png"
mkdir -p "$LOG_DIR" 2>/dev/null || true
log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOCK_LOG" 2>/dev/null || true; }

if ! command -v gtklock >/dev/null 2>&1 && ! command -v swaylock >/dev/null 2>&1; then
    log "ERROR: neither gtklock nor swaylock is installed."
    printf '%s\n' "A16EEN: no supported lock screen was found. Run a16een-update to repair dependencies." >&2
    exit 127
fi

RUNTIME_ROOT="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
LOCK_DIR="$(mktemp -d "$RUNTIME_ROOT/a16een-lock.XXXXXX")"
READY_FILE="$LOCK_DIR/ready"
LOCK_IMAGE="$LOCK_DIR/lockscreen.png"
trap 'rm -rf -- "$LOCK_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The lock uses one static frame from the current wallpaper. For video wallpapers,
# ffmpeg extracts a frame before GTKLock starts; this prevents the old solid
# blue-gray fallback from appearing just because the desktop wallpaper is animated.
ACTIVE_WALLPAPER=""
if command -v a16een-wallpaper >/dev/null 2>&1; then
    ACTIVE_WALLPAPER="$(a16een-wallpaper current-path 2>/dev/null || true)"
fi
if [[ ! -r "$ACTIVE_WALLPAPER" ]]; then
    ACTIVE_WALLPAPER="$DEFAULT_WALLPAPER"
fi

prepare_static_image() {
    local source="$1"
    [[ -r "$source" ]] || return 1
    if command -v magick >/dev/null 2>&1; then
        magick "$source" -auto-orient -strip "$LOCK_IMAGE" >/dev/null 2>&1             && [[ -s "$LOCK_IMAGE" ]]
    else
        cp -- "$source" "$LOCK_IMAGE" && [[ -s "$LOCK_IMAGE" ]]
    fi
}

case "${ACTIVE_WALLPAPER,,}" in
    *.gif)
        if command -v magick >/dev/null 2>&1; then
            magick "${ACTIVE_WALLPAPER}[0]" -auto-orient -strip "$LOCK_IMAGE" >/dev/null 2>&1 || true
        elif command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -loglevel error -y -i "$ACTIVE_WALLPAPER" -frames:v 1 -f image2 -update 1 "$LOCK_IMAGE" >/dev/null 2>&1 || true
        fi
        ;;
    *.mp4|*.webm|*.mov|*.m4v|*.mkv)
        if command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -loglevel error -y -ss 0.25 -i "$ACTIVE_WALLPAPER" -frames:v 1 -f image2 -update 1 "$LOCK_IMAGE" >/dev/null 2>&1 || true
        elif command -v magick >/dev/null 2>&1; then
            magick "${ACTIVE_WALLPAPER}[0]" -auto-orient -strip "$LOCK_IMAGE" >/dev/null 2>&1 || true
        fi
        ;;
    *)
        prepare_static_image "$ACTIVE_WALLPAPER" || true
        ;;
esac

if [[ ! -s "$LOCK_IMAGE" && -r "$DEFAULT_WALLPAPER" && "$ACTIVE_WALLPAPER" != "$DEFAULT_WALLPAPER" ]]; then
    log "Could not decode selected wallpaper; preparing A16EEN default wallpaper."
    prepare_static_image "$DEFAULT_WALLPAPER" || true
fi

if [[ -s "$LOCK_IMAGE" ]]; then
    log "Prepared sharp lock background from: $ACTIVE_WALLPAPER"
else
    log "No usable wallpaper frame found; the lock theme will use its neutral charcoal fallback."
fi

# GTKLock provides a real password entry rather than swaylock's circular
# indicator. Use GTKLock's documented --lock-command hook to signal readiness
# only after its session lock has been acquired. GTKLock does not itself send
# the USR2 signal that older versions of this wrapper waited for.
if command -v gtklock >/dev/null 2>&1; then
    # Parse A16EEN's config explicitly before any GTKLock config-group
    # options. This prevents an existing ~/.config/gtklock/config.ini from
    # enabling idle-hide/start-hidden and suppressing the whole visual layout.
    GTKLOCK_ARGS=()
    if [[ -r "$LOCK_CONFIG" ]]; then
        GTKLOCK_ARGS+=(--config "$LOCK_CONFIG")
        log "Using isolated A16EEN GTKLock settings first: $LOCK_CONFIG"
    else
        log "ERROR: A16EEN GTKLock config is missing: $LOCK_CONFIG"
    fi
    GTKLOCK_ARGS+=(
        --time-format '%H:%M'
        --date-format '%A, %d %B %Y'
    )
    if [[ -s "$LOCK_IMAGE" ]]; then
        GTKLOCK_ARGS+=(--background "$LOCK_IMAGE")
    fi
    if [[ -r "$LOCK_STYLE" ]]; then
        GTKLOCK_ARGS+=(--style "$LOCK_STYLE")
    fi
    if [[ -r "$LOCK_LAYOUT" ]]; then
        GTKLOCK_ARGS+=(--layout "$LOCK_LAYOUT")
    fi

    GTKLOCK_HELP="$(gtklock --help 2>&1 || true)"
    if grep -q -- '--lock-command' <<<"$GTKLOCK_HELP"; then
        GTKLOCK_READY_FILE="$LOCK_DIR/gtklock-ready"
        GTKLOCK_ARGS+=(--lock-command "touch $GTKLOCK_READY_FILE")
        log "Starting GTKLock with the A16EEN password-field theme."
        env "XCURSOR_THEME=${XCURSOR_THEME:-Adwaita}" "XCURSOR_SIZE=${XCURSOR_SIZE:-24}" gtklock "${GTKLOCK_ARGS[@]}" >>"$LOCK_LOG" 2>&1 &
        GTKLOCK_PID=$!
        GTKLOCK_READY_SENT=0

        # Wait for GTKLock's post-lock hook. Do not hide the desktop until the
        # session lock protocol is actually active.
        while [[ ! -e "$GTKLOCK_READY_FILE" ]]; do
            GTKLOCK_STATE="$(ps -o stat= -p "$GTKLOCK_PID" 2>/dev/null || true)"
            if [[ -z "$GTKLOCK_STATE" || "$GTKLOCK_STATE" == Z* ]]; then
                break
            fi
            sleep 0.05
        done

        if [[ -e "$GTKLOCK_READY_FILE" ]]; then
            printf '%s\n' "A16EEN_LOCK_READY"
            log "GTKLock confirmed that the session is securely locked."
            GTKLOCK_READY_SENT=1
        fi

        if wait "$GTKLOCK_PID"; then
            if (( GTKLOCK_READY_SENT )); then
                log "GTKLock exited after the session was unlocked."
                exit 0
            fi
            log "GTKLock exited before confirming a secure lock; trying swaylock fallback."
        else
            status=$?
            log "GTKLock failed (status $status); trying secure swaylock fallback."
        fi
    else
        log "GTKLock does not support --lock-command; using secure swaylock fallback."
    fi
fi

# Secure fallback for machines where GTKLock is unavailable or fails. The
# clock and screen-corner status badge require GTKLock; swaylock remains the
# safe fallback on systems where GTKLock is not installed.
if ! command -v gtklock >/dev/null 2>&1; then
    log "GTKLock is not installed; using swaylock fallback (custom clock and corner badge require GTKLock)."
    printf '%s\n' "A16EEN: GTKLock is missing; using the secure swaylock fallback without the custom clock/card/badge." >&2
    printf '%s\\n' "See $LOCK_LOG. Install gtklock to enable the full lock-screen design." >&2
fi

# Keep the
# pointer visible and retain the same wallpaper and restrained gold/charcoal
# colors rather than hiding the cursor or reverting to a flat blue-gray look.
if ! command -v swaylock >/dev/null 2>&1; then
    log "ERROR: GTKLock failed and swaylock is unavailable."
    printf '%s\n' "A16EEN: GTKLock failed and swaylock is unavailable. See $LOCK_LOG" >&2
    exit 1
fi

SWAYLOCK_HELP="$(swaylock --help 2>&1 || true)"
READY_FD_SUPPORTED=0
grep -q -- '--ready-fd' <<<"$SWAYLOCK_HELP" && READY_FD_SUPPORTED=1

run_swaylock() {
    : >"$READY_FILE"
    local pid=0 tries=0 status=0 ready_sent=0

    if (( READY_FD_SUPPORTED )); then
        "$@" --ready-fd 3 3>"$READY_FILE" &
    else
        "$@" &
    fi
    pid=$!

    while (( tries < 200 )); do
        if (( READY_FD_SUPPORTED )) && [[ -s "$READY_FILE" ]]; then
            printf '%s\n' "A16EEN_LOCK_READY"
            log "swaylock signaled ready."
            ready_sent=1
            break
        fi
        if (( ! READY_FD_SUPPORTED && tries >= 5 )) && kill -0 "$pid" 2>/dev/null; then
            printf '%s\n' "A16EEN_LOCK_READY"
            log "swaylock passed legacy startup check."
            ready_sent=1
            break
        fi
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
        tries=$((tries + 1))
    done

    if wait "$pid"; then status=0; else status=$?; fi
    if (( status != 0 )); then
        log "swaylock failed (status $status): $*"
    elif (( ! ready_sent )); then
        log "swaylock exited before its ready marker; treating it as a failed start."
        status=75
    fi
    return "$status"
}

LOCKER_ARGS=()
if [[ -s "$LOCK_IMAGE" ]]; then
    LOCKER_ARGS+=(--image "$LOCK_IMAGE" --scaling fill)
else
    LOCKER_ARGS+=(--color 0B0E13)
fi

BASE_ARGS=(
    "${LOCKER_ARGS[@]}"
    --indicator-radius 54
    --indicator-thickness 4
    --show-failed-attempts
    --font "Inter"
    --font-size 16
    --inside-color 121820D8
    --ring-color D7B56D
    --key-hl-color F5F2EA
    --bs-hl-color EF858B
    --line-color 00000000
    --separator-color 00000000
    --text-color F8FAFC
)

if grep -q -- '--clock' <<<"$SWAYLOCK_HELP" \
    && grep -q -- '--timestr' <<<"$SWAYLOCK_HELP" \
    && grep -q -- '--datestr' <<<"$SWAYLOCK_HELP"; then
    BASE_ARGS+=(--clock --timestr '%H:%M' --datestr '%A, %d %B %Y')
fi

log "Starting secure swaylock fallback with the same wallpaper."
if run_swaylock env "XCURSOR_THEME=${XCURSOR_THEME:-Adwaita}" "XCURSOR_SIZE=${XCURSOR_SIZE:-24}" swaylock "${BASE_ARGS[@]}"; then exit 0; fi

log "ERROR: all lock-screen launch attempts failed."
printf '%s\n' "A16EEN: the lock screen could not start. See $LOCK_LOG" >&2
exit 1
