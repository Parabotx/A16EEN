#!/usr/bin/env bash
set -euo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
readonly REGISTRY_FILE="$STATE_DIR/workspaces.json"
readonly LEGACY_COUNT_FILE="$STATE_DIR/workspace-count"
readonly MIN_COUNT=2
readonly MAX_COUNT=9

readonly DEFAULT_IDS=(
    "home"
    "code"
    "web"
    "comms"
    "studio"
    "music"
    "games"
    "files"
    "lab"
)

readonly DEFAULT_NAMES=(
    "HOME"
    "CODE"
    "WEB"
    "COMMS"
    "STUDIO"
    "MUSIC"
    "GAMES"
    "FILES"
    "LAB"
)

readonly DEFAULT_DESCRIPTIONS=(
    "Main workspace"
    "Development workspace"
    "Browser workspace"
    "Communication workspace"
    "Creative workspace"
    "Music workspace"
    "Gaming workspace"
    "Files & storage"
    "Experiments & tools"
)

readonly DEFAULT_ICONS=(
    "house.svg"
    "code.svg"
    "globe.svg"
    "messages-square.svg"
    "sparkles.svg"
    "music.svg"
    "gamepad-2.svg"
    "folder.svg"
    "terminal.svg"
)

die() {
    printf 'A16EEN workspaces: %s\n' "$*" >&2
    exit 1
}

require_tools() {
    command -v jq >/dev/null 2>&1 || die "jq is required."
    command -v niri >/dev/null 2>&1 || die "niri is required."
}

ensure_state() {
    mkdir -p "$STATE_DIR"
}

write_default_registry() {
    local tmp="$STATE_DIR/workspaces.json.XXXXXX"
    cat > "$tmp" <<'JSON'
[
  {"id":"home","name":"HOME","description":"Main workspace","icon":"house.svg","builtin":true},
  {"id":"code","name":"CODE","description":"Development workspace","icon":"code.svg","builtin":true},
  {"id":"web","name":"WEB","description":"Browser workspace","icon":"globe.svg","builtin":true},
  {"id":"comms","name":"COMMS","description":"Communication workspace","icon":"messages-square.svg","builtin":true},
  {"id":"studio","name":"STUDIO","description":"Creative workspace","icon":"sparkles.svg","builtin":true},
  {"id":"music","name":"MUSIC","description":"Music workspace","icon":"music.svg","builtin":true}
]
JSON
    mv -f "$tmp" "$REGISTRY_FILE"
}

ensure_registry() {
    ensure_state

    if [[ ! -s "$REGISTRY_FILE" ]]; then
        write_default_registry
    fi

    jq empty "$REGISTRY_FILE" >/dev/null 2>&1 ||
        die "workspace registry is invalid: $REGISTRY_FILE"

    local count
    count="$(jq 'length' "$REGISTRY_FILE")"
    (( count >= MIN_COUNT && count <= MAX_COUNT )) ||
        die "workspace registry must contain between $MIN_COUNT and $MAX_COUNT workspaces."

    printf '%s\n' "$count" > "$LEGACY_COUNT_FILE"
}

list_json() {
    ensure_registry
    cat "$REGISTRY_FILE"
}

current_count() {
    ensure_registry
    jq 'length' "$REGISTRY_FILE"
}

slugify() {
    local value="$1"
    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
    value="$(printf '%s' "$value" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    printf '%s' "$value"
}

validate_name() {
    local name="$1"
    [[ -n "$name" ]] || die "workspace name cannot be empty."
    (( ${#name} <= 28 )) || die "workspace name is too long (maximum 28 characters)."
}

validate_icon() {
    local icon="$1"
    [[ "$icon" =~ ^[a-z0-9-]+\.svg$ ]] ||
        die "invalid workspace icon."
}

add_workspace() {
    require_tools
    ensure_registry

    [[ $# -eq 2 ]] || die "usage: a16een-workspaces add <name> <icon.svg>"

    local display_name="$1"
    local icon="$2"
    validate_name "$display_name"
    validate_icon "$icon"

    local count
    count="$(jq 'length' "$REGISTRY_FILE")"
    (( count < MAX_COUNT )) ||
        die "workspace limit reached ($MAX_COUNT)."

    local id
    id="$(slugify "$display_name")"
    [[ -n "$id" ]] || die "workspace name must contain letters or numbers."

    if jq -e --arg id "$id" '.[] | select(.id == $id)' "$REGISTRY_FILE" >/dev/null; then
        die "a workspace named '$display_name' already exists."
    fi

    # Niri always keeps an empty workspace at the bottom. Focus it, then give it
    # a persistent name through IPC. This avoids rewriting/reloading the config.
    niri msg action focus-workspace 999 >/dev/null 2>&1 ||
        die "could not reach Niri's empty workspace."

    niri msg action set-workspace-name "$id" >/dev/null 2>&1 ||
        die "Niri could not create workspace '$display_name'."

    local tmp="$STATE_DIR/workspaces.json.XXXXXX"
    jq --arg id "$id"        --arg name "$display_name"        --arg icon "$icon"        '. + [{"id":$id,"name":$name,"description":"Custom workspace","icon":$icon,"builtin":false}]'        "$REGISTRY_FILE" > "$tmp"
    mv -f "$tmp" "$REGISTRY_FILE"

    printf '%s\n' "$(jq 'length' "$REGISTRY_FILE")" > "$LEGACY_COUNT_FILE"
    printf '%s\n' "$id"
}

remove_workspace() {
    require_tools
    ensure_registry

    [[ $# -eq 1 ]] || die "usage: a16een-workspaces remove <id>"

    local id="$1"
    local count
    count="$(jq 'length' "$REGISTRY_FILE")"
    (( count > MIN_COUNT )) ||
        die "at least $MIN_COUNT workspaces must remain."

    jq -e --arg id "$id" '.[] | select(.id == $id)' "$REGISTRY_FILE" >/dev/null ||
        die "workspace '$id' was not found."

    local target
    target="$(jq -r --arg id "$id" '[.[] | select(.id != $id)][0].id' "$REGISTRY_FILE")"
    [[ -n "$target" && "$target" != "null" ]] || die "no workspace is available for migration."

    # Move any windows out before un-naming the workspace so removal is safe.
    local ws_json windows_json workspace_id window_ids window_id
    ws_json="$(niri msg -j workspaces 2>/dev/null || true)"
    windows_json="$(niri msg -j windows 2>/dev/null || true)"

    workspace_id="$(jq -r --arg name "$id" '.[] | select(.name == $name) | .id' <<<"$ws_json" | head -n 1)"
    if [[ -n "$workspace_id" && "$workspace_id" != "null" && -n "$windows_json" ]]; then
        window_ids="$(jq -r --argjson workspace_id "$workspace_id" '.[] | select(.workspace_id == $workspace_id) | .id' <<<"$windows_json")"
        while IFS= read -r window_id; do
            [[ -n "$window_id" ]] || continue
            niri msg action move-window-to-workspace                 --window-id "$window_id" "$target" >/dev/null 2>&1 ||
                die "could not move a window out of '$id'."
        done <<<"$window_ids"
    fi

    niri msg action focus-workspace "$id" >/dev/null 2>&1 ||
        die "could not focus workspace '$id'."

    niri msg action unset-workspace-name >/dev/null 2>&1 ||
        die "Niri could not remove workspace '$id'."

    local tmp="$STATE_DIR/workspaces.json.XXXXXX"
    jq --arg id "$id" '[.[] | select(.id != $id)]' "$REGISTRY_FILE" > "$tmp"
    mv -f "$tmp" "$REGISTRY_FILE"

    printf '%s\n' "$(jq 'length' "$REGISTRY_FILE")" > "$LEGACY_COUNT_FILE"
    printf '%s\n' "$id"
}

apply_registry() {
    # Compatibility entry point. The registry is already live through Niri IPC.
    ensure_registry
}

case "${1:-current}" in
    current)
        current_count
        ;;
    list)
        list_json
        ;;
    add)
        shift
        add_workspace "$@"
        ;;
    remove)
        shift
        remove_workspace "$@"
        ;;
    apply)
        apply_registry
        ;;
    *)
        die "usage: a16een-workspaces {current|list|add|remove|apply}"
        ;;
esac
