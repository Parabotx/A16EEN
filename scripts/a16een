#!/usr/bin/env bash
set -euo pipefail

SELF_NAME="a16een"
SOURCE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/a16een/source"

usage() {
    cat <<'EOF'
A16EEN command center

Usage:
  a16een <command> [options]

Desktop
  launcher                    Open the A16EEN application launcher
  dashboard                   Open the A16EEN control center
  overview                    Toggle Niri workspace overview
  close                       Close the focused window
  maximize                    Maximize the focused column
  fullscreen                  Toggle fullscreen for the focused window
  float                       Toggle floating for the focused window
  center                      Center the focused column
  workspace <1-9>             Focus a workspace
  restart-shell               Restart only the A16EEN Quickshell shell
  widgets                     Open the A16EEN widget manager
  presets                     Open and manage Workspace Presets

Session
  lock                        Lock the current session
  logout                      Log out of A16EEN/Niri
  reboot                      Reboot the system (confirmation required)
  poweroff                    Power off the system (confirmation required)
  shutdown                    Alias for poweroff
  suspend                     Suspend the system
  sleep                       Alias for suspend
  hibernate                   Hibernate the system

Media / capture
  screenshot                  Open Niri's interactive screenshot UI
  screenshot-screen           Capture the focused screen
  screenshot-window           Capture the focused window

Visuals
  wallpaper list              List available wallpapers
  wallpaper current           Show the active wallpaper
  wallpaper set <filename>    Switch to a wallpaper
  wallpaper next              Switch to the next wallpaper
  wallpaper previous          Switch to the previous wallpaper
  wallpaper reset             Restore the A16EEN default wallpaper

Hardware
  volume up|down|mute         Adjust or mute system volume
  brightness up|down          Adjust screen brightness
  media play|pause|toggle     Control the active media player
  media next|previous         Skip to the next/previous track
  power performance|balanced|eco  Set the A16EEN/system power profile
  power status               Show the active power profile

Maintenance
  icons                       Sync A16EEN's pinned SVG icon set
  icons theme list            List available app/folder icon themes
  icons theme current         Show the active icon theme
  icons theme set <theme>     Install if needed and apply an icon theme
  icons theme cleanup         Remove optional A16EEN-installed icon themes
  update                      Check for and apply A16EEN updates
  rollback                    Restore the latest known-good A16EEN revision
  doctor                      Run A16EEN diagnostics
  status                      Show A16EEN source/installation status

Other
  version                     Show A16EEN CLI version
  help                        Show this help

Options
  --yes, -y                   Skip confirmation for reboot/poweroff
  --help, -h                  Show command help

Examples:
  a16een launcher
  a16een logout
  a16een reboot
  a16een screenshot-window
  a16een wallpaper set studio.png
  a16een doctor
  a16een update
EOF
}

die() {
    printf 'A16EEN: %s\n' "$*" >&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' was not found."
}

ensure_desktop_session() {
    if [[ "${XDG_CURRENT_DESKTOP:-}" != "A16EEN" ]]; then
        printf 'A16EEN: command may still work outside A16EEN, but desktop-only actions require an A16EEN session.\n' >&2
    fi
}

indicator_show() {
    local kind="$1"
    local level="$2"
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/a16een"
    local event_file="$state_dir/control-indicator"
    local tmp_file="$state_dir/.control-indicator.$$"

    [[ -n "$level" ]] || return 0
    mkdir -p "$state_dir"

    # Atomic replace makes every hardware event visible to Quickshell's FileView
    # without depending on a separate IPC connection or display environment.
    printf '%s|%s|%s\n' "$kind" "$level" "$(date +%s%N)" > "$tmp_file" &&
        mv -f "$tmp_file" "$event_file"
}

confirm_destructive() {
    local action="$1"
    local assume_yes="$2"

    if [[ "$assume_yes" -eq 1 ]]; then
        return 0
    fi

    if [[ ! -t 0 ]]; then
        die "$action requires confirmation. Re-run with --yes."
    fi

    printf 'A16EEN: %s the computer? [y/N] ' "$action"
    read -r answer
    case "$answer" in
        y|Y|yes|Yes) ;;
        *) echo "Cancelled."; exit 0 ;;
    esac
}

require_no_args() {
    if [[ $# -ne 0 ]]; then
        die "this command does not accept extra arguments."
    fi
}

validate_workspace() {
    local workspace="$1"
    if [[ ! "$workspace" =~ ^[1-9][0-9]*$ ]]; then
        die "workspace must be a positive integer."
    fi
    if (( workspace > 99 )); then
        die "workspace must be between 1 and 99."
    fi
}

restart_shell() {
    local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/a16een/quickshell/a16een"
    local supervisor_pid=""
    local session_active=0

    if [[ ! -d "$config_dir" ]]; then
        die "A16EEN Quickshell configuration is missing: $config_dir"
    fi

    [[ -n "${NIRI_SOCKET:-}" ]] && session_active=1
    case ":${XDG_CURRENT_DESKTOP:-}:" in
        *:A16EEN:*) session_active=1 ;;
    esac
    # Environment variables can be missing from terminals started indirectly.
    # A running Niri owned by this user is a reliable session recovery signal.
    if pgrep -u "$(id -u)" -x niri >/dev/null 2>&1; then
        session_active=1
    fi

    # Find the A16EEN supervisor by its exact script argument. Do not depend
    # on the Quickshell process command line: Qt may rewrite it to just
    # /usr/bin/quickshell, dropping the original "-c <config>" arguments.
    for cmdline in /proc/[0-9]*/cmdline; do
        [[ -r "$cmdline" ]] || continue

        local pid="${cmdline#/proc/}"
        pid="${pid%/cmdline}"
        [[ "$pid" =~ ^[0-9]+$ ]] || continue

        local args
        args="$(tr '\0' '\n' < "$cmdline" 2>/dev/null || true)"
        if printf '%s\n' "$args" | grep -Eq '(^|/)a16een-shell$'; then
            supervisor_pid="$pid"
            break
        fi
    done

    if [[ -n "$supervisor_pid" ]]; then
        local children child_pid executable command_name
        children="$(cat "/proc/$supervisor_pid/task/$supervisor_pid/children" 2>/dev/null || true)"

        for child_pid in $children; do
            [[ -r "/proc/$child_pid/exe" ]] || continue
            executable="$(readlink "/proc/$child_pid/exe" 2>/dev/null || true)"
            command_name="${executable##*/}"

            case "$command_name" in
                qs|quickshell)
                    if kill -TERM "$child_pid" 2>/dev/null; then
                        echo "A16EEN Quickshell restart requested; the supervisor will relaunch the navbar."
                        return 0
                    fi
                    ;;
            esac
        done

        echo "A16EEN supervisor is running, but its Quickshell child was not found." >&2
        echo "The shell may be between restart attempts; check: tail -n 60 ~/.local/state/a16een/logs/shell.log" >&2
        return 1
    fi

    # If the supervisor itself is missing, recover it from the active session
    # rather than claiming a restart succeeded or requiring a logout.
    if [[ "$session_active" -eq 1 ]]; then
        nohup /usr/local/bin/a16een-shell >/dev/null 2>&1 &
        echo "A16EEN shell supervisor started."
        return 0
    fi

    echo "A16EEN shell supervisor was not found and no active A16EEN session was detected." >&2
    echo "Start/re-enter the A16EEN session to launch it." >&2
    return 1
}

[[ $EUID -ne 0 ]] || die "run this command as your normal desktop user, not root."

command="${1:-help}"
shift || true

assume_yes=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --yes|-y)
            assume_yes=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

case "$command" in
    launcher|app-launcher)
        require_no_args "$@"
        ensure_desktop_session
        require_cmd qs
        exec qs ipc call launcher toggle
        ;;

    widgets)
        require_no_args "$@"
        ensure_desktop_session
        require_cmd qs
        exec qs ipc call widgets open
        ;;

    presets|workspace-presets)
        require_no_args "$@"
        ensure_desktop_session
        require_cmd qs
        exec qs ipc call workspace-presets open
        ;;

    dashboard|control-center|controls)
        require_no_args "$@"
        ensure_desktop_session
        require_cmd qs
        exec qs ipc call dashboard toggle
        ;;

    overview)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action toggle-overview
        ;;

    restart-shell|reload-shell)
        require_no_args "$@"
        ensure_desktop_session
        restart_shell
        ;;

    close)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action close-window
        ;;

    maximize)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action maximize-column
        ;;

    fullscreen)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action fullscreen-window
        ;;

    float|floating)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action toggle-window-floating
        ;;

    center|center-column)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action center-column
        ;;

    workspace)
        [[ $# -eq 1 ]] || die "usage: a16een workspace <1-99>"
        validate_workspace "$1"
        require_cmd niri
        exec niri msg action focus-workspace "$1"
        ;;

    volume)
        [[ $# -eq 1 ]] || die "usage: a16een volume up|down|mute"
        require_cmd wpctl
        case "$1" in
            up)
                wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0
                value=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '/Volume:/ {print $2; exit}')
                indicator_show volume "$value"
                ;;
            down)
                wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
                value=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '/Volume:/ {print $2; exit}')
                indicator_show volume "$value"
                ;;
            mute)
                wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
                ;;
            *) die "usage: a16een volume up|down|mute" ;;
        esac
        ;;

    brightness)
        [[ $# -eq 1 ]] || die "usage: a16een brightness up|down"
        require_cmd brightnessctl
        case "$1" in
            up)
                brightnessctl set +10%
                current=$(brightnessctl get 2>/dev/null || true)
                maximum=$(brightnessctl max 2>/dev/null || true)
                value=$(awk -v c="$current" -v m="$maximum" 'BEGIN {if (m > 0) printf "%.4f", c/m}')
                indicator_show brightness "$value"
                ;;
            down)
                brightnessctl set 10%-
                current=$(brightnessctl get 2>/dev/null || true)
                maximum=$(brightnessctl max 2>/dev/null || true)
                value=$(awk -v c="$current" -v m="$maximum" 'BEGIN {if (m > 0) printf "%.4f", c/m}')
                indicator_show brightness "$value"
                ;;
            *) die "usage: a16een brightness up|down" ;;
        esac
        ;;

    battery-saving|battery-saver|power-save)
        require_no_args "$@"
        require_cmd powerprofilesctl
        exec powerprofilesctl set power-saver
        ;;

    power|power-profile)
        [[ $# -eq 1 ]] || die "usage: a16een power performance|balanced|eco|status"
        require_cmd powerprofilesctl
        case "$1" in
            performance)
                exec powerprofilesctl set performance
                ;;
            balanced)
                exec powerprofilesctl set balanced
                ;;
            eco|saver|power-saver)
                exec powerprofilesctl set power-saver
                ;;
            status)
                exec powerprofilesctl get
                ;;
            *)
                die "usage: a16een power performance|balanced|eco|status"
                ;;
        esac
        ;;
    media)
        [[ $# -eq 1 ]] || die "usage: a16een media play|pause|toggle|next|previous"
        require_cmd playerctl
        case "$1" in
            play) exec playerctl play ;;
            pause) exec playerctl pause ;;
            toggle) exec playerctl play-pause ;;
            next) exec playerctl next ;;
            previous|prev) exec playerctl previous ;;
            *) die "usage: a16een media play|pause|toggle|next|previous" ;;
        esac
        ;;

    lock)
        require_no_args "$@"
        require_cmd a16een-lock
        exec a16een-lock
        ;;

    logout|log-out)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action quit
        ;;

    reboot|restart)
        require_no_args "$@"
        require_cmd systemctl
        confirm_destructive "reboot" "$assume_yes"
        exec systemctl reboot
        ;;

    poweroff|shutdown|power)
        require_no_args "$@"
        require_cmd systemctl
        confirm_destructive "power off" "$assume_yes"
        exec systemctl poweroff
        ;;

    suspend|sleep)
        require_no_args "$@"
        require_cmd systemctl
        exec systemctl suspend
        ;;

    hibernate)
        require_no_args "$@"
        require_cmd systemctl
        exec systemctl hibernate
        ;;

    screenshot)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action screenshot
        ;;

    screenshot-screen|screen-shot)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action screenshot-screen
        ;;

    screenshot-window|window-shot)
        require_no_args "$@"
        require_cmd niri
        exec niri msg action screenshot-window
        ;;

    wallpaper)
        if [[ -x /usr/local/bin/a16een-wallpaper ]]; then
            exec /usr/local/bin/a16een-wallpaper "$@"
        fi
        [[ -x "$SOURCE_DIR/scripts/a16een-wallpaper" ]] || die "A16EEN wallpaper manager is not installed."
        exec "$SOURCE_DIR/scripts/a16een-wallpaper" "$@"
        ;;

    icons)
        if [[ $# -gt 0 && "$1" == "theme" ]]; then
            shift
            if [[ -x /usr/local/bin/a16een-icon-theme ]]; then
                exec /usr/local/bin/a16een-icon-theme "$@"
            fi
            [[ -x "$SOURCE_DIR/scripts/a16een-icon-theme" ]] || die "A16EEN icon theme manager is not installed."
            exec "$SOURCE_DIR/scripts/a16een-icon-theme" "$@"
        fi

        require_no_args "$@"
        if [[ -x /usr/local/bin/a16een-icons ]]; then
            exec /usr/local/bin/a16een-icons
        fi
        [[ -x "$SOURCE_DIR/scripts/a16een-icons" ]] || die "A16EEN icon sync is not installed."
        exec "$SOURCE_DIR/scripts/a16een-icons"
        ;;

    icon-theme|icon-themes)
        if [[ -x /usr/local/bin/a16een-icon-theme ]]; then
            exec /usr/local/bin/a16een-icon-theme "$@"
        fi
        [[ -x "$SOURCE_DIR/scripts/a16een-icon-theme" ]] || die "A16EEN icon theme manager is not installed."
        exec "$SOURCE_DIR/scripts/a16een-icon-theme" "$@"
        ;;

    update)
        require_no_args "$@"
        [[ -x "$SOURCE_DIR/scripts/a16een-update" ]] || die "A16EEN source checkout is missing. Run the installer first."
        exec "$SOURCE_DIR/scripts/a16een-update"
        ;;

    rollback)
        [[ $# -le 0 ]] || die "rollback takes no arguments other than --yes."
        [[ -x "$SOURCE_DIR/scripts/a16een-update" ]] || die "A16EEN source checkout is missing. Run the installer first."
        if [[ "$assume_yes" -eq 1 ]]; then
            exec "$SOURCE_DIR/scripts/a16een-update" --rollback --yes
        else
            exec "$SOURCE_DIR/scripts/a16een-update" --rollback
        fi
        ;;

    doctor|diagnose)
        require_no_args "$@"
        if [[ -x /usr/local/bin/a16een-doctor ]]; then
            exec /usr/local/bin/a16een-doctor
        fi
        [[ -x "$SOURCE_DIR/scripts/a16een-doctor" ]] || die "A16EEN doctor is not installed."
        exec "$SOURCE_DIR/scripts/a16een-doctor"
        ;;

    status)
        require_no_args "$@"
        if [[ -x "$SOURCE_DIR/scripts/a16een-update" ]]; then
            exec "$SOURCE_DIR/scripts/a16een-update" --status
        fi
        die "A16EEN update tools are not installed."
        ;;

    version)
        require_no_args "$@"
        echo "A16EEN CLI 0.1"
        if command -v niri >/dev/null 2>&1; then
            printf 'Niri: %s\n' "$(niri --version 2>/dev/null || echo unknown)"
        fi
        if command -v qs >/dev/null 2>&1; then
            printf 'Quickshell: available\n'
        fi
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        die "unknown command '$command'. Use 'a16een help'."
        ;;
esac
