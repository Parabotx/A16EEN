// A16EEN — active desktop foundation
// Compositor behavior stays here. Visual UI lives in Quickshell.

// Stable A16EEN workspaces. The UI represents these without numeric labels.
// A16EEN WORKSPACES BEGIN
workspace "home"
workspace "code"
workspace "web"
workspace "comms"
workspace "studio"
workspace "music"
// A16EEN WORKSPACES END

input {
    keyboard {
        xkb {}
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {}
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    default-column-width {
        proportion 0.5
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 3
        active-gradient from="#D7B56D" to="#F3E6C2" angle=45
        inactive-color "#383C45"
    }

    border {
        off
    }

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=5
        color "#00000066"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/A16EEN %Y-%m-%d %H-%M-%S.png"

// A16EEN shell supervisor.
// It keeps the desktop shell replaceable and restarts it after recoverable crashes.
spawn-sh-at-startup "a16een-shell"

environment {
    // A16EEN identifies itself without hijacking ~/.config for applications.
    XDG_CURRENT_DESKTOP "A16EEN"
    XDG_SESSION_DESKTOP "a16een"
    DESKTOP_SESSION "a16een"
}

// Niri now integrates xwayland-satellite automatically. It starts it on demand
// for X11 applications and restarts it if it dies.
xwayland-satellite {
    path "xwayland-satellite"
}

binds {
    // A16EEN UI
    // Super+S opens the A16EEN screenshot center.
    Super+S allow-inhibiting=false repeat=false hotkey-overlay-title="A16EEN Screenshot Center" { spawn-sh "qs -c \"$HOME/.config/a16een/quickshell/a16een\" ipc call screenshot toggle"; }

    // Super+Space opens the A16EEN application launcher.
    // Super+/ opens the A16EEN command center.
    Super+Space repeat=false hotkey-overlay-title="A16EEN Application Launcher" { spawn "qs" "ipc" "call" "launcher" "open"; }
    Super+Slash repeat=false hotkey-overlay-title="A16EEN Command Center" { spawn-sh "qs -c \"$HOME/.config/a16een/quickshell/a16een\" ipc call command-center toggle"; }
    Mod+P repeat=false { spawn-sh "qs ipc call dashboard toggle"; }
    Mod+O repeat=false { toggle-overview; }

    // Applications
    Mod+Return { spawn "foot"; }

    // Window navigation
    Mod+X repeat=false { close-window; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }

    // Layout
    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+T repeat=false { spawn-sh "qs -c \"$HOME/.config/a16een/quickshell/a16een\" ipc call fullscreen exit"; }
    Mod+V { toggle-window-floating; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+C { center-column; }

    // Workspaces
    // A16EEN WORKSPACE BINDS BEGIN
    Mod+1 { focus-workspace "home"; }
    Mod+2 { focus-workspace "code"; }
    Mod+3 { focus-workspace "web"; }
    Mod+4 { focus-workspace "comms"; }
    Mod+5 { focus-workspace "studio"; }
    Mod+6 { focus-workspace "music"; }

    Mod+Shift+1 { move-column-to-workspace "home"; }
    Mod+Shift+2 { move-column-to-workspace "code"; }
    Mod+Shift+3 { move-column-to-workspace "web"; }
    Mod+Shift+4 { move-column-to-workspace "comms"; }
    Mod+Shift+5 { move-column-to-workspace "studio"; }
    Mod+Shift+6 { move-column-to-workspace "music"; }
    // A16EEN WORKSPACE BINDS END

    // Media / volume
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "a16een" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "a16een" "volume" "down"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }

    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "a16een" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "a16een" "brightness" "down"; }

    Super+Alt+L repeat=false { spawn "swaylock" "-f" "-c" "08090C"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Session
    Mod+Shift+E { quit; }
}
